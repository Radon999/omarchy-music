<?xml version="1.0" encoding="utf-8"?>
<!-- The desktop's phone remote speaks plain HTTP on your own network; everything else is HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
