def load_theme():
    colors = dict(DEFAULT_COLORS)
    try:
        with open(THEME_DIR / "colors.toml", "rb") as f:
            colors.update({k: v for k, v in tomllib.load(f).items() if isinstance(v, str)})
    except (OSError, tomllib.TOMLDecodeError):
        pass
    if WINDOWS:
        return {"c": colors, "font": "Consolas", "radius": 4}
    try:
        font = subprocess.run(["fc-match", "monospace", "-f", "%{family}"], capture_output=True,
                              text=True, timeout=2).stdout.split(",")[0] or "monospace"
    except (OSError, subprocess.SubprocessError):
        font = "monospace"
    radius = 0
    try:
        out = subprocess.run(["hyprctl", "-j", "getoption", "decoration:rounding"],
                             capture_output=True, text=True, timeout=2).stdout
        radius = max(0, min(int(json.loads(out).get("int", 0)), 14))
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return {"c": colors, "font": font, "radius": radius}


