def track_from_spotify(t, album=None):
    """Normalise a Spotify track (full, or an album's simplified one with its album given) into our track dict."""
    if not t or t.get("type", "track") != "track" or not t.get("id"):
        return None
    album = t.get("album") or album or {}
    imgs = album.get("images") or []
    thumb = min(imgs, key=lambda i: abs((i.get("width") or 300) - 300))["url"] if imgs else ""
    return {"id": f"sp{t['id']}", "source": "spotify", "spotify": t["id"],
            "isrc": (t.get("external_ids") or {}).get("isrc"),
            "title": t.get("name") or "Unknown",
            "artist": ", ".join(a["name"] for a in t.get("artists") or [] if a.get("name")) or "Unknown artist",
            "album": album.get("name") or "", "duration": round((t.get("duration_ms") or 0) / 1000), "thumb": thumb}


class Spotify:
    """Your Spotify library: liked songs, playlists, search and artists' albums."""
    key, name = "spotify", "Spotify"
    hint = "Connect Spotify in the accounts menu (top right).\nIt needs a Spotify developer app of yours."

    def __init__(self):
        self.lock = threading.Lock()
        self.auth = read_json(SPOTIFY_AUTH, {})
        self.cancelled = False

    @property
    def client_id(self):
        return self.auth.get("client_id", "")

    @property
    def user(self):
        return self.auth.get("user", "")

    @property
    def signed_in(self):
        return bool(self.auth.get("refresh_token"))

    def _save(self):
        write_private(SPOTIFY_AUTH, json.dumps(self.auth))

    def disconnect(self):
        self.auth = {"client_id": self.client_id}
        self._save()

    @staticmethod
    def _token(form):
        return http_json("https://accounts.spotify.com/api/token", {"Content-Type": "application/x-www-form-urlencoded"},
                         urllib.parse.urlencode(form).encode(), "POST")

    def _take(self, tok):
        self.auth["access_token"] = tok["access_token"]
        self.auth["expires"] = time.time() + tok.get("expires_in", 3600) - 60
        if tok.get("refresh_token"):   # Spotify may hand out a new one: the old one stops working
            self.auth["refresh_token"] = tok["refresh_token"]

    def login(self, client_id, opened):
        """Connect (blocking): open Spotify's consent page (opened(url) shows it), catch the
        browser coming back to 127.0.0.1, and swap the code for a login. PKCE: no secret."""
        client_id = client_id.strip()
        if not re.fullmatch(r"[0-9a-f]{32}", client_id):
            raise ValueError("that isn't a Spotify Client ID: 32 letters and digits")
        verifier = base64.urlsafe_b64encode(os.urandom(48)).rstrip(b"=").decode()
        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
        state, got = secrets.token_urlsafe(16), {}

        class Back(BaseHTTPRequestHandler):
            def do_GET(h):
                url = urllib.parse.urlparse(h.path)
                if url.path != "/callback":
                    h.send_response(404)
                    h.end_headers()
                    return
                got.update({k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()})
                ok = "code" in got and got.get("state") == state
                h.send_response(200)
                h.send_header("Content-Type", "text/plain; charset=utf-8")
                h.end_headers()
                h.wfile.write(("Spotify is connected to Omarchy Music. You can close this tab." if ok
                               else f"Spotify didn't connect: {got.get('error', 'no code came back')}").encode())

            def log_message(h, *_a):
                pass

        server = HTTPServer(("127.0.0.1", SPOTIFY_PORT), Back)
        server.timeout = 1
        self.cancelled = False
        try:
            opened("https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
                "client_id": client_id, "response_type": "code", "redirect_uri": SPOTIFY_REDIRECT, "state": state,
                "scope": SPOTIFY_SCOPES, "code_challenge_method": "S256", "code_challenge": challenge}))
            end = time.monotonic() + 180
            while not got and not self.cancelled and time.monotonic() < end:
                server.handle_request()
        finally:
            server.server_close()
        if self.cancelled:
            raise RuntimeError("cancelled")
        if not got:
            raise RuntimeError("Spotify's page wasn't approved in time")
        if got.get("state") != state or "code" not in got:
            raise RuntimeError(got.get("error") or "Spotify didn't send a login back")
        tok = self._token({"grant_type": "authorization_code", "code": got["code"], "redirect_uri": SPOTIFY_REDIRECT,
                           "client_id": client_id, "code_verifier": verifier})
        self.auth = {"client_id": client_id}
        self._take(tok)
        me = self.get("/me")
        self.auth["user"] = me.get("display_name") or me.get("id") or ""
        self._save()

    def access(self):
        with self.lock:
            if self.auth.get("access_token") and self.auth.get("expires", 0) > time.time():
                return self.auth["access_token"]
            if not self.signed_in:
                raise RuntimeError("Spotify isn't connected")
            self._take(self._token({"grant_type": "refresh_token", "refresh_token": self.auth["refresh_token"],
                                    "client_id": self.client_id}))
            self._save()
            return self.auth["access_token"]

    def request(self, path, params=None, method=None, body=None):
        url = path if path.startswith("http") else SPOTIFY_API + path
        if params:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else b"" if method in ("PUT", "DELETE", "POST") else None
        for attempt in range(3):
            headers = {"Authorization": f"Bearer {self.access()}"}
            if body is not None:
                headers["Content-Type"] = "application/json"
            try:
                return http_json(url, headers, data, method)
            except urllib.error.HTTPError as e:
                if e.code == 429 and attempt < 2:   # too fast: Spotify says how long to wait
                    time.sleep(min(int(e.headers.get("Retry-After") or 1), 10))
                elif e.code == 401 and attempt == 0:
                    self.auth["expires"] = 0
                else:
                    raise

    def get(self, path, params=None):
        return self.request(path, params)

    def pages(self, path, params=None, cap=10000):
        """Every item of a list Spotify hands out a page at a time."""
        out, url = [], path
        while url and len(out) < cap:
            page = self.get(url, params)
            params = None   # the next link carries them
            out += [i for i in page.get("items") or [] if i]
            url = page.get("next")
        return out

    def search(self, q):
        m = re.search(r"open\.spotify\.com/(?:intl-[\w-]+/)?(track|album|playlist)/(\w+)", q) \
            or re.search(r"spotify:(track|album|playlist):(\w+)", q)
        if not m:
            found = []
            for offset in (0, 10, 20):   # ten a request for apps like this one
                items = (self.get("/search", {"q": q, "type": "track", "limit": 10, "offset": offset})
                         .get("tracks") or {}).get("items") or []
                found += items
                if len(items) < 10:
                    break
            return [t for t in map(track_from_spotify, found) if t]
        kind, ident = m.groups()
        if kind == "track":
            return [t for t in [track_from_spotify(self.get(f"/tracks/{ident}"))] if t]
        if kind == "album":
            return self.album(ident)
        return self.playlist(ident)

    def radio(self, track):
        raise NotImplementedError   # Spotify stopped giving recommendations to apps like this: another service fills in

    def my_playlists(self):
        out = [{"id": "liked", "title": "Liked Songs", "count": "", "thumb": ""}]
        for p in self.pages("/me/playlists", {"limit": 50}):
            imgs = p.get("images") or []
            n = (p.get("items") or p.get("tracks") or {}).get("total", "")
            out.append({"id": p["id"], "title": p.get("name") or "Playlist", "count": n, "thumb": imgs[0]["url"] if imgs else ""})
        return out

    def playlist(self, pid):
        if pid == "liked":
            items = self.pages("/me/tracks", {"limit": 50})
        else:
            try:
                items = self.pages(f"/playlists/{pid}/items", {"limit": 50})
            except urllib.error.HTTPError as e:
                if e.code == 403:
                    raise RuntimeError("Spotify lets apps like this open only playlists you made or collaborate on") from e
                if e.code != 404:
                    raise
                items = self.pages(f"/playlists/{pid}/tracks", {"limit": 50})   # an app from before 2026
        return [t for t in (track_from_spotify(i.get("item") or i.get("track")) for i in items) if t]

    def liked_ids(self):
        return {t["id"] for t in self.playlist("liked")}

    def rate(self, track, like):
        method = "PUT" if like else "DELETE"
        try:
            self.request("/me/library", {"uris": f"spotify:track:{track['spotify']}"}, method=method)
        except urllib.error.HTTPError as e:
            if e.code not in (404, 405):
                raise
            self.request("/me/tracks", {"ids": track["spotify"]}, method=method)   # an app from before 2026

    def library_tracks(self):
        """Every song in your liked songs and playlists, each once."""
        seen, out = set(), []
        for pl in self.my_playlists():
            try:
                tracks = self.playlist(pl["id"])
            except Exception:  # noqa: BLE001 -- skip a playlist that won't load
                continue
            for t in tracks:
                if t["id"] not in seen:
                    seen.add(t["id"])
                    out.append(t)
        return out

    def artist(self, name):
        res = self.get("/search", {"q": name, "type": "artist", "limit": 5})
        a = best_named((res.get("artists") or {}).get("items") or [], name, lambda x: x.get("name") or "")
        if not a:
            return None
        albums = []
        for x in self.pages(f"/artists/{a['id']}/albums", {"include_groups": "album,single", "limit": 10}, cap=60):
            imgs = x.get("images") or []
            albums.append(album_entry(x["id"], x.get("name"), "Single" if x.get("album_type") == "single"
                                      else (x.get("release_date") or "")[:4], imgs[-2]["url"] if len(imgs) > 1 else
                                      imgs[0]["url"] if imgs else ""))
        imgs = a.get("images") or []
        return {"name": a.get("name") or name, "thumb": imgs[-2]["url"] if len(imgs) > 1 else imgs[0]["url"] if imgs else "",
                "top": [], "albums": albums}

    def album(self, aid):
        al = self.get(f"/albums/{aid}")
        items = list((al.get("tracks") or {}).get("items") or [])
        nxt = (al.get("tracks") or {}).get("next")
        if nxt:
            items += self.pages(nxt)
        return [t for t in (track_from_spotify(i, al) for i in items) if t]


