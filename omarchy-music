                    label.set_hexpand(True)
                    row.append(label)
                    lst.append(row)
                s.append(lst)

        hours = d["hours"]
        peak = max(range(24), key=lambda h: hours[h])
        night = sum(hours[h] for h in (22, 23, 0, 1, 2, 3))
        morning = sum(hours[h] for h in range(5, 10))
        kind_of = ("Night owl" if night > 0.25 * d["scrobbles"] else "Early bird" if morning > 0.3 * d["scrobbles"]
                   else "Daytime listener")
