    def volume_button(self):
        """Click for a slider, scroll on it to step, middle-click (or m) to mute."""
        self.vol_scale = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL, inverted=True, draw_value=False)
        self.vol_scale.add_css_class("volume")
        self.vol_scale.set_range(0, 100)
        self.vol_scale.set_increments(5, 10)
        self.vol_scale.set_value(self.app.volume)
        self.vol_scale.connect("value-changed", lambda sc: self.app.set_volume(sc.get_value()))
        self.vol_btn = Gtk.MenuButton(popover=Gtk.Popover(child=self.vol_scale), valign=Gtk.Align.CENTER,
                                      direction=Gtk.ArrowType.UP)
        self.vol_btn.add_css_class("ctl")
        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", lambda _c, _dx, dy: (self.app.set_volume(self.app.volume - 5 * dy), True)[1])
        self.vol_btn.add_controller(scroll)
        middle = Gtk.GestureClick(button=Gdk.BUTTON_MIDDLE)
        middle.connect("pressed", lambda *_: self.app.toggle_mute())
        self.vol_btn.add_controller(middle)
        self.update_volume()
        return self.vol_btn

    def update_volume(self):
        a = self.app
        level = 0 if a.muted else a.volume
        icon = ("muted" if level == 0 else "low" if level < 34 else "medium" if level < 67 else "high")
        self.vol_btn.set_icon_name(f"audio-volume-{icon}-symbolic")
        self.vol_btn.set_tooltip_text(("Muted" if a.muted else f"Volume {a.volume:.0f}%")
                                      + "  (scroll, + / −, m to mute)")
        if abs(self.vol_scale.get_value() - a.volume) > 0.5:
            self.vol_scale.set_value(a.volume)

