    def self_test(self):
        """OMARCHY_MUSIC_SELFTEST=1 (the Windows build checks its package with it): the window
        opened, mpv runs and answers. Prints the verdict and exits 0 or 1."""
        missing = []
        for mod in ("requests", "mutagen", "ytmusicapi", "tidalapi", "yt_dlp"):   # imported when first needed
            try:
                __import__(mod)
            except Exception as e:
                missing.append(f"{mod} ({e})")
        import requests
        certs = Path(requests.certs.where()).is_file()   # what HTTPS checks servers against
        ok = bool(self.win) and self.player.proc.poll() is None and self.player.heard and not missing and certs
        print(f"selftest {'ok' if ok else 'FAILED'}: window={bool(self.win)} mpv_running={self.player.proc.poll() is None} "
              f"mpv_answered={self.player.heard} modules={'ok' if not missing else ', '.join(missing)} certs={certs} "
              f"gtk={Gtk.get_major_version()}.{Gtk.get_minor_version()} "
              f"adw={Adw.get_major_version()}.{Adw.get_minor_version()}", flush=True)
        self.player.quit()
        os._exit(0 if ok else 1)

