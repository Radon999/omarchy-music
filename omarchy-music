        colours = Gtk.Switch(active=a.art_colors, valign=Gtk.Align.CENTER)
        colours.connect("notify::active", lambda sw, _p: a.set_art_colors(sw.get_active()))
        line("Colours", "The window takes the colour of the album art", a.art_colors, colours)
        remote = Gtk.Switch(active=a.remote_on, valign=Gtk.Align.CENTER)
