def icon_button(icon, css, tip, cb):
    b = Gtk.Button(icon_name=icon, tooltip_text=tip)
    b.add_css_class(css)
    b.connect("clicked", lambda *_: cb())
    return b


def art_widget(px):
    # Gtk.Image draws at exactly pixel_size; a Picture grows to the texture.
    pic = Gtk.Image(pixel_size=px)
    frame = Gtk.Box(overflow=Gtk.Overflow.HIDDEN, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    frame.add_css_class("art")
    frame.set_size_request(px, px)
    frame.append(pic)
    return frame, pic


def split_artists(text):
    """The artists in a credit, as written: "A, B feat. C" -> [A, B, C]. "A & B"
    may be a duo's name, so it is offered whole and as each of them."""
    out = []
    for part in re.split(r",\s*|\s+(?:feat\.?|ft\.?|featuring|with)\s+", text or "", flags=re.I):
        part = part.strip()
        if not part or part.lower() == "unknown artist":
            continue
        out.append(part)
        if " & " in part:
            out += [p.strip() for p in part.split(" & ") if p.strip()]
    return list(dict.fromkeys(out))


def artist_link(win, text, css="sub"):
    """A label of artists' names; a click opens the artist's page (a choice of them for a few)."""
    lab = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
    lab.add_css_class(css)
    click = Gtk.GestureClick(button=Gdk.BUTTON_PRIMARY)

    def pressed(gesture, _n, _x, _y):
        if lab.has_css_class("link") and not win.selecting:
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)   # the row underneath doesn't play the song
            win.pick_artist(lab, lab.get_label())
    click.connect("pressed", pressed)
    lab.add_controller(click)
    set_link_text(lab, text)
    return lab


def set_link_text(lab, text):
    lab.set_label(text)
    link = bool(split_artists(text))
    (lab.add_css_class if link else lab.remove_css_class)("link")
    lab.set_cursor_from_name("pointer" if link else None)
    lab.set_tooltip_text("Go to the artist" if link else None)


