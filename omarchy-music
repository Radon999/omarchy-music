    def fill(self, lst, tracks):
        lst.remove_all()
        self.lazy(lst, len(tracks), lambda i: self.add_track(lst, tracks[i], i, tracks))

    def add_track(self, lst, track, i, group, **kw):
        """A song's row at the end of lst: one of group (its songs, in order), the i-th."""
        row = TrackRow(self, track, i, group=group, **kw)
        if track["id"] == (self.app.current_track() or {}).get("id"):
            row.add_css_class("playing")
        lst.append(row)
        if self.selecting and lst is self.select_list:   # rebuilt while you pick: keep what's still there
            picked = self.selected.get(i)
            if picked and picked["id"] != track["id"]:
                del self.selected[i]
                picked = None
            row.show_check(True, bool(picked))
            self.update_selectbar()
        return row

