def find_signed_in_browser(domain="youtube.com", required="__Secure-3PAPISID"):
    """(browser, {name: value} of its cookies for domain) for the first browser
    signed in there (it has the required cookie), else (None, None).

    Chromium encrypts cookies with a key held in the GNOME keyring; without
    the keyring (and the secretstorage module) every value decrypts to garbage
    and the site quietly treats the requests as signed out.
    """
    try:
        from yt_dlp.cookies import extract_cookies_from_browser
    except ImportError:
        return None, None
    keyring = cookie_keyring()
    with COOKIE_LOCK:   # the services connect at once; one keyring unlock at a time
        for b in BROWSERS:
            try:
                jar = extract_cookies_from_browser(b, keyring=keyring if b != "firefox" else None,
                                                   logger=_QuietLogger())
            except Exception:  # noqa: BLE001 -- browser not installed / locked
                continue
            cookies = {c.name: c.value for c in jar if c.domain.endswith(domain)}
            if required in cookies:
                return b, cookies
    return None, None


COOKIE_LOCK = threading.Lock()


def cookie_keyring():
    if WINDOWS:
        return None   # Windows keeps the key itself (DPAPI)
    return "GNOMEKEYRING" if subprocess.run(["pgrep", "-x", "gnome-keyring-d"],
                                            capture_output=True).returncode == 0 else None


class _QuietLogger:
    def debug(self, *_a, **_k): pass
    def info(self, *_a, **_k): pass
    def warning(self, *_a, **_k): pass
    def error(self, *_a, **_k): pass


class YTM:
    key, name = "ytm", "YouTube Music"
    hint = "Sign in at music.youtube.com in Chromium,\nthen pick “Check again” below."

    def __init__(self):
        from ytmusicapi import YTMusic
        from ytmusicapi.helpers import initialize_headers
        self.anon = YTMusic()
        self.browser, cookies = find_signed_in_browser()
        cookie = "; ".join(f"{k}={v}" for k, v in cookies.items()) if cookies else None
        self.account = None
        if cookie:
            # Browser auth sends only these headers, so start from the normal
            # ones; the placeholder authorization marks it as browser auth and
            # ytmusicapi recomputes the real SAPISIDHASH on every request.
            headers = dict(initialize_headers())
            headers.update({"cookie": cookie, "x-goog-authuser": "0", "origin": "https://music.youtube.com",
                            "authorization": "SAPISIDHASH 0_0"})
            try:
                self.account = YTMusic(auth=headers)
                self.account.get_account_info()
            except Exception:  # noqa: BLE001 -- expired login: stay anonymous
                self.account = None

    @property
    def api(self):
        return self.account or self.anon

    @property
    def signed_in(self):
        return self.account is not None

    def search(self, q):
        m = re.search(r"[?&]list=([\w-]+)", q)
        if m:
            return self.playlist(m.group(1))
        m = re.search(r"(?:v=|youtu\.be/)([\w-]{11})", q)
        if m:
            return self.radio(m.group(1))[:1]
        return [t for t in map(track_from_ytm, self.api.search(q, filter="songs", limit=30)) if t]

    def find(self, q):
        """Songs, artists and albums called q, or with q in their names."""
        def last(x):
            thumbs = x.get("thumbnails") or []
            return thumbs[-1]["url"] if thumbs else ""
        artists = [{"name": a.get("artist"), "thumb": last(a)} for a in self.api.search(q, filter="artists", limit=6)
                   if a.get("artist")][:6]
        albums = []
        for x in self.api.search(q, filter="albums", limit=10)[:10]:
            if x.get("browseId"):
                by = ", ".join(a.get("name") or "" for a in x.get("artists") or [] if a.get("name"))
                albums.append(album_entry(x["browseId"], x.get("title"), " · ".join(v for v in (by, str(x.get("year") or "")) if v), last(x)))
        return {"songs": self.search(q), "artists": artists, "albums": albums}

    def mix_for(self, q):
        """The songs of the playlist YouTube Music has for q ("chill", "2010s hits"), or []."""
        for x in self.api.search(q, filter="playlists", limit=5)[:3]:
            pid = (x.get("browseId") or "").removeprefix("VL")
            found = self.playlist(pid) if pid else []
            if len(found) >= 8:
                return found[:80]
        return []

    def radio(self, track):
        """A radio of songs like track (a song from any service, or a video ID)."""
        if isinstance(track, str):
            vid = track
        elif source_of(track) == "ytm":
            vid = track["id"]
        else:
            found = self.search(f"{track['artist'].split(',')[0]} {bare_title(track['title'])}")
            if not found:
                return []
            vid = found[0]["id"]
        tracks = self.api.get_watch_playlist(videoId=vid, limit=40).get("tracks", [])
        return [t for t in map(track_from_ytm, tracks) if t]

    def my_playlists(self):
        out = []
        for p in self.account.get_library_playlists(limit=None):
            if not p.get("playlistId"):
                continue
            thumbs = p.get("thumbnails") or []
            out.append({"id": p["playlistId"], "title": p.get("title") or "Playlist",
                        "count": p.get("count") or "", "thumb": thumbs[-1]["url"] if thumbs else ""})
        return out

    def liked_ids(self):
        tracks = self.account.get_liked_songs(limit=None).get("tracks", [])
        return {t["videoId"] for t in tracks if t.get("videoId")}

    def rate(self, track, like):
        from ytmusicapi.models.content.enums import LikeStatus
        self.account.rate_song(track["id"], LikeStatus.LIKE if like else LikeStatus.INDIFFERENT)

    def playlist(self, pid):
        api = self.account or self.anon
        return [t for t in map(track_from_ytm, api.get_playlist(pid, limit=None).get("tracks", [])) if t]

    def artist(self, name):
        """{name, thumb, top: songs, albums} of the artist called name, or None."""
        a = best_named(self.api.search(name, filter="artists", limit=5), name, lambda x: x.get("artist") or "")
        if not a:
            return None
        info = self.api.get_artist(a["browseId"])
        songs, top = info.get("songs") or {}, []
        if songs.get("browseId"):
            try:   # all their songs, most played first; the page itself has five
                top = [t for t in map(track_from_ytm, self.api.get_playlist(songs["browseId"], limit=25).get("tracks", [])) if t]
            except Exception:  # noqa: BLE001 -- the five, then
                top = []
        top = top or [t for t in map(track_from_ytm, songs.get("results") or []) if t]
        albums = []
        for kind in ("albums", "singles"):
            for x in (info.get(kind) or {}).get("results") or []:
                if x.get("browseId"):
                    thumbs = x.get("thumbnails") or []
                    albums.append(album_entry(x["browseId"], x.get("title"), x.get("year") or ("Single" if kind == "singles" else ""),
                                              thumbs[-1]["url"] if thumbs else ""))
        thumbs = info.get("thumbnails") or []
        return {"name": info.get("name") or name, "thumb": thumbs[-1]["url"] if thumbs else "", "top": top[:20], "albums": albums}

    def album(self, aid):
        al = self.api.get_album(aid)
        thumbs = al.get("thumbnails") or []
        thumb = thumbs[-1]["url"] if thumbs else ""
        out = []
        for item in al.get("tracks") or []:
            t = track_from_ytm(item)
            if t:
                out.append(dict(t, album=al.get("title") or t["album"], thumb=t["thumb"] or thumb))
        return out

    def library_tracks(self):
        """Every song in your liked songs and playlists, each once."""
        ids = [p["id"] for p in self.my_playlists()]
        if "LM" not in ids:
            ids.insert(0, "LM")   # liked music
        seen, out = set(), []
        for pid in ids:
            try:
                tracks = self.playlist(pid)
            except Exception:  # noqa: BLE001 -- skip a playlist that won't load
                continue
            for t in tracks:
                if t["id"] not in seen:
                    seen.add(t["id"])
                    out.append(t)
        return out


