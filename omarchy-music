        s.append(w_label(f"You listened most around {hour_label(peak)}.", "w-sub"))
        s.append(bars(hours, [("12a" if h == 0 else "6a" if h == 6 else "12p" if h == 12 else "6p" if h == 18 else "")
                              for h in range(24)], height=self.px(110), top=peak))
        day = max(range(7), key=lambda i: d["weekdays"][i])
        s.append(w_label(f"And most of all on {WEEKDAYS[day]}.", "w-sub"))
        s.append(bars(d["weekdays"], WEEK_LETTERS, height=self.px(50), top=day))

        s = self.slide(1)
        if kind == "year":
