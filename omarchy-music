        pop.connect("closed", lambda p: GLib.idle_add(lambda: (p.unparent(), False)[1]))
        pop.popup()

    def open_artist(self, name, prefer=None):
        """The artist's page: their songs in your music, their top songs and albums from a service."""
        if self.selecting:
            self.stop_selecting()
        if self.stack.get_visible_child_name() != "artist":
            self.artist_from, self.artist_pages = self.stack.get_visible_child_name(), []
        page = {"kind": "artist", "name": name, "info": None, "error": None, "mine": self.app.songs_by(name)}
        self.artist_pages.append(page)
        self.stack.set_visible_child_name("artist")
        if not self.get_visible():
            present(self)
        self.render_artist()

        def done(res, err):
            page["info"], page["error"] = res, err or (None if res else "not found on any of your services")
            if self.artist_pages and self.artist_pages[-1] is page:
                self.render_artist()
        in_thread(self.app.artist_info, name, prefer, done=done)

    def open_album_page(self, album):
        """An album from the search: its page on its own, Back goes to the search."""
        if self.stack.get_visible_child_name() != "artist":
            self.artist_from, self.artist_pages = self.stack.get_visible_child_name(), []
        self.stack.set_visible_child_name("artist")
        self.open_album(album)

    def open_album(self, album):
        if self.selecting:
            self.stop_selecting()
        artist = self.artist_pages[-1] if self.artist_pages else {}
        source = album.get("source") or (artist.get("info") or {}).get("source")
        page = {"kind": "album", "name": album["title"], "album": album, "artist": artist.get("name", ""),
                "tracks": album.get("tracks"), "error": None}
        self.artist_pages.append(page)
        self.render_artist()
        if page["tracks"] is not None:   # one of yours: its songs are here already
            return
        src = self.app.sources.get(source)
        if not src:
            page["error"] = f"{SOURCES.get(source, 'that service')} isn't connected"
            self.render_artist()
            return

        def done(res, err):
            page["tracks"], page["error"] = res or [], err
            if self.artist_pages and self.artist_pages[-1] is page:
                self.render_artist()
        in_thread(src.album, album["id"], done=done)

    def artist_back(self):
        if self.artist_pages:
            self.artist_pages.pop()
        if self.artist_pages:
            self.render_artist()
        else:
            self.show_tab(self.artist_from if self.artist_from in self.tab_buttons else "music")

    def render_artist(self):
        lst, pages = self.artist_list, self.artist_pages
        if not pages:
            return
        page = pages[-1]
        lst.remove_all()
        lst.append(self.action_row(f"‹  {pages[-2]['name']}" if len(pages) > 1 else "‹  Back", "artist-back"))
        if page["kind"] == "album":
            al = page["album"]
            self.head_row(lst, al["title"], " · ".join(x for x in (page["artist"], al.get("sub")) if x),
                          (al.get("tracks") or [None])[0] or {"id": "pl-" + al["id"], "thumb": al.get("thumb")},
                          icon="media-optical-symbolic")
            if page["error"]:
                self.section(lst, f"COULDN'T OPEN IT: {str(page['error'])[:60].upper()}")
            elif page["tracks"] is None:
                self.section(lst, "LOADING…")
            else:
                tracks = page["tracks"]
                self.actions_row(lst, [("Play", lambda _b: self.app.play_list(tracks), False),
                                       ("Shuffle", lambda _b: self.app.play_list(tracks, shuffled=True), False),
                                       ("DJ", lambda _b: self.dj_from({"kind": "songs", "name": al["title"], "songs": tracks}), True),
                                       ("+ Playlist", lambda b: self.playlist_menu(b, tracks), True)])
                self.lazy(lst, len(tracks), lambda i: self.add_track(lst, tracks[i], i, tracks))
            self.scroll_top(lst)
            return
        info, mine = page["info"], page["mine"]
        thumb = {"id": "ar-" + norm(page["name"]), "thumb": info["thumb"]} if info and info.get("thumb") else None
        sub = (f"From {SOURCES[info['source']]}" if info else "Couldn't find them" if page["error"] else "Looking them up…")
        if mine:
            sub += f" · {len(mine)} song{'s' if len(mine) != 1 else ''} in your music"
        self.head_row(lst, info["name"] if info else page["name"], sub, thumb, round_=True)
        if mine:
            self.section(lst, "IN YOUR MUSIC")
            for i, t in enumerate(mine):
                self.add_track(lst, t, i, mine)
        if info is None and not page["error"]:
            self.section(lst, "LOADING…")
        elif info:
            if info["top"]:
                top = info["top"]
                self.section(lst, f"TOP SONGS · {SOURCES[info.get('top_source') or info['source']].upper()}")
                for i, t in enumerate(top):
                    self.add_track(lst, t, i, top)
            if info["albums"]:
                self.section(lst, "ALBUMS & SINGLES")
                for al in info["albums"]:
                    lst.append(PlaylistRow(self, dict(al, source=info["source"]), icon="media-optical-symbolic"))
        elif not mine:
            self.section(lst, f"NOTHING FOUND: {str(page['error'])[:60].upper()}")
        self.scroll_top(lst)

    # ---- picking several songs: queue them, add them to a playlist, take them out ----
    def select_bar(self):
        bar = Gtk.Box(spacing=4)
        bar.add_css_class("selectbar")
        self.picked_label = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        self.picked_label.add_css_class("picked")
        bar.append(self.picked_label)

        def pill(label, tip, cb):
            b = Gtk.Button(label=label, tooltip_text=tip, valign=Gtk.Align.CENTER)
            b.add_css_class("pill")
            b.connect("clicked", lambda *_: cb())
            bar.append(b)
            return b
        self.sel_queue = pill("Queue", "Add to the queue, after the songs you queued before", lambda: self.selection_do("queue"))
        self.sel_playlist = pill("+ Playlist", "Add to one of your playlists",
                                 lambda: self.playlist_menu(self.sel_playlist, self.picked_tracks(), after=self.stop_selecting))
        self.sel_remove = pill("Remove", "", lambda: self.selection_do("remove"))
        self.sel_download = icon_button("folder-download-symbolic", "ctl", "Download in FLAC",
                                        lambda: self.selection_do("download"))
        bar.append(self.sel_download)
        bar.append(icon_button("edit-select-all-symbolic", "ctl", "Select all (Ctrl+A)", self.select_all))
        bar.append(icon_button("window-close-symbolic", "ctl", "Done (Esc)", self.stop_selecting))
        self.selectbar = Gtk.Revealer(child=bar, reveal_child=False, transition_type=Gtk.RevealerTransitionType.SLIDE_UP,
                                      transition_duration=150)
        return self.selectbar

    def start_selecting(self, row, extend=False):
        """Pick row's song (Shift: every song from the last one picked to it)."""
        lst = row.get_parent()
        if not self.selecting or lst is not self.select_list:
            if self.selecting:
                self.stop_selecting()
            self.selecting, self.select_list, self.selected, self.anchor = True, lst, {}, None
            for r in self.rows(lst):
                r.show_check(True, False)
            self.selectbar.set_reveal_child(True)
        if extend and self.anchor is not None:
            lo, hi = sorted((self.anchor, row.index))
            for r in self.rows(lst):
                if lo <= r.index <= hi:
                    r.show_check(True, True)
        else:
            row.show_check(True, not row.check.get_active())
            self.anchor = row.index
        self.update_selectbar()

    def set_selected(self, row, on):
        if not self.selecting or row.get_parent() is not self.select_list:
            return
        if on:
            self.selected[row.index] = row.track
        else:
            self.selected.pop(row.index, None)
        self.update_selectbar()

    def stop_selecting(self):
        lst = self.select_list
        self.selecting, self.select_list, self.selected = False, None, {}
        for r in self.rows(lst):
            r.show_check(False, False)
        self.selectbar.set_reveal_child(False)

    def select_all(self):
        self.lazy_all(self.select_list)
        rows = list(self.rows(self.select_list))
        on = not all(r.check.get_active() for r in rows)
        for r in rows:
            r.show_check(True, on)

    def picked_tracks(self):
        return [self.selected[i] for i in sorted(self.selected)]

    def update_selectbar(self):
        n = len(self.selected)
        self.picked_label.set_label(f"{n} selected" if n else "Pick songs")
        lst = self.select_list
        in_queue, in_mine = lst is self.queue_list, lst is self.music_list and bool(self.open_mine)
        self.sel_remove.set_visible(in_queue or in_mine)
        self.sel_remove.set_tooltip_text("Take out of the queue" if in_queue else "Take out of this playlist")
        self.sel_queue.set_visible(not in_queue)
        for w in (self.sel_queue, self.sel_playlist, self.sel_remove, self.sel_download):
            w.set_sensitive(n > 0)
        self.sel_download.set_visible(any(source_of(t) != "file" and not self.lib.has(t["id"]) for t in self.selected.values()))

    def selection_do(self, what):
        tracks = self.picked_tracks()
        if not tracks:
            return
        if what == "queue":
            self.app.enqueue(tracks, "queue")
        elif what == "download":
            self.app.download(tracks)
        elif what == "remove":
            if self.select_list is self.queue_list:
                self.app.unqueue_many(sorted(self.selected))
            elif self.open_mine:
                self.app.remove_from_playlist(self.open_mine, {t["id"] for t in tracks})
        self.stop_selecting()

    # ---- your library on the service picked at the top ----
    playlists = None        # {service: your playlists there}, once loaded
    open_playlist = None    # (playlist, tracks) while one is open

    def action_row(self, label, action):
        row = Gtk.ListBoxRow(child=Gtk.Label(label=label, xalign=0, wrap=True))
        row.add_css_class("back")
        row.account_action = action
        return row

    def refresh_account(self):
        self.when_shown("account", self._refresh_account)

    def _refresh_account(self):
        lst = self.account_list
        key = self.app.source
        src = self.app.sources.get(key)
        if self.playlists is None:
            self.playlists = {}
        if not src:
            err = self.app.source_errors.get(key)
            if err:
                self.set_empty(lst, f"{SOURCES[key]} isn't available", str(err)[:140])
                lst.append(self.action_row("↻  Check again", "recheck"))
            else:
                self.set_empty(lst, "Connecting…", f"Reading your {SOURCES[key]} login.")
            return
        if not src.signed_in:
            self.set_empty(lst, "Not signed in", src.hint)
            if key == "tidal":
                lst.append(self.sync_row())
                self.tidal_paste_row(lst)
            elif key == "spotify":
                lst.append(self.action_row("Connect Spotify  ›", "spotify"))
            else:
                lst.append(self.action_row("↻  Check again", "recheck"))
            return
        if self.open_playlist:
            pl, tracks = self.open_playlist
            lst.remove_all()
            back = Gtk.ListBoxRow(child=Gtk.Label(label=f"‹  {pl['title']}", xalign=0))
            back.add_css_class("back")
            back.account_action = "back"
            lst.append(back)
            if tracks is None:
                self.section(lst, "LOADING…")
                return
            if tracks:
                self.actions_row(lst, [("Play", lambda _b: self.app.play_list(tracks), False),
                                       ("Shuffle", lambda _b: self.app.play_list(tracks, shuffled=True), False),
                                       ("DJ", lambda _b: self.dj_from({"kind": "songs", "name": pl["title"], "songs": tracks}), True)])
            self.lazy(lst, len(tracks), lambda i: self.add_track(lst, tracks[i], i, tracks))
            return
        if key not in self.playlists:
            self.set_empty(lst, "Loading your library…", "")
            self.playlists[key] = None
            in_thread(src.my_playlists, done=lambda res, err, key=key: self._playlists_loaded(key, res, err))
            return
        if self.playlists[key] is None:   # still loading
            return
        lst.remove_all()
        lst.append(self.sync_row())
        self.tidal_paste_row(lst)
        if self.app.lastfm.connected:
            lst.append(self.action_row(f"✦  Your {wrapped_year()} Wrapped  ›", "wrapped"))
        if not self.playlists[key]:
            self.section(lst, "NO PLAYLISTS YET")
        for pl in self.playlists[key]:
            lst.append(PlaylistRow(self, pl))

    def tidal_paste_row(self, lst):
        if self.app.tidal_link:
            paste = Gtk.Entry(placeholder_text="Paste the “Oops” page address, then Enter")
            paste.add_css_class("search")
            paste.connect("activate", lambda e: e.get_text().strip() and self.app.finish_tidal_login(e.get_text()))
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=paste))

    sync_label = None

    def sync_row(self):
        """Tidal and the FLAC sync: connect, or how far it has got."""
        self.sync_label = Gtk.Label(xalign=0, wrap=True)
        self.sync_label.add_css_class("sync")
        row = Gtk.ListBoxRow(child=self.sync_label)
        row.account_action = "tidal"
        self.update_sync()
        return row

    def update_sync(self):
        self.refresh_count()
        if self.sync_label:
            self.sync_label.set_label(self.app.sync_status())

    def _playlists_loaded(self, key, res, err):
        if err:
            self.playlists.pop(key, None)
            if key == self.app.source:
                self.set_empty(self.account_list, "Couldn't load your library", str(err)[:120])
                self.account_list.append(self.action_row("↻  Try again", "reload"))
            return
        self.playlists[key] = [dict(p, source=key) for p in res or []]
        if key == self.app.source:
            self.refresh_account()

    def open_list(self, pl):
        self.open_playlist = (pl, None)
        self.refresh_account()

        def done(res, err):
            if not self.open_playlist or self.open_playlist[0] is not pl:
                return
            if err:
                self.open_playlist = None
                self.toast(f"Couldn't open {pl['title']}: {str(err)[:80]}")
            else:
                self.open_playlist = (pl, res or [])
            self.refresh_account()
        src = self.app.sources.get(pl.get("source") or self.app.source)
        in_thread(src.playlist, pl["id"], done=done)

    def on_source_changed(self):
        key = self.app.source
        if self.source_group.get_active_name() != key:
            self.syncing_source = True
            self.source_group.set_active_name(key)
            self.syncing_source = False
        self.open_playlist = None
        self.refresh_account()

    def refresh_queue(self):
        """What's playing and what comes after it, in order: the songs you queued first.
        (Songs already played aren't listed; Previous goes back through them.)"""
        self.when_shown("queue", self._refresh_queue)

    def _refresh_queue(self):
        q, i = self.app.queue, self.app.index
        lst = self.queue_list
        if not q[max(i, 0):]:
            self.set_empty(lst, "Queue is empty", "Pick a song and a radio of similar songs follows it.\n"
                           "Right-click a song (or press a) to queue it.")
            return
        lst.remove_all()
        heads = {"now": "NOW PLAYING", "queued": "QUEUED BY YOU",
                 "next": "UP NEXT · DJ" if self.app.dj["on"] else "UP NEXT · RADIO" if self.app.radio_from else "UP NEXT"}
        last = [None]
        start = max(i, 0)

        def add(k):
            j = start + k
            t = q[j]
            kind = "now" if j == i else "queued" if t.get("queued") else "next"
            if kind != last[0]:
                self.section(lst, heads[kind])
                last[0] = kind
            row = self.add_track(lst, t, j, q, in_queue=True)
            if j == i:
                row.add_css_class("playing")
        self.lazy(lst, len(q) - start, add)

    def track_menu(self, row, x, y):
        """Right-click on a song: play it next, queue it, or take it out of the queue."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pop = Gtk.Popover(child=box, has_arrow=False, position=Gtk.PositionType.BOTTOM)
        pop.set_parent(row)
        spot = Gdk.Rectangle()
        spot.x, spot.y, spot.width, spot.height = int(x), int(y), 1, 1
        pop.set_pointing_to(spot)

        def item(label, cb):
            b = Gtk.Button(label=label)
            b.add_css_class("menu-item")
            b.get_child().set_xalign(0)
            b.connect("clicked", lambda *_: (pop.popdown(), cb()))
            box.append(b)
        t = row.track
        if self.selecting:
            return
        item("Play next", lambda: self.app.enqueue([t], "next"))
        item("Add to queue", lambda: self.app.enqueue([t], "queue"))
        item("Add to playlist…", lambda: self.playlist_menu(row, [t], x, y))
        for name in split_artists(t["artist"])[:3]:
            item(f"Go to {name}", lambda name=name: self.open_artist(name, prefer=source_of(t)))
        if row.in_queue and row.index != self.app.index:
            item("Remove from queue", lambda: self.app.unqueue(row.index))
        if row.get_parent() is self.music_list and self.open_mine:
            item("Remove from this playlist", lambda: self.app.remove_from_playlist(self.open_mine, {t["id"]}))
        if source_of(t) != "file" and not self.lib.has(t["id"]) and not self.dl.busy(t["id"]):
            item("Download", lambda: self.download_only(t))
        if row.group is not None:
            item("Select…", lambda: self.start_selecting(row))
        pop.connect("closed", lambda p: GLib.idle_add(lambda: (p.unparent(), False)[1]))
        pop.popup()

    def focused_track_row(self):
        focus = self.get_focus()
        while focus and not isinstance(focus, TrackRow):
            focus = focus.get_parent()
        return focus

    def refresh_results(self):
        if self.results or self.result_artists or self.result_albums:
            self.when_shown("search", self.render_search)

    def refresh_all(self):
        """Songs were saved or removed: the marks on the rows now; the Music tab, where your
        downloads are songs of their own, a moment later (a sync saves one song after another)."""
        self.mark_rows()
        self.refresh_queue()
        self.update_saved()
        if not getattr(self, "_music_soon", 0):
            def later():
                self._music_soon = 0
                if not self.selecting:
                    self.refresh_music()
                return False
            self._music_soon = GLib.timeout_add(1500, later)

    def on_row(self, key, row):
        if self.selecting:   # a click picks the song (or unpicks it) instead of playing it
            if isinstance(row, TrackRow) and row.get_parent() is self.select_list:
                row.check.set_active(not row.check.get_active())
            return
        action = getattr(row, "account_action", None)
        if action == "back":
            self.open_playlist = None
            self.refresh_account()
            return
        if action == "new-playlist":
            self.ask_name("New playlist", "", self.app.new_playlist, ok="Make it")
            return
        if action == "import-m3u":
            self.pick_m3u()
            return
        if action == "mine-back":
            self.open_mine = None
            self.refresh_music()
            return
        if action == "artist-back":
            self.artist_back()
            return
        if action == "spotify":
            self.accounts_pop.popup()
            return
        if action == "tidal":
            self.app.connect_tidal()
            return
        if action == "recheck":
            self.app.recheck(self.app.source)
            return
        if action == "reload":
            self.playlists.pop(self.app.source, None)
            self.refresh_account()
            return
        if action == "wrapped":
            self.app.open_wrapped()
            return
        if isinstance(row, PlaylistRow) and row.playlist.get("kind") in ("artist", "album"):
            src = row.playlist.get("source")
            if row.playlist["kind"] == "artist":
                self.open_artist(row.playlist["title"], prefer=src if src in SOURCES else None)
            else:
                self.open_album_page(row.playlist)
            return
        if isinstance(row, PlaylistRow):
            if key == "music":
                self.open_mine = row.playlist["id"]
                self.refresh_music()
                self.scroll_top(self.music_list)
            elif key == "artist":
                self.open_album(row.playlist)
            else:
                self.open_list(row.playlist)
            return
        if not isinstance(row, TrackRow):
            return
        if key == "queue":
            self.app.play_index(row.index)
        elif getattr(row, "queue_index", None) is not None:   # a song of the DJ's: it stays on
            self.app.play_index(row.queue_index)
        elif key == "search":
            self.app.play_from(self.results, row.index, radio=len(self.results) > 1 and not self.results_is_list)
        elif row.group is not None:
            self.app.play_from(row.group, row.index, radio=False)

    # ---- search ----
    results_is_list = False
    result_artists, result_albums, results_from = [], [], "tidal"

    def search_hint(self):
        return ("Search your songs, artists and albums" if self.app.search_in == "local"
                else f"Search {SEARCH_IN[self.app.search_in]}, or paste a link")

    def set_search_in(self, key):
        if key == self.app.search_in:
            return
        self.app.search_in = key
        self.app.save_soon()
        self.entry.set_placeholder_text(self.search_hint())
        if self.entry.get_text().strip():
            self.search()

    def on_search_changed(self, entry):
        if entry.get_text().strip():
            self.show_tab("search")

    def search(self):
        """Search where the dropdown says (a pasted link: its own service), for songs, artists and albums."""
        q = self.entry.get_text().strip()
        if not q:
            return
        link = link_source(q)
        key = link or self.app.search_in
        tidal = self.app.sources.get("tidal")
        if key == "tidal" and not link and not (tidal and tidal.signed_in):
            self.toast("Tidal isn't connected: searching YouTube Music")
            key = "ytm"
        self.show_tab("search")
        self.search_seq += 1
        seq = self.search_seq
        self.results_is_list = bool(re.search(r"[?&]list=|/playlist/|/album/|/mix/", q))
        self.results_from = key
        if key == "local":
            songs, artists, albums = local_matches(self.app.my_songs(), q)
            self.results, self.result_artists = songs, artists
            self.result_albums = [{"id": "local-" + norm(f"{al['title']} {al['artist']}"), "title": al["title"],
                                   "sub": " · ".join(x for x in (al["artist"], f"{len(al['tracks'])} song{'s' if len(al['tracks']) != 1 else ''}") if x),
                                   "thumb": "", "count": "", "tracks": al["tracks"]} for al in albums]
            self.render_search(q)
            return
        src = self.app.sources.get(key)
        if not src:
            self.toast(f"Still connecting to {SOURCES[key]}…")
            return
        if key in ("tidal", "spotify") and not src.signed_in:
            self.toast(f"Connect {SOURCES[key]} in the accounts menu first")
            return
        self.set_empty(self.search_list, "Searching…", q)

        def work():
            if link or not hasattr(src, "find"):
                return {"songs": src.search(q), "artists": [], "albums": []}
            return src.find(q)

        def done(res, err):
            if seq != self.search_seq:
                return
            if err:
                self.set_empty(self.search_list, "Search failed", "Offline? Downloaded songs still play.\n" + str(err)[:120])
                return
            self.results, self.result_artists = res["songs"], res["artists"]
            self.result_albums = [dict(al, source=key) for al in res["albums"]]
            self.render_search(q)
        in_thread(work, done=done)

    def render_search(self, q=""):
        lst = self.search_list
        if not (self.results or self.result_artists or self.result_albums):
            where = "your music" if self.results_from == "local" else SOURCES.get(self.results_from, "")
            self.set_empty(lst, "Nothing found", f"{q}\nin {where}" if q else "")
            return
        lst.remove_all()
        if self.result_artists:
            self.section(lst, "ARTISTS")
            for a in self.result_artists:
                name = a["name"] if isinstance(a, dict) else a
                lst.append(PlaylistRow(self, {"id": "ar-" + norm(name), "title": name, "sub": "Artist", "count": "",
                                              "thumb": a.get("thumb", "") if isinstance(a, dict) else "", "kind": "artist",
                                              "source": self.results_from}, icon="avatar-default-symbolic"))
        if self.result_albums:
            self.section(lst, "ALBUMS")
            for al in self.result_albums:
                lst.append(PlaylistRow(self, dict(al, kind="album"), cover=(al.get("tracks") or [None])[0],
                                       icon="media-optical-symbolic"))
        if self.results:
            if self.result_artists or self.result_albums:
                self.section(lst, "SONGS")
            for i, t in enumerate(self.results):
                self.add_track(lst, t, i, self.results)

    # ---- actions ----
    def download_only(self, track):
