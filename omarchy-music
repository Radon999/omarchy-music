        while (child := box.get_first_child()):
            box.remove(child)
        grid = Gtk.Grid(column_spacing=10, row_spacing=8)
        box.append(grid)
        row = 0
        up = a.updater

        def pill(label, cb, quiet=False):
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
            b.add_css_class("pill")
            if quiet:
                b.add_css_class("quiet")
            b.connect("clicked", lambda *_: cb())
            return b

        def line(name, state, ok=False, *actions):
            nonlocal row
            n = Gtk.Label(label=name, xalign=0, valign=Gtk.Align.START)
            n.add_css_class("service")
            s = Gtk.Label(label=state, xalign=0, wrap=True, hexpand=True, max_width_chars=24)
            s.add_css_class("state")
            if ok:
                s.add_css_class("ok")
            grid.attach(n, 0, row, 1, 1)
            grid.attach(s, 1, row, 1, 1)
            if actions:
                act = Gtk.Box(spacing=4, halign=Gtk.Align.END, valign=Gtk.Align.CENTER)
                for w in actions:
                    act.append(w)
                grid.attach(act, 2, row, 1, 1)
            row += 1
            return s

        def across(widget):
            nonlocal row
            grid.attach(widget, 0, row, 3, 1)
            row += 1

        def sync_switch(key):
            tip = (f"Download every song in your {SOURCES[key]} {'favourites and ' if key == 'tidal' else ''}"
                   "playlists in FLAC, and keep up with them. Off: songs download only when you play or pick them.")
            box = Gtk.Box(spacing=6, tooltip_text=tip)
            label = Gtk.Label(label="Sync")
            label.add_css_class("state")
            sw = Gtk.Switch(active=a.sync_sources.get(key, False), valign=Gtk.Align.CENTER)
            sw.connect("notify::active", lambda s, _p: a.set_sync_source(key, s.get_active()))
            box.append(label)
            box.append(sw)
            return box

        if up.latest:
            new = up.latest.lstrip("v")
            if up.state == "restart":
                line("Update", f"Updated to {new}: restart to use it", True, pill("Restart", up.restart))
            elif up.state == "working":
                line("Update", f"Updating to {new}…" if not WINDOWS else f"Downloading {new}… (it reopens when it's done)")
            else:
                line("Update", up.state or f"Omarchy Music {new} is out (this is {VERSION})", False,
                     pill("Update", up.install))
        else:
            line("Version", f"{VERSION} · checking…" if up.checking else f"{VERSION} · {up.check_error or 'up to date'}", False,
                 *([] if up.checking else [pill("Check", lambda: up.check(quiet=False), quiet=True)]))
        grid.attach(Gtk.Separator(), 0, row, 3, 1)
        row += 1
        for key in ("ytm", "apple"):
            src = a.sources.get(key)
            if src and src.signed_in:
                line(SOURCES[key], f"Signed in · {src.browser.title()}", True, sync_switch(key))
            elif src or a.source_errors.get(key):
                line(SOURCES[key], f"Sign in at {'music.youtube.com' if key == 'ytm' else 'music.apple.com'} in Chromium",
                     False, pill("Check again", lambda key=key: a.recheck(key), quiet=True))
            else:
