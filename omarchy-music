def biquad_db(kind, hz, gain, q, f, rate=48000):
    """The gain in dB at f Hz of one filter, as libavfilter builds it (the RBJ cookbook)."""
    a, w0 = 10 ** (gain / 40), 2 * math.pi * hz / rate
    cw, alpha = math.cos(w0), math.sin(w0) / (2 * q)
    if kind == "pk":
        b, d = (1 + alpha * a, -2 * cw, 1 - alpha * a), (1 + alpha / a, -2 * cw, 1 - alpha / a)
    else:
        sa = 2 * math.sqrt(a) * alpha
        s = 1 if kind == "ls" else -1  # the high shelf is the low one mirrored
        b = (a * ((a + 1) - s * (a - 1) * cw + sa), s * 2 * a * ((a - 1) - s * (a + 1) * cw),
             a * ((a + 1) - s * (a - 1) * cw - sa))
        d = ((a + 1) + s * (a - 1) * cw + sa, -s * 2 * ((a - 1) + s * (a + 1) * cw), (a + 1) + s * (a - 1) * cw - sa)
    z = cmath.exp(-1j * 2 * math.pi * f / rate)
    return 20 * math.log10(abs((b[0] + b[1] * z + b[2] * z * z) / (d[0] + d[1] * z + d[2] * z * z)))


def eq_preamp(filters):
    """The cut that keeps the EQ's biggest boost from clipping: dB, 0 or below."""
    freqs = [20 * 1000 ** (i / 299) for i in range(300)]  # 20 Hz to 20 kHz
    peak = max(sum(biquad_db(*flt, f) for flt in filters) for f in freqs)
    return -math.ceil(max(0.0, peak) * 10) / 10


def eq_graph(correction, bands, preamp, tone=None):
    """The libavfilter graph, in 64-bit float throughout so nothing clips or rounds
    between filters. The bands and the bass and treble shelves are named so their
    gains can change while playing."""
    names = {"pk": "equalizer", "ls": "lowshelf", "hs": "highshelf"}
    parts = ["aformat=sample_fmts=dblp", f"volume@pre=volume={preamp}dB:precision=double"]
    parts += [f"{names[k]}@c{i}=f={hz}:t=q:w={q}:g={g}" for i, (k, hz, g, q) in enumerate(correction)]
    parts += [f"equalizer@g{i}=f={hz}:t=q:w={EQ_Q}:g={g}" for i, (hz, g) in enumerate(zip(EQ_BANDS, bands))]
    parts += [f"{names[k]}@{name}=f={hz}:t=q:w={q}:g={(tone or {}).get(name, 0)}" for name, (k, hz, q) in TONE.items()]
    return ",".join(parts)


def fmt_db(g):
    return "0" if g == 0 else ("+" if g > 0 else "−") + f"{abs(g):.1f}".removesuffix(".0")


