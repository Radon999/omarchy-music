    # ---- the command line: omarchy-music play / next / queue / lyrics / wrapped ... ----
    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        if not args:
            self.activate()   # the bar icon and Super+Q: toggle the popup
            return 0
        verb, rest = args[0].lower(), args[1:]

        def say(text):
            cmd.print_literal(text.rstrip("\n") + "\n")

        def fail(text, status=1):
            cmd.printerr_literal(text.rstrip("\n") + "\n")
            return status

        if verb == "--background":   # started for a command, before the app was running
            pass
        elif verb in ("help", "--help", "-h"):
            say(__doc__.strip())
        elif verb in ("play", "next", "queue", "add"):
            if rest:
                return self.command_songs(cmd, {"add": "queue"}.get(verb, verb), rest)
            if verb == "next":
                self.next()
            elif verb == "play" and self.current_track():
                self.set_paused(False)
            else:
                return fail(f"Which song? omarchy-music {verb} SONG  (a search, a link or a file)", 2)
        elif verb == "skip":
            self.next()
        elif verb in ("prev", "previous", "back"):
            self.previous()
        elif verb == "pause":
            self.set_paused(True)
        elif verb in ("play-pause", "toggle-pause"):
            self.toggle_pause()
        elif verb in ("show", "open"):
            arg = (rest or [""])[0].lower()
            views = {"music": "all", "all": "all", "saved": "all", "playlists": "playlists", "recent": "recent",
                     "added": "added", "top": "top", "most-played": "top"}
            tab = {"search": "search", "library": "account", "queue": "queue", "up-next": "queue",
                   "lyrics": "lyrics"}.get(arg) or ("music" if arg in views else None)
            if rest and not tab:
                return fail("omarchy-music show [search|library|music|playlists|recent|added|top|queue|lyrics]", 2)
            self.show_window(tab)
            if arg in views:
                self.win.set_music_view(views[arg])
        elif verb == "accounts":
            self.show_window()
            self.win.accounts_pop.popup()
        elif verb == "hide":
            if self.win:
                self.win.set_visible(False)
        elif verb == "toggle":
            self.activate()
        elif verb == "lyrics":
            if rest and rest[0].lower() not in ("genius", "synced"):
                return fail("omarchy-music lyrics [genius|synced]", 2)
            if rest:
                self.set_lyrics_mode(rest[0].lower())
            self.show_window("lyrics")
        elif verb == "search":
            self.show_window("search")
            if rest:
                self.win.entry.set_text(" ".join(rest))
                self.win.search()
        elif verb == "wrapped":
            arg = (rest or [""])[0].lower()
            if arg and not arg.startswith("all") and not arg.isdigit() and arg not in ("month", "week"):
                return fail("omarchy-music wrapped [YEAR|month|week|all]", 2)
            self.open_wrapped("all" if arg.startswith("all") else this_period(arg) if arg in ("month", "week")
                              else int(arg) if arg else None)
            if not self.lastfm.connected:
                return fail("Wrapped is made from your Last.fm scrobbles: connect Last.fm first "
                            "(the accounts menu, or omarchy-music --lastfm-login)")
        elif verb == "tag":
            n = len(self.tagger.untagged())
            if rest[:1] == ["all"]:
                self.retag_all()
                say("Retagging every saved song, in the background")
            elif n:
                self.tagger.start()
                say(f"Tagging {n} songs in the background")
            else:
                say("Every saved song is tagged already (omarchy-music tag all to do them again)")
        elif verb == "source":
            if not rest:
                say(SOURCES[self.source])
            elif SOURCE_ALIASES.get(rest[0].lower()):
                self.set_source(SOURCE_ALIASES[rest[0].lower()])
                say(f"Browsing {SOURCES[self.source]}")
            else:
                return fail("omarchy-music source youtube|tidal|apple|spotify", 2)
        elif verb == "status":
            say(self.status_text())
        elif verb == "reload":   # a terminal login (--tidal-login, --lastfm-login) while running
            self.reload_logins()
        elif verb == "quit":
            self.quit_app()
        elif self.is_song_arg(args[0], cmd.get_cwd()):   # a file or link on its own (Open With): play it
            return self.command_songs(cmd, "play", args)
        else:
            return fail(f"Unknown command “{args[0]}”: see omarchy-music help", 2)
        return 0

    @staticmethod
    def is_song_arg(arg, cwd):
        if re.match(r"(https?|file)://", arg):
            return True
        return (Path(cwd or HOME) / Path(arg).expanduser()).exists()

    def command_songs(self, cmd, how, words):
        """play / next / queue SONG: each line of stdin for "-", each file or link
        given, else all the words as one search. The terminal waits for the answer."""
        self.commands.add(cmd)   # alive until done(): the terminal is waiting on it
        cwd = cmd.get_cwd()
        stdin = cmd.get_stdin() if words == ["-"] else None

        def work():
            if words == ["-"]:
                if not stdin:
                    raise RuntimeError("couldn't read the songs from stdin")
                data, queries = Gio.DataInputStream.new(stdin), []
                while True:
                    line, _n = data.read_line_utf8(None)
                    if line is None:
                        break
                    if line.strip():
                        queries.append(line.strip())
            elif all(self.is_song_arg(w, cwd) for w in words):
                queries = words
            else:
                queries = [" ".join(words)]
            found, missing = [], []
            for q in queries:
                try:
                    tracks, why = self.resolve_query(q, cwd), ""
                except Exception as e:  # noqa: BLE001 -- told to the terminal
                    tracks, why = [], f": {str(e)[:120]}"
                if tracks:
                    found += tracks
                else:
                    missing.append(f"Couldn't find “{q}”{why}")
            return found, missing

        def done(res, err):
            try:
                found, missing = res or ([], [f"Couldn't do that: {err}"])
                for line in missing:
                    cmd.printerr_literal(line + "\n")
                more = f"  (and {len(found) - 1} more)" if len(found) > 1 else ""
                if found and how == "play":
                    self.play_from(found, 0, radio=len(found) == 1 and source_of(found[0]) != "file")
                    cmd.print_literal(f"Playing: {song_line(found[0])}{more}\n")
                elif found:
                    pos = self.enqueue(found, how)
                    if pos is None:
                        cmd.print_literal(f"Playing: {song_line(found[0])}{more}\n")
                    else:
                        cmd.print_literal(f"{'Next' if how == 'next' else 'Queued'} (#{pos - self.index}): "
                                          f"{song_line(found[0])}{more}\n")
                cmd.set_exit_status(0 if found and not missing else 1)
            finally:
                cmd.done()
                self.commands.discard(cmd)
        in_thread(work, done=done)
        return 0

    def resolve_query(self, q, cwd=None):
        """The songs a query means (blocking): a file or folder, a song, album or
        playlist link on any of the services, a saved song, else the best match
        on the service you browse."""
        if q.startswith("file://"):
            q = Gio.File.new_for_uri(q).get_path() or q
        p = Path(cwd or HOME) / Path(q).expanduser()
        if p.is_file():
            return [track_from_file(p)]
        if p.is_dir():
            return [track_from_file(f) for f in sorted(p.rglob("*")) if f.suffix.lower() in AUDIO_EXT]
        key = ("apple" if "music.apple.com" in q else "tidal" if "tidal.com" in q
               else "spotify" if re.search(r"open\.spotify\.com/|^spotify:", q)
               else "ytm" if re.search(r"youtube\.com/|youtu\.be/", q) else None)
        if key:
            src = self.wait_source(key)
            if not src or (key in ("tidal", "spotify") and not src.signed_in):
                raise RuntimeError(f"{SOURCES[key]} isn't connected")
            return src.search(q)
        hit = self.lib.find(q)
        if hit:
            return [hit]
        src = self.wait_source(self.source)
        if not src or (self.source in ("tidal", "spotify") and not src.signed_in):
            src = self.wait_source("ytm")   # searches signed out too
        if not src:
            raise RuntimeError("no music service is connected")
        return src.search(q)[:1]

    def wait_source(self, key, timeout=30):
        """The service once it has connected (blocking, off the UI thread), None if it couldn't."""
        end = time.monotonic() + timeout
        while key not in self.sources and key not in self.source_errors and time.monotonic() < end:
            time.sleep(0.2)
        return self.sources.get(key)

    def status_text(self):
        t = self.current_track()
        lines = ["Nothing playing."]
        if t:
            lines = [f"{'Paused' if self.paused else 'Playing'}: {song_line(t)}  "
                     f"{fmt_time(self.position)} / {fmt_time(self.duration or t.get('duration'))}"]
            upcoming = self.queue[self.index + 1:]
            if upcoming:
                lines.append("Up next:")
                lines += [f"  {'+' if u.get('queued') else ' '} {song_line(u)}" for u in upcoming[:8]]
                if len(upcoming) > 8:
                    lines.append(f"    and {len(upcoming) - 8} more" + (", a radio" if self.radio_from else ""))
        if self.tagger.running:
            lines.append(self.tagger.status())   # Tagging · 12 of 364
        return "\n".join(lines)

    # ---- theme ----
    def reload_theme(self):
        theme = load_theme()
        provider = Gtk.CssProvider()
        provider.load_from_string(theme_css(theme))
        self.tint_path = None   # light or dark: the cover's colour is redone to suit
        display = Gdk.Display.get_default()
        if display:
            if self.provider:
                Gtk.StyleContext.remove_provider_for_display(display, self.provider)
            Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.provider, self.theme = provider, theme
        Adw.StyleManager.get_default().set_color_scheme(
            Adw.ColorScheme.FORCE_LIGHT if theme["c"].get("mode") == "light" else Adw.ColorScheme.FORCE_DARK)
        if self.win:
            self.win.update_tint()

    def set_tint(self, path):
        """Colour the window like the cover at path (None: the theme's own colours)."""
        path = path if self.art_colors else None
        if path == self.tint_path:
            return
        self.tint_path = path
        if not path:
            self.apply_tint(None)
            return
        in_thread(art_color, path, done=lambda rgb, _e: path == self.tint_path and self.apply_tint(rgb))

    def apply_tint(self, rgb):
        display = Gdk.Display.get_default()
        if not display:
            return
        if self.tint_provider:
            Gtk.StyleContext.remove_provider_for_display(display, self.tint_provider)
            self.tint_provider = None
        if rgb:
            self.tint_provider = Gtk.CssProvider()
            self.tint_provider.load_from_string(tint_css(rgb, self.theme["c"].get("mode") == "light"))
            Gtk.StyleContext.add_provider_for_display(display, self.tint_provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)

    def set_art_colors(self, on):
        self.art_colors = on
        self.save_soon()
        if self.win:
            self.win.update_tint()

    def watch_theme(self):
        self.monitors, self._theme_timer = [], 0
        for path in (CURRENT, THEME_DIR):
            try:
                mon = Gio.File.new_for_path(str(path)).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
                mon.connect("changed", lambda *_: self._debounce_theme())
                self.monitors.append(mon)
            except GLib.Error:
                pass

    def _debounce_theme(self):
        if self._theme_timer:
            GLib.source_remove(self._theme_timer)
        self._theme_timer = GLib.timeout_add(400, lambda: (setattr(self, "_theme_timer", 0), self.reload_theme(), False)[2])

    # ---- the services: YouTube Music, Tidal, Apple Music ----
    def connect_sources(self, keys=tuple(SOURCES)):
        classes = {"ytm": YTM, "tidal": Tidal, "apple": AppleMusic, "spotify": Spotify}
        for key in keys:
            in_thread(classes[key], done=lambda src, err, key=key: self.source_ready(key, src, err))

    def source_ready(self, key, src, err):
        if src:
            self.sources[key] = src
            self.source_errors.pop(key, None)
            if key == "tidal":
                self.dl.tidal, self.tidal_error = src, None
            elif key == "ytm":
                self.dl.ytm = src.api
        elif key not in self.sources:   # a failed recheck keeps the one that worked
            self.source_errors[key] = err
            if key == "tidal":
                self.tidal_error = err
        if key == "tidal" and self.restore_pending:
            self.restore_pending = False
            self.load_current(autoplay=False)
        src = self.sources.get(key)
        if src and src.signed_in:
            in_thread(src.liked_ids, done=lambda ids, _e: self.got_likes(key, ids))
        self.accounts_changed(key)
        if all(k in self.sources or k in self.source_errors for k in SOURCES):
            self.sync_library()   # once every service has answered, so the first sync has them all
        if key == "tidal" and self.tagger_due:
            self.tagger_due = False
            GLib.timeout_add_seconds(10, lambda: (self.tagger.start(), False)[1])

    def got_likes(self, key, ids):
        if ids is None:
            return
        self.likes[key] = set(ids)
        self.liked = set().union(*self.likes.values())
        if self.win:
            self.win.update_like()

    def accounts_changed(self, key=None):
        """A service connected, or you signed in or out somewhere: show it."""
        if not self.win:
            return
        self.win.refresh_accounts()
        if key is None or key == self.source:
            self.win.refresh_account()
        self.win.update_like()

    def recheck(self, key):
        """Look for your sign-in again (after signing in in the browser, or in a terminal)."""
        if key != "tidal":   # Tidal keeps downloading with the login it has meanwhile
            self.sources.pop(key, None)
        self.source_errors.pop(key, None)
        if self.win and self.win.playlists:
            self.win.playlists.pop(key, None)
        self.accounts_changed(key)
        self.connect_sources([key])

    def reload_logins(self):
        self.lastfm.reload()
        sp = self.sources.get("spotify")
        if sp and not sp.signed_in:   # connected from a terminal
            sp.auth = read_json(SPOTIFY_AUTH, {})
            if sp.signed_in:
                if self.win and self.win.playlists:
                    self.win.playlists.pop("spotify", None)
                in_thread(sp.liked_ids, done=lambda ids, _e: self.got_likes("spotify", ids))
        if not (self.dl.tidal and self.dl.tidal.connected):
            self.recheck("tidal")
        self.accounts_changed()

    def set_source(self, key):
        if key not in SOURCES or key == self.source:
            return
        self.source = key
        self.save_state()
        if self.win:
            self.win.on_source_changed()

    def set_sync_source(self, key, on):
        self.sync_sources[key] = on
        self.save_state()
        if on:
            self.sync_library()

    def set_lyrics_mode(self, mode):
        if mode not in ("genius", "synced") or mode == self.lyrics_mode:
            return
        self.lyrics_mode = mode
        self.save_soon()
        view = self.win.lyrics if self.win else None
        if view and view.got and view.mode.get_active_name() != mode:   # changed in the accounts menu
            view.render(view.got, None)

    # ---- Spotify: a developer app of yours, then Spotify's consent page ----
    def spotify_connect(self, client_id):
        sp = self.sources.get("spotify")
        if not sp or self.spotify_connecting:
            return
        if not re.fullmatch(r"[0-9a-f]{32}", (client_id or "").strip()):
            self.toast("That isn't a Spotify Client ID: 32 letters and digits")
            return
        self.spotify_connecting = True
        self.accounts_changed("spotify")

        def done(_res, err):
            self.spotify_connecting = False
            if err:
                if str(err) != "cancelled":
                    self.toast(f"Couldn't connect Spotify: {str(err)[:90]}")
            else:
                self.toast("Spotify connected" + (f" as {sp.user}" if sp.user else ""))
                if self.win and self.win.playlists:
                    self.win.playlists.pop("spotify", None)
                in_thread(sp.liked_ids, done=lambda ids, _e: self.got_likes("spotify", ids))
            self.accounts_changed("spotify")
        in_thread(sp.login, client_id, lambda url: GLib.idle_add(lambda: (self.open_uri(url), False)[1]), done=done)

    def spotify_cancel(self):
        sp = self.sources.get("spotify")
        if sp:
            sp.cancelled = True   # the login stops waiting within a second

    def spotify_disconnect(self):
        sp = self.sources.get("spotify")
        if sp:
            sp.disconnect()
        self.likes.pop("spotify", None)
        self.liked = set().union(*self.likes.values())
        if self.win and self.win.playlists:
            self.win.playlists.pop("spotify", None)
        self.accounts_changed("spotify")

    # ---- your music: the folders, the songs you have, an artist's page ----
    def my_songs(self):
        """Every song you have: downloaded here (once each, whichever service it was saved from) and in your folders."""
        seen, out = set(), []
        for t in sorted(self.lib.items.values(), key=lambda t: -t.get("added", 0)):
            if t["file"] not in seen:
                seen.add(t["file"])
                out.append(dict(t))
        return out + [t for t in self.local.tracks() if t["file"] not in seen]

    def most_played(self):
        """The Music tab's Most played: your Last.fm top songs when Last.fm is connected (every
        scrobble, from anywhere), else what you've played here. Last.fm's list is asked for again
        after ten minutes; until it comes, the songs played here stand in."""
        if not self.lastfm.connected:
            return self.plays.top()
        when, songs = self.fm_top
        if (songs is None or time.time() - when > 600) and not getattr(self, "fm_top_busy", False):
            self.fm_top_busy = True

            def done(res, err):
                self.fm_top_busy = False
                if res is not None:
                    self.fm_top = (time.time(), res)
                elif songs is None:
                    self.fm_top = (time.time() - 480, None)   # try again in two minutes
                if self.win and self.win.music_view == "top" and not self.win.selecting:
                    self.win.refresh_music()
            in_thread(self.lastfm_top_songs, done=done)
        return [dict(t) for t in songs] if songs is not None else self.plays.top()

    def lastfm_top_songs(self, n=200):
        """(blocking) Your n most scrobbled songs: as you have them here when you do (saved, in your
        folders, played), else to be found on Tidal or YouTube Music when you play them."""
        mine = {}
        for t in [e["track"] for e in self.plays.items.values()] + self.my_songs():
            mine[song_key(t)] = t   # yours on disk win over ones only played
        return [dict(self.fm_song(name, artist, img, mine), plays=plays) for name, artist, plays, img in self.lastfm.top("track", n)]

    @staticmethod
    def fm_song(name, artist, img, mine):
        """A song Last.fm named: yours (mine: song key -> song) when you have it, else one to be
        found on Tidal or YouTube Music when it plays."""
        t = mine.get(song_key({"title": name, "artist": artist}))
        if t is not None:
            return dict(t)
        return {"id": "lfm-" + hashlib.sha1(f"{norm(artist)}|{norm(name)}".encode()).hexdigest()[:16], "source": "lastfm",
                "title": name, "artist": artist, "thumb": img if img and LASTFM_BLANK not in img else ""}

    # ---- the DJ ----
    def dj_source(self, src):
        """What the DJ plays from, as dj["from"] keeps it: (name, songs), or None if it's gone.
        {"kind": "playlist", "id"}, {"kind": "folder", "path"}, {"kind": "mine"} (all your songs),
        or {"kind": "songs", "name", "songs"} (an album, a service's playlist, the phone's)."""
        kind = (src or {}).get("kind")
        if kind == "playlist":
            pl = self.lists.get(src.get("id"))
            return (pl["name"], [dict(t) for t in pl["tracks"]]) if pl else None
        if kind == "folder":
            root = str(Path(src.get("path") or "").expanduser()).rstrip("/\\")
            inside = [t for t in self.my_songs() if str(t.get("file") or "").startswith(root + os.sep)]
            return Path(root).name or root, inside
        if kind == "mine":
            return "your music", self.my_songs()
        if kind == "songs":
            return src.get("name") or "these songs", [dict(t) for t in src.get("songs") or []]
        return None

    def dj_ready(self):
        """The DJ playing from what dj["from"] says (after a restart, say)."""
        src = self.dj.get("from")
        if src and not self.djs.scope:
            got = self.dj_source(src)
            if got and got[1]:
                self.djs.play_from(*got)

    def dj_start(self, src="keep"):
        """Start the DJ: a first set of what you've had on repeat (or whatever it can make). src: what
        it plays from (see dj_source), {"kind": "all"} for everything, "keep" for what it played from."""
        if self.dj_busy:
            return
        if src == "keep":
            src = self.dj.get("from")
        if src and src.get("kind") != "all":
            got = self.dj_source(src)
            if not got or not got[1]:
                self.toast(f"No songs of yours in {got[0]}: add the folder under Folders in the accounts menu (☰) first"
                           if src.get("kind") == "folder" and got else
                           f"There are no songs in {got[0] if got else 'that'} for the DJ to play")
                return
            self.djs.play_from(*got)
        else:
            src = None
            self.djs.play_from(None, None)
        self.dj_busy = f"Picking your first set from {self.djs.scope[0]}…" if self.djs.scope else "Picking your first set…"
        self.dj_changed()

        def done(res, err):
            self.dj_busy = None
            if not res:
                self.toast("The DJ couldn't find songs yet. Play a few, or connect Last.fm." if not err
                           else f"The DJ couldn't start: {str(err)[:100]}")
                self.dj_changed()
                return
            kind, songs, line = res
            self.dj = {"on": False, "sets": {}, "shown": None, "from": src}
            self.dj_tag(kind, songs, line)   # before play_from, which copies them
            self.play_from(songs, 0, radio=False)
            self.dj["on"] = True
            self.dj_announce(self.current_track())
        in_thread(lambda: self.djs.build(first=True), done=done)

    def dj_stop(self):
        self.dj["on"] = False
        self.save_state()
        self.dj_changed()

    def dj_tag(self, kind, songs, line):
        """Mark songs as set n of the DJ's (n: the next number), with its line."""
        n = max([int(k) for k in self.dj["sets"]] + [0]) + 1
        self.dj["sets"][str(n)] = {"kind": kind, "line": line}
        if len(self.dj["sets"]) > 30:
            del self.dj["sets"][min(self.dj["sets"], key=int)]
        for t in songs:
            t["dj"] = n
            self.djs.used.add(song_key(t))
        return n

    def dj_announce(self, t):
        """A set begins: its line, where you see it."""
        n = str((t or {}).get("dj", ""))
        if not self.dj["on"] or n not in self.dj["sets"] or n == self.dj.get("shown"):
            return
        self.dj["shown"] = n
        self.toast("DJ · " + self.dj["sets"][n]["line"])
        self.dj_changed()

    def dj_more(self):
        """Near the end of the queue: the DJ's next set after it."""
        if self.dj_busy:
            return
        self.dj_ready()
        self.dj_busy = "Picking the next set…"
        context = self.context

        def done(res, _err):
            self.dj_busy = None
            if res and context == self.context and self.dj["on"]:
                kind, songs, line = res
                self.dj_tag(kind, songs, line)
                self.queue.extend(songs)
                self.after_queue_change()
            self.dj_changed()
        in_thread(lambda: self.djs.build(avoid=self.dj_kind()), done=done)

    def dj_kind(self):
        n = str((self.current_track() or {}).get("dj", ""))
        return (self.dj["sets"].get(n) or {}).get("kind")

    def dj_switch(self, ask=None):
        """Switch it up (or play what you asked for): a new set now, in place of the rest of this one."""
        if self.dj_busy:
            return
        if not self.dj["on"] and not ask:
            self.dj_start()
            return
        self.dj_ready()
        self.dj_busy = f"Looking for {ask.strip()}…" if ask else "Switching it up…"
        self.dj_changed()

        def done(res, err):
            self.dj_busy = None
            if not res:
                self.toast(f"The DJ found nothing for “{ask.strip()}”. Try a mood, a decade, a genre or an artist." if ask
                           else "The DJ has nothing else right now" + (f": {str(err)[:80]}" if err else "."))
                self.dj_changed()
                return
            kind, songs, line = res
            if not self.dj["on"]:
                self.dj = {"on": True, "sets": {}, "shown": None, "from": self.dj.get("from")}
            self.dj_tag(kind, songs, line)
            queued = [t for t in self.queue[self.index + 1:] if t.get("queued")]
            keep = self.queue[:self.index + 1] if self.current_track() else []
            self.queue = keep + queued + songs
            self.index = len(keep) + len(queued)
            self.radio_from = None
            self.context += 1
            self.load_current()
            self.dj["on"] = True
        in_thread(lambda: self.djs.ask(ask) if ask else self.djs.build(avoid=self.dj_kind()), done=done)

    def dj_changed(self):
        if self.win and self.win.music_view == "dj":
            self.win.refresh_music()

    # ---- importing an .m3u8 playlist ----
    def import_m3u(self, path, progress=lambda i, n: None):
        """(blocking) The songs of the .m3u/.m3u8 playlist at path: (name, songs, names not found).
        Each is a file of yours (where the playlist says, else the same file name in your folders),
        else the same song in your music, else the best match on Tidal (YouTube Music without it)."""
        path = Path(path)
        entries = read_m3u(path)
        mine = self.my_songs()
        by_file = {str(Path(t["file"]).resolve()): t for t in mine if t.get("file")}
        tails = {}
        for t in mine:
            if t.get("file"):
                parts = [x.lower() for x in Path(t["file"]).parts]
                tails.setdefault(tuple(parts[-2:]), t)
                tails.setdefault(tuple(parts[-1:]), t)
        by_key = {song_key(t): t for t in mine}
        tidal = self.sources.get("tidal")
        src = tidal if tidal and tidal.signed_in else self.wait_source("ytm")
        out, missed = [], []
        for i, (loc, artist, title, secs) in enumerate(entries):
            progress(i, len(entries))
            t = None
            if re.match(r"https?://", loc):
                try:
                    t = (self.resolve_query(loc) or [None])[0] if link_source(loc) else None
                except Exception:  # noqa: BLE001 -- by its name, then
                    t = None
            else:
                where = urllib.parse.unquote(loc[7:]) if loc.startswith("file://") else loc
                where = where.replace("\\", "/")
                f = Path(where) if where.startswith("/") else path.parent / where
                if not re.match(r"[A-Za-z]:/", where) and f.suffix.lower() in AUDIO_EXT and f.is_file():
                    t = by_file.get(str(f.resolve())) or track_from_file(f)
                if t is None:
                    parts = [x.lower() for x in where.split("/") if x]
                    t = tails.get(tuple(parts[-2:])) or tails.get(tuple(parts[-1:]))
                if not title:   # no #EXTINF: the file's name, as "Artist - Title" or "01 Title"
                    stem = re.sub(r"^\d{1,3}[\s.\-_]+", "", Path(where).stem)
                    artist, dash, title = stem.partition(" - ")
                    artist, title = (artist, title) if dash else ("", stem)
            if t is None and title:
                t = by_key.get(song_key({"title": title, "artist": artist}))
            if t is None and title and src:
                try:
                    hits = src.search(f"{artist} {bare_title(title)}".strip())[:8]
                except Exception:  # noqa: BLE001 -- not found, then
                    hits = []
                best, best_score = None, 0.0
                for h in hits:
                    if secs and h.get("duration") and abs(h["duration"] - secs) > 8:
                        continue
                    score = similar(clean_title(title), clean_title(h["title"]))
                    if artist:
                        lead = max((similar(x, y) for x in artist_names([artist]) for y in artist_names(h["artist"].split(","))),
                                   default=0.0)
                        if lead < 0.6:
                            continue
                        score = 0.6 * score + 0.4 * lead
                    if score >= 0.7 and score > best_score:
                        best, best_score = h, score
                t = best
            if t is not None:
                out.append(t)
            else:
                missed.append(f"{artist} - {title}" if artist else title or loc)
        progress(len(entries), len(entries))
        return path.stem, out, missed

    def songs_by(self, name):
        """Your songs by the artist called name: downloaded, in your folders or playlists, or played."""
        want, seen, out = norm(name), set(), []
        pool = self.my_songs() + [t for pl in self.lists.items for t in pl["tracks"]] + self.plays.recent(2000)
        for t in pool:
            if want in {norm(a) for a in split_artists(t.get("artist", ""))} and song_key(t) not in seen:
                seen.add(song_key(t))
                out.append(dict(t))
        return out

    def artist_info(self, name, prefer=None):
        """(blocking) The artist's page from the first service that knows them: the one the song you
        clicked is from, then the one you browse, then the rest. Top songs come from the next one
        when that service has none to give (Spotify)."""
        info, last = None, None
        names = [name] + ([name.split(" & ")[0]] if " & " in name else [])
        for key in [k for k in dict.fromkeys((prefer, self.source, "ytm", "tidal", "apple", "spotify")) if k in SOURCES]:
            src = self.wait_source(key, 10)
            if not src or (key in ("tidal", "spotify") and not src.signed_in):
                continue
            found = None
            for n in names:
                try:
                    found = src.artist(n)
                except Exception as e:  # noqa: BLE001 -- the next service, then
                    last = e
                if found:
                    break
            if not found:
                continue
            if info is None:
                info = dict(found, source=key, top_source=key)
            elif found["top"]:
                info["top"], info["top_source"] = found["top"], key
            if info["top"]:
                break
        if info is None and last:
            raise last
        return info

    def rescan(self):
        """Read your folders again, in the background."""
        if self.local.scanning:
            return
        self.local.scanning = True

        def done(changed, err):
            self.local.scanning = False
            if err:
                self.toast(f"Couldn't read your folders: {str(err)[:80]}")
            if self.win:
                self.win.refresh_accounts()
                if changed:
                    self.win.refresh_music()
        in_thread(self.local.scan, list(self.folders), done=done)

    def rescan_soon(self):
        """When the Music tab opens: your folders again, at most every couple of minutes."""
        if time.time() - self.local.scanned > 120:
            self.rescan()

    def add_folder(self, path):
        path = str(Path(path).expanduser().resolve())
        if any(path == f or path.startswith(f.rstrip("/") + "/") for f in self.folders):
            self.toast(f"{short_path(path)} is in your folders already")
            return
        self.folders = [f for f in self.folders if not f.startswith(path.rstrip("/") + "/")] + [path]
        self.save_state()
        self.toast(f"Reading {short_path(path)}…")
        self.rescan()

    def remove_folder(self, path):
        self.folders = [f for f in self.folders if f != path]
        self.save_state()
        self.rescan()

    # ---- your playlists ----
    def import_playlist(self, path):
        """Make a playlist of the .m3u8 at path, named after the file; say what wasn't found."""
        self.toast(f"Importing {Path(path).name}…")
        last = [0.0]

        def progress(i, n):
            if n > 20 and time.monotonic() - last[0] > 4 and i < n:
                last[0] = time.monotonic()
                GLib.idle_add(lambda: (self.toast(f"Importing · {i} of {n}"), False)[1])

        def done(res, err):
            if err:
                self.toast(f"Couldn't import it: {str(err)[:100]}")
                return
            name, tracks, missed = res
            if not tracks:
                self.toast(f"None of the {len(missed)} songs in {Path(path).name} were found")
                return
            pid = self.new_playlist(name)
            self.lists.add(pid, tracks)
            self.playlists_changed()
            self.toast(f"Imported {len(tracks)} song{'s' if len(tracks) != 1 else ''} into “{name}”"
                       + (f" · {len(missed)} not found" if missed else ""))
            if missed:
                print(f"{Path(path).name}: not found: " + "; ".join(missed[:50]), file=sys.stderr)
        in_thread(self.import_m3u, path, progress, done=done)

    def new_playlist(self, name, show=True):
        pid = self.lists.create(name)["id"]
        self.toast(f"Made “{name}”")
        if show and self.win:
            self.win.show_mine(pid)
        else:
            self.playlists_changed()
        return pid

    def add_to_playlist(self, pid, tracks):
        pl = self.lists.get(pid)
        if not pl or not tracks:
            return
        n = self.lists.add(pid, tracks)
        name = pl["name"]
        if not n:
            self.toast(f"Already in “{name}”")
        elif len(tracks) == 1:
            self.toast(f"Added to “{name}”")
        else:
            self.toast(f"{n} songs added to “{name}”" + (f" ({len(tracks) - n} were in it)" if n < len(tracks) else ""))
        self.playlists_changed()

    def remove_from_playlist(self, pid, ids):
        self.lists.remove(pid, ids)
        self.playlists_changed()

    def rename_playlist(self, pid, name):
        self.lists.rename(pid, name)
        self.playlists_changed()

    def delete_playlist(self, pid):
        pl = self.lists.get(pid)
        self.lists.delete(pid)
        if self.win and self.win.open_mine == pid:
            self.win.open_mine = None
        if pl:
            self.toast(f"Deleted “{pl['name']}”")
