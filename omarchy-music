    # ---- artist and album pages ----
    def pick_artist(self, widget, text):
        """A click on artists' names: their page, or a choice of them first."""
        names = split_artists(text)
        if len(names) == 1:
            self.open_artist(names[0])
            return
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
