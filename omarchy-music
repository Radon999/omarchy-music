def youtube_audio(track, ytm=None):
    """(address, "Opus 129 kbps") of the song's audio on YouTube Music, for when Tidal
    has no FLAC of it, or None. A song from another service is found by a search.
    It blocks for a few seconds: YouTube's address only answers a moment after it's made."""
    import requests
    import yt_dlp
    vid = track["id"] if source_of(track) == "ytm" else None
    if not vid:
        if ytm is None:
            from ytmusicapi import YTMusic
            ytm = YTMusic()
        artist = track["artist"].split(",")[0].strip()
        best, best_score = None, 0.0
        for hit in ytm.search(f"{artist} {bare_title(track['title'])}", filter="songs", limit=10):
            t = track_from_ytm(hit)
            if not t:
                continue
            if track.get("duration") and t.get("duration") and abs(t["duration"] - track["duration"]) > 6:
                continue
            title = similar(clean_title(track["title"]), clean_title(t["title"]))
            lead = max((similar(x, y) for x in artist_names([artist]) for y in artist_names(t["artist"].split(","))),
                       default=0.0)
            if title >= 0.75 and lead >= 0.8 and 0.6 * title + 0.4 * lead > best_score:
                best, best_score = t, 0.6 * title + 0.4 * lead
        if not best:
            return None
        vid = best["id"]
    with yt_dlp.YoutubeDL({"format": "bestaudio", "quiet": True, "no_warnings": True, "noplaylist": True,
                           "logger": _QuietLogger()}) as y:
        info = y.extract_info(f"https://music.youtube.com/watch?v={vid}", download=False)
    url = info["url"]
    for _ in range(20):
        try:
            with requests.get(url, headers={"Range": "bytes=0-1"}, timeout=10) as r:
                if r.status_code in (200, 206):
                    break
        except requests.RequestException:
            pass
        time.sleep(0.5)
    else:
        raise RuntimeError("YouTube wouldn't send the audio")
    codec = {"opus": "Opus", "mp4a.40.2": "AAC", "mp4a.40.5": "AAC"}.get(info.get("acodec") or "", info.get("acodec") or "")
    return url, f"{codec} {round(info.get('abr') or 0)} kbps".strip()


def clean_title(s):
    """A title without what YouTube adds: (Official Video), feat. credits,
    remaster notes, punctuation."""
    s = s.lower()
    s = re.sub(r"[(\[][^)\]]*\b(official|video|audio|lyrics?|visuali[sz]er|hd|4k|mv|remaster(ed)?|feat|ft|with"
               r"|original|album version|explicit|clean|single version)\b[^)\]]*[)\]]", " ", s)
    s = re.sub(r"\s[-–]\s[^-–]*\b(official|video|audio|lyrics?|remaster(ed)?)\b.*$", " ", s)
    s = re.sub(r"\b(feat|ft)\b\.?\s.*$", " ", s)
    return " ".join(re.sub(r"[^\w\s]", " ", s).split())


def bare_title(s):
    """Just the song's name: no brackets, nothing after " - "."""
    return clean_title(re.sub(r"[(\[][^)\]]*[)\]]|\s[-–]\s.*$", " ", s))


def featured(title):
    """Artists credited in a title: "Song (feat. A & B)" -> {a, b}."""
    m = re.search(r"\b(?:feat|ft|with)\b\.?\s*([^)\]]+)", title, re.I)
    return artist_names([m.group(1)]) if m else set()


def artist_names(names):
    """Each artist in names, lowercased; splits "A, B & C" and drops "- Topic"."""
    out = set()
    for n in names:
        n = re.sub(r"\s*-\s*topic$|vevo$", "", n.lower().strip())
        for part in re.split(r",|&|\bx\b|\band\b|\bfeat\b\.?|\bft\b\.?", n):
            part = " ".join(re.sub(r"[^\w\s]", " ", part).split())
            if part:
                out.add(part)
    return out


def similar(a, b):
    return difflib.SequenceMatcher(None, a, b).ratio()


def best_named(items, name, get):
    """The item whose name (get(item)) is name, or near enough; None if none is."""
    scored = sorted(items, key=lambda x: -similar(norm(get(x)), norm(name)))
    return scored[0] if scored and similar(norm(get(scored[0])), norm(name)) >= 0.8 else None


