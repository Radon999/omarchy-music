            if a.tidal_link:
                paste = Gtk.Entry(placeholder_text="The “Oops” page address, then Enter", hexpand=True)
                paste.connect("activate", lambda e: e.get_text().strip() and a.finish_tidal_login(e.get_text()))
                across(paste)
        else:
            line("Tidal", f"Not available: {str(a.tidal_error)[:60]}" if a.tidal_error else "Connecting…")
        sp = a.sources.get("spotify")
        if sp and sp.signed_in:
            line("Spotify", f"Connected as {sp.user}" if sp.user else "Connected", True, sync_switch("spotify"),
                 pill("Disconnect", a.spotify_disconnect, quiet=True))
        elif a.spotify_connecting:
