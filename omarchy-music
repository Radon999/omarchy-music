def read_m3u(path):
    """The songs of an .m3u or .m3u8 playlist, in order: [(location as written, artist, title, seconds)],
    the names from its #EXTINF lines (empty where it has none)."""
    raw = Path(path).read_bytes()
    try:
        text = raw.decode("utf-8-sig")
    except UnicodeDecodeError:
        text = raw.decode("latin-1")   # an old .m3u
    out, info = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("#EXTINF:"):
            head, _, name = line[8:].partition(",")
            m = re.match(r"-?\d+(\.\d+)?", head.strip())
            artist, dash, title = name.partition(" - ")
            info = ((artist.strip(), title.strip()) if dash else ("", name.strip())) + (max(0, int(float(m.group()))) if m else 0,)
        elif line and not line.startswith("#"):
            out.append((line, *(info or ("", "", 0))))
            info = None
    return out


def local_matches(songs, q):
    """Songs, artists and albums of yours whose names have every word of q in them."""
    words = norm(q).split()
    if not words:
        return [], [], []

    def has(text):
        t = norm(text)
        return all(w in t for w in words)
    hits = [t for t in songs if has(f"{t.get('title', '')} {t.get('artist', '')} {t.get('album', '')}")]
    artists, albums = {}, {}
    for t in songs:
        for name in split_artists(t.get("artist") or ""):
            if has(name):
                artists.setdefault(norm(name), name)
        if t.get("album") and has(f"{t['album']} {t.get('artist', '')}"):
            lead = (t.get("artist") or "").split(",")[0].strip()
            albums.setdefault((norm(t["album"]), norm(lead)), {"title": t["album"], "artist": lead, "tracks": []})["tracks"].append(t)
    return hits, sorted(artists.values(), key=norm)[:8], list(albums.values())[:12]


def album_entry(aid, title, sub, thumb):
    """An album on an artist's page: the service's id for it, its name, a year or "Single"."""
    return {"id": str(aid), "title": title or "Album", "sub": sub or "", "thumb": thumb or "", "count": ""}


def has_word(text, word):
    return re.search(rf"\b{word}\b", text) is not None


def fetch_bytes(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return r.read()


def write_file(dest, data):
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(".part")
    tmp.write_bytes(data)
    os.replace(tmp, dest)


def fetch_url(url, dest):
    write_file(dest, fetch_bytes(url))


class Tidal:
    """Your Tidal account: finds each song and downloads it in FLAC.

    Tidal streams lossless only to the browser ("PKCE") login: you sign in on
    Tidal's page and paste back the address of the "Oops" page it ends on.
    """

    def __init__(self):
        import tidalapi
        self.td = tidalapi
        self.session = tidalapi.Session(tidalapi.Config(quality=TIDAL_QUALITY))
        self.lock = threading.Lock()   # one API call at a time; file downloads run in parallel
        self.connected = False
        if TIDAL_SESSION.exists():
            try:
                self.connected = (bool(self.session.load_session_from_file(TIDAL_SESSION))
                                  and self.session.check_login() and self.session.is_pkce)
            except Exception:  # noqa: BLE001 -- expired or broken login: connect again
                self.connected = False
            if self.connected:
                self._save()   # keep the refreshed token

    def _save(self):
        TIDAL_SESSION.parent.mkdir(parents=True, exist_ok=True)
        TIDAL_SESSION.touch(mode=0o600, exist_ok=True)
        self.session.save_session_to_file(TIDAL_SESSION)
        TIDAL_SESSION.chmod(0o600)

    def login_url(self):
        """Logging in, step 1: the page to sign in to Tidal on."""
        return self.session.pkce_login_url()

    def finish_login(self, oops_url):
        """Step 2: the address of the "Oops" page Tidal ends on after signing in."""
        token = self.session.pkce_get_auth_token(oops_url.strip())
        self.session.process_auth_token(token, is_pkce_token=True)
        self._save()
        self.connected = True

    @staticmethod
    def lossless(c):
        return bool(c and c.available and (c.audio_quality in LOSSLESS or "LOSSLESS" in (c.media_metadata_tags or [])))

    def resolve(self, track, lossy=False):
        """The Tidal track that is this song, in lossless (or in any quality: lossy), or
        None: Tidal's own song, else the recording with the song's ISRC, else a search."""
        ok = (lambda c: bool(c and c.available)) if lossy else self.lossless
        if track.get("tidal"):
            with self.lock:
                c = self.session.track(int(track["tidal"]))
            if ok(c):
                return c
        if track.get("isrc"):
            try:
                with self.lock:
                    found = [c for c in self.session.get_tracks_by_isrc(track["isrc"]) if ok(c)]
            except Exception:  # noqa: BLE001 -- the ISRC isn't on Tidal: search instead
                found = []
            if found:
                # One recording is often on the single and the album: take the
                # release the service listed, and hi-res where there is a choice.
                album = norm(track.get("album"))
                found.sort(key=lambda c: (norm(getattr(c.album, "name", "")) != album,
                                          "HIRES_LOSSLESS" not in (c.media_metadata_tags or [])))
                return found[0]
        return self.match(track, lossy)

    # ---- as a library: your favourites and playlists, search and radio ----
    key, name = "tidal", "Tidal"
    hint = "Connect Tidal in the accounts menu (top right)\nto see your favourites and playlists."

    @property
    def signed_in(self):
        return self.connected

    def _paged(self, fetch, page):
        out = []
        while len(out) < 10000:
            with self.lock:
                items = fetch(limit=page, offset=len(out))
            out += items
            if len(items) < page:
                break
        return out

    def search(self, q):
        m = re.search(r"tidal\.com/(?:browse/)?(track|playlist|album|mix)/([\w-]+)", q)
        if not m:
            with self.lock:
                found = self.session.search(q, models=[self.td.Track], limit=30)["tracks"]
            return [track_from_tidal(c) for c in found if c.available]
        kind, ident = m.groups()
        if kind == "playlist":
            return self.playlist(ident)
        with self.lock:
            if kind == "track":
                found = [self.session.track(int(ident))]
            elif kind == "album":
                found = self.session.album(int(ident)).tracks()
            else:
                found = [i for i in self.session.mix(ident).items() if isinstance(i, self.td.Track)]
        return [track_from_tidal(c) for c in found if c.available]

    def find(self, q):
        """Songs, artists and albums called q, or with q in their names."""
        with self.lock:
            r = self.session.search(q, models=[self.td.Track, self.td.Artist, self.td.Album], limit=30)

        def pic(x):
            try:
                return x.image(320)
            except Exception:  # noqa: BLE001 -- no picture
                return ""
        artists = [{"name": a.name, "thumb": pic(a)} for a in (r.get("artists") or [])[:6] if a.name]
        albums = [album_entry(al.id, al.name, " · ".join(x for x in (getattr(al.artist, "name", ""), str(al.year or "")) if x),
                              pic(al) if al.cover else "") for al in (r.get("albums") or [])[:10]]
        return {"songs": [track_from_tidal(c) for c in r.get("tracks") or [] if c.available], "artists": artists, "albums": albums}

    def mix_for(self, q):
        """The songs of the playlist Tidal has for q ("chill", "2010s hits"), or []."""
        with self.lock:
            lists = (self.session.search(q, models=[self.td.Playlist], limit=5).get("playlists") or [])
        for pl in lists[:3]:
            with self.lock:
                found = [track_from_tidal(c) for c in pl.tracks(limit=80) if c.available]
            if len(found) >= 8:
                return found
        return []

    def radio(self, track):
        c = None if source_of(track) == "tidal" else self.resolve(track)
        with self.lock:
            c = c or self.session.track(int(track["tidal"]))
            found = c.get_track_radio(limit=40)
        return [track_from_tidal(x) for x in found if x.available]

    def my_playlists(self):
        with self.lock:
            lists = self.session.user.playlists() + self.session.user.favorites.playlists()
        out, seen = [{"id": "favorites", "title": "Favorite tracks", "count": "", "thumb": ""}], set()
        for p in lists:
            if p.id in seen:
                continue
            seen.add(p.id)
            try:
                thumb = p.image(320) if (p.square_picture or p.picture) else ""
            except Exception:  # noqa: BLE001 -- a playlist without a picture
                thumb = ""
            out.append({"id": p.id, "title": p.name or "Playlist", "thumb": thumb,
                        "count": p.num_tracks if p.num_tracks >= 0 else ""})
        return out

    def playlist(self, pid):
        if pid == "favorites":
            found = self._paged(self.session.user.favorites.tracks, 50)
        else:
            with self.lock:
                pl = self.session.playlist(pid)
            found = self._paged(pl.tracks, 100)
        return [track_from_tidal(c) for c in found if c.available]

    def liked_ids(self):
        return {f"td{c.id}" for c in self._paged(self.session.user.favorites.tracks, 50)}

    def rate(self, track, like):
        with self.lock:
            fav = self.session.user.favorites
            (fav.add_track if like else fav.remove_track)(str(track["tidal"]))

    def library_tracks(self):
        """Every song in your favourites and playlists, each once."""
        seen, out = set(), []
        for pl in self.my_playlists():
            try:
                tracks = self.playlist(pl["id"])
            except Exception:  # noqa: BLE001 -- skip a playlist that won't load
                continue
            for t in tracks:
                if t["id"] not in seen:
                    seen.add(t["id"])
                    out.append(t)
        return out

    def artist(self, name):
        with self.lock:
            found = self.session.search(name, models=[self.td.Artist], limit=5)["artists"]
        a = best_named(found, name, lambda x: x.name or "")
        if not a:
            return None
        with self.lock:
            top = a.get_top_tracks(limit=20)
            albums = a.get_albums(limit=50) + a.get_ep_singles(limit=50)
        try:
            thumb = a.image(320)
        except Exception:  # noqa: BLE001 -- no picture
            thumb = ""
        out, seen = [], set()
        for al in albums:   # Tidal lists the same album twice (explicit and clean, say): once is enough
            key = (norm(al.name), al.year)
            if key in seen:
                continue
            seen.add(key)
            try:
                cover = al.image(320) if al.cover else ""
            except Exception:  # noqa: BLE001
                cover = ""
            out.append(album_entry(al.id, al.name, str(al.year or ""), cover))
        return {"name": a.name, "thumb": thumb, "top": [track_from_tidal(c) for c in top if c.available], "albums": out}

    def album(self, aid):
        with self.lock:
            found = self.session.album(int(aid)).tracks()
        return [track_from_tidal(c) for c in found if c.available]

    def lyrics(self, tidal_id):
        """(timed lines as LRC, plain text): Tidal licenses Musixmatch's."""
        with self.lock:
            ly = self.session.track(int(tidal_id)).lyrics()
        return ly.subtitles or None, ly.text or None

    def match(self, track, lossy=False):
        """The Tidal track that is this song, available in lossless (any quality: lossy), or None."""
        # (artists, title) readings of the song: as YouTube has it, and for
        # uploads titled "Artist - Song", the way the title has it.
        readings = [(track["artist"].split(","), track["title"])]
        m = re.match(r"(.+?)\s[-–]\s(.+)", track["title"])
        if m:
            readings.append((re.split(r",|&|\bx\b", m.group(1)), m.group(2)))
        queries = []
        for artists, title in readings:
            for q in (f"{artists[0].strip()} {clean_title(title)}", f"{artists[0].strip()} {bare_title(title)}"):
                if q not in queries:
                    queries.append(q)
        queries.append(clean_title(track["title"]))
        best, best_score, seen = None, 0.0, set()
        for query in queries:
            with self.lock:
                found = self.session.search(query, models=[self.td.Track], limit=20)["tracks"]
            for c in found:
                if c.id not in seen:
                    seen.add(c.id)
                    score = max(self._score(track, artists, title, c, lossy) for artists, title in readings)
                    if score > best_score:
                        best, best_score = c, score
            if best_score >= 0.9:
                break
        return best

    @staticmethod
    def _score(track, artists, title, c, lossy=False):
        """How sure we are that c is the song, 0 (it isn't) .. ~1."""
        if not c.available or not (lossy or c.audio_quality in LOSSLESS or "LOSSLESS" in (c.media_metadata_tags or [])):
            return 0.0
        dur = track.get("duration") or 0
        if dur and abs((c.duration or 0) - dur) > 6:
            return 0.0
        name = f"{c.name} ({c.version})" if c.version else c.name
        album = getattr(c.album, "name", "") or ""
        if any(has_word(f"{title} {track.get('album') or ''}".lower(), w) != has_word(f"{name} {album}".lower(), w)
               for w in VERSION_WORDS):
            return 0.0
        t = similar(clean_title(title), clean_title(name))
        theirs = artist_names(a.name for a in c.artists or []) | featured(name)

        def found(artist):
            return max((similar(artist, y) for y in theirs), default=0.0)
        lead = max((found(x) for x in artist_names(artists[:1])), default=0.0)
        if t < 0.75 or lead < 0.8:
            return 0.0
        ours = artist_names(artists) | featured(title)
        credits = sum(found(x) for x in ours) / len(ours)    # prefers the version with the featured artists
        closeness = 1 - abs(c.duration - dur) / 6 if dur else 0.5
        same_album = 0.05 if track.get("album") and similar(track["album"].lower(), album.lower()) > 0.8 else 0.0
        return 0.55 * t + 0.2 * lead + 0.1 * credits + 0.15 * closeness + same_album

    def stream(self, c, lossy=False):
        """Tidal track c as something mpv plays straight from Tidal, nothing saved:
        (address, "24-bit/96 kHz"). CD quality comes as one FLAC file; hi-res as
        FLAC in MP4 segments, listed by a DASH manifest that goes to mpv inline
        (ffmpeg won't let a manifest on disk point at the web). lossy: AAC will do
        when Tidal has no FLAC of it ("AAC 320 kbps")."""
        with self.lock:
            st = c.get_stream()
            manifest = st.get_stream_manifest()
        flac = st.audio_quality in LOSSLESS and "FLAC" in str(manifest.get_codecs()).upper()
        if not flac and not lossy:
            raise NoLosslessMatch("Tidal only has it lossy")
        if manifest.is_encrypted:
            raise RuntimeError("Tidal sent an encrypted stream")
        if not flac:
            quality = LOSSY.get(st.audio_quality, "lossy")
            if manifest.is_mpd:
                return f"data://application/dash+xml;base64,{base64.b64encode(st.get_manifest_data().encode()).decode()}", quality
            return manifest.get_urls()[0], quality
        rate = (manifest.sample_rate if manifest.is_mpd else st.sample_rate) or 44100
        bits = st.bit_depth or 16
        if bits == 16 and rate > 48000:
            bits = 24   # Tidal leaves the depth out of hi-res answers; hi-res is 24-bit
        quality = f"{bits}-bit/{rate / 1000:g} kHz"
        if manifest.is_mpd:
            data = base64.b64encode(st.get_manifest_data().encode()).decode()
            return f"data://application/dash+xml;base64,{data}", quality
        return manifest.get_urls()[0], quality

    def download(self, c, dest, cover, track):
        """Save Tidal track c at dest as tagged FLAC; returns (bits, sample rate)."""
        import requests
        with self.lock:
            stream = c.get_stream()
            manifest = stream.get_stream_manifest()
        if stream.audio_quality not in LOSSLESS or "FLAC" not in str(manifest.get_codecs()).upper():
            raise NoLosslessMatch("Tidal only has it lossy")
        if manifest.is_encrypted:
            raise RuntimeError("Tidal sent an encrypted stream")
        part = dest.with_suffix(".part")
        with open(part, "wb") as f:
            for url in manifest.get_urls():
                with requests.get(url, stream=True, timeout=30) as r:
                    r.raise_for_status()
                    for chunk in r.iter_content(1 << 16):
                        f.write(chunk)
        if manifest.is_mpd:
            # FLAC in MP4 segments: take the FLAC out, untouched.
            flac = dest.with_suffix(".remux.flac")
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(part), "-map", "0:a", "-c:a", "copy",
                            str(flac)], check=True, capture_output=True, timeout=300, **NO_WINDOW)
            part.unlink()
            part = flac
        info = tag_flac(part, c, cover, track)
        os.replace(part, dest)
        return info


def track_from_tidal(c):
    album = c.album
    try:
        thumb = album.image(320) if album and album.cover else ""
    except Exception:  # noqa: BLE001 -- no cover
        thumb = ""
    return {"id": f"td{c.id}", "source": "tidal", "tidal": c.id, "isrc": c.isrc,
            "title": f"{c.name} ({c.version})" if c.version else c.name,
            "artist": ", ".join(a.name for a in c.artists or []) or "Unknown artist",
            "album": getattr(album, "name", "") or "", "duration": c.duration or 0, "thumb": thumb}


def tag_flac(path, c, cover, track):
    """Title, artists, album, numbers and cover from Tidal; returns (bits, sample rate).
    The auto-tagger adds the rest later."""
    from mutagen.flac import FLAC, Picture
    f = FLAC(path)
    f.clear()
    album = c.album
    src = source_of(track)
    tags = {
        "title": f"{c.name} ({c.version})" if c.version else c.name,
        "artist": [a.name for a in c.artists or []],
        "album": getattr(album, "name", None),
        "albumartist": getattr(getattr(album, "artist", None), "name", None),
        "tracknumber": str(c.track_num) if c.track_num else None,
        "discnumber": str(c.volume_num) if c.volume_num else None,
        "date": str(getattr(album, "release_date", None) or c.tidal_release_date or "")[:10] or None,
        "isrc": c.isrc, "copyright": c.copyright, "tidal_id": str(c.id),
        "youtube_music_id": track["id"] if src == "ytm" else None,
        "apple_music_id": track.get("apple") if src == "apple" else None,
        "spotify_id": track.get("spotify") if src == "spotify" else None,
    }
    for key, value in tags.items():
        if value:
            f[key] = value
    if cover:
        pic = Picture()
        pic.type, pic.mime, pic.data = 3, "image/jpeg", cover   # 3: front cover
        f.add_picture(pic)
    f.save()
    return f.info.bits_per_sample, f.info.sample_rate


class Downloader:
    def __init__(self, library):
        self.lib = library
        self.tidal = None          # a Tidal once it is set up
        self.ytm = None            # ytmusicapi, to find songs on YouTube Music when Tidal has no FLAC
        self.active = {}           # vid -> [callbacks]
        self.streams = {}          # vid -> (address, quality, when, lossy from): streams looked up
        self.lock = threading.Lock()
        self.on_saved = None       # on_saved(vid) after each new FLAC: the tagger takes it from there

    def fetch(self, track, done):
        """Make sure track is on disk; done(path or None, error) on the UI thread."""
        vid = track["id"]
        if source_of(track) == "file":
            if is_phone_song(track):   # streams from the phone that sent it
                done(track["file"], None)
                return
            done(track["file"], None if Path(track["file"]).exists() else FileNotFoundError(track["file"]))
            return
        if self.lib.has(vid):
            done(self.lib.file(vid), None)
            return
        with self.lock:
            if vid in self.active:
                self.active[vid].append(done)
                return
            self.active[vid] = [done]
        in_thread(self._download, track, done=lambda res, err: self._finish(vid, res, err))

    def busy(self, vid):
        return vid in self.active

    STREAM_FOR = 15 * 60   # seconds a looked-up stream address is trusted for

    def stream(self, track, done):
        """Play track without saving it: done(address, error) on the UI thread, the
        address being a file when the song is on disk, else Tidal's stream."""
        vid = track["id"]
        if source_of(track) == "file" or self.lib.has(vid):
            self.fetch(track, done)
            return
        got = self.streams.get(vid)
        if got and time.time() - got[2] < self.STREAM_FOR:
            done(got[0], None)
            return

        def work():
            # FLAC from Tidal; else Tidal's AAC; else YouTube's own audio (no Tidal: YouTube).
            # Whatever goes wrong on Tidal (not there, not in your country, the login, the
            # network), the next one is tried.
            tidal = self.tidal if self.tidal and self.tidal.connected else None
            trouble = None
            if tidal:
                match = None
                try:
                    match = tidal.resolve(track)
                    if match:
                        same = self.lib.by_tidal(match.id)
                        if same and Path(same["file"]).exists():
                            return same["file"], same.get("quality", ""), None   # saved from another service already
                        return (*tidal.stream(match), None)
                except NoLosslessMatch:
                    pass
                except Exception as e:  # noqa: BLE001 -- Tidal's lossy, then YouTube
                    trouble = e
                if not trouble:
                    self.lib.mark_missing(vid)   # no FLAC to download: syncs leave it alone for a while
                try:
                    lossy = match or tidal.resolve(track, lossy=True)
                    if lossy:
                        return (*tidal.stream(lossy, lossy=True), "Tidal")
                except Exception as e:  # noqa: BLE001 -- YouTube, then
                    trouble = trouble or e
            try:
                got = youtube_audio(track, self.ytm)
            except Exception as e:  # noqa: BLE001
                raise RuntimeError(f"Tidal: {trouble}; YouTube: {e}" if trouble else f"YouTube: {e}") from e
            if not got:
                if trouble:
                    raise RuntimeError(f"not on YouTube Music, and Tidal: {trouble}")
                raise NoLosslessMatch("not on Tidal or YouTube Music" if tidal else
                                      "not on YouTube Music (connect Tidal in the accounts menu for more)")
            return (*got, "YouTube")

        def finish(res, err):
            if err:
                done(None, err)
                return
            self.streams[vid] = (res[0], res[1], time.time(), res[2])
            done(res[0], None)
        in_thread(work, done=finish)

    def forget_stream(self, vid):
        self.streams.pop(vid, None)

    def stream_quality(self, vid):
        got = self.streams.get(vid)
        return got[1] if got else ""

    def stream_lossy(self, vid):
        """Where a lossy stream of vid comes from ("Tidal", "YouTube"), or None for FLAC."""
        got = self.streams.get(vid)
        return got[3] if got else None

    def sync(self, tracks, progress):
        """Save every song in tracks as FLAC, one at a time (blocking). Songs
        Tidal recently didn't have are left alone; progress() runs on the UI
        thread after each song."""
        for track in tracks:
            vid = track["id"]
            if self.lib.is_flac(vid) or self.lib.recently_missing(vid):
                continue
            with self.lock:
                if vid in self.active:
                    continue          # playback is already getting it
                self.active[vid] = []
            path, err = None, None
            try:
                path = self._download(track)
            except Exception as e:  # noqa: BLE001 -- next song; it is tried again next sync
                err = e
            finally:
                self._finish(vid, path or self.lib.file(vid), None if self.lib.has(vid) else err)
            GLib.idle_add(lambda: (progress(), False)[1])

    def _download(self, track):
        vid = track["id"]
        if not (self.tidal and self.tidal.connected):
            raise RuntimeError("connect Tidal in the accounts menu first")
        match = self.tidal.resolve(track)
        if not match:
            self.lib.mark_missing(vid)
            raise NoLosslessMatch("not on Tidal in lossless")
        same = self.lib.by_tidal(match.id)
        if same and same["id"] != vid:
            # Already saved from another service: the same file serves both.
            extra = {k: same[k] for k in ("quality", "tagged", "genre") if k in same}
            self.lib.add(track, same["file"], same.get("art"), "flac", tidal=match.id, **extra)
            self.lib.mark_missing(vid, False)
            return same["file"]
        cover = None
        try:
            cover = fetch_bytes(match.album.image(1280))
        except Exception:  # noqa: BLE001 -- the song without its cover
            pass
        old = self.lib.file(vid)
        path = SONGS / f"{safe_name(vid)}.flac"
        try:
            bits, rate = self.tidal.download(match, path, cover, track)
        except NoLosslessMatch:
            self.lib.mark_missing(vid)
            raise
        art = ART / f"{safe_name(vid)}.jpg"
        try:
            if cover:
                write_file(art, cover)
            elif track.get("thumb"):
                fetch_url(sized_thumb(track["thumb"], 226), art)
            else:
                art = None
        except OSError:
            art = None
        self.lib.add(track, path, art, "flac", quality=f"{bits}-bit/{rate / 1000:g} kHz", tidal=match.id,
                     isrc=match.isrc or track.get("isrc"))
        self.lib.mark_missing(vid, False)
        if old and old != str(path):
            Path(old).unlink(missing_ok=True)    # the lossy copy it replaces
        if self.on_saved:
            self.on_saved(vid)
        return str(path)

    def _finish(self, vid, path, err):
        with self.lock:
            callbacks = self.active.pop(vid, [])
        for cb in callbacks:
            cb(path, err)


class ArtCache:
    """Album art for rows: library art on disk, else a cached thumbnail."""

    def __init__(self, library):
        self.lib = library
        self.textures = {}
        self.paths = {}            # vid -> the picture on disk, once there is one
        self.waiting = {}
        self.none = set()          # songs in your folders with no cover anywhere
        self.on_loaded = None      # on_loaded(vid, path) when a song's picture is ready
        THUMBS.mkdir(parents=True, exist_ok=True)

    def apply(self, picture, track, px=226):
        vid = track["id"]
        if vid in self.textures:
            picture.set_from_paintable(self.textures[vid])
            return
        lib = self.lib.items.get(vid)
        path = Path(lib["art"]) if lib and lib.get("art") else THUMBS / f"{vid}.jpg"
        if path.exists():
            self._load(vid, path, picture)
            return
        if source_of(track) == "file" and not is_phone_song(track):
            fetch, arg = self._cover_of, track.get("file")
            if vid in self.none:
                return
        elif track.get("thumb"):
            fetch, arg = fetch_url, sized_thumb(track["thumb"], px)
        else:
            return
        self.waiting.setdefault(vid, []).append(picture)
        if len(self.waiting[vid]) > 1:
            return

        def done(_r, err):
            pics = self.waiting.pop(vid, [])
            if err:
                if source_of(track) == "file":
                    self.none.add(vid)
                return
            for p in pics:
                self._load(vid, path, p)
        in_thread(fetch, arg, path, done=done)

    @staticmethod
    def _cover_of(audio, dest):
        data = file_cover(audio)
        if not data:
            raise FileNotFoundError("no cover")
        write_file(dest, data)

    def _load(self, vid, path, picture):
        # At the size it is drawn (twice that for sharp HiDPI), not the cover's
        # full 1280 px: a full-size texture per row would take gigabytes.
        tex = load_texture(path, 128)
        if tex:
            self.textures[vid] = tex
            picture.set_from_paintable(tex)
            if vid not in self.paths:
                self.paths[vid] = path
                if self.on_loaded:
                    self.on_loaded(vid, path)


def load_texture(path, size=None):
    """A texture of the image at path, scaled down to fit size x size; None if unreadable."""
    try:
        if not size:
            return Gdk.Texture.new_from_filename(str(path))
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), size, size, True)
        fmt = Gdk.MemoryFormat.R8G8B8A8 if pb.get_has_alpha() else Gdk.MemoryFormat.R8G8B8
        return Gdk.MemoryTexture.new(pb.get_width(), pb.get_height(), fmt, pb.read_pixel_bytes(), pb.get_rowstride())
    except GLib.Error:
        return None


