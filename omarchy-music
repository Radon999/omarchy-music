def write_atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def in_thread(fn, *args, done=None):
    """Run fn(*args) off the UI thread; hand (result, error) to done on it."""
    def work():
        try:
            res, err = fn(*args), None
        except Exception as e:  # noqa: BLE001 -- surfaced to the UI
            res, err = None, e
        if done:
            GLib.idle_add(lambda: (done(res, err), False)[1])
    threading.Thread(target=work, daemon=True).start()


def fmt_time(s):
    s = int(max(0, s or 0))
    return f"{s // 60}:{s % 60:02d}"


def rgba(hex_color, alpha):
    h = hex_color.lstrip("#")
    if len(h) < 6:
        return hex_color
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"rgba({r},{g},{b},{alpha})"


def track_from_ytm(item):
    """Normalise a ytmusicapi song/watch/playlist item into our track dict."""
    vid = item.get("videoId")
    if not vid:
        return None
    artists = ", ".join(a.get("name", "") for a in (item.get("artists") or []) if a.get("name"))
    album = item.get("album") or {}
    thumbs = item.get("thumbnails") or item.get("thumbnail") or []
    if isinstance(thumbs, dict):
        thumbs = thumbs.get("thumbnails", [])
    thumb = thumbs[-1]["url"] if thumbs else ""
    dur = item.get("duration_seconds")
    if dur is None:
        text = item.get("duration") or item.get("length") or ""
        parts = [int(p) for p in text.split(":") if p.isdigit()]
        dur = sum(p * 60 ** i for i, p in enumerate(reversed(parts))) if parts else 0
    return {"id": vid, "title": item.get("title") or "Unknown", "artist": artists or "Unknown artist",
            "album": album.get("name", "") if isinstance(album, dict) else "",
            "duration": dur, "thumb": thumb}


def sized_thumb(url, px):
    # YouTube Music art URLs end in =w120-h120-...; ask for the size we draw.
    return re.sub(r"=w\d+-h\d+", f"=w{px}-h{px}", url) if "googleusercontent" in url else url


