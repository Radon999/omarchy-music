    # ---- tabs & lists ----
    def track_list(self, key):
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, activate_on_single_click=True)
        lst.add_css_class("tracks")
        lst.connect("row-activated", lambda _l, row: self.on_row(key, row))
        setattr(self, f"{key}_list", lst)
        return lst

    def shown(self, tab):
        """Whether tab is what you see now: the window open and that tab in front."""
        return self.get_visible() and self.stack.get_visible_child_name() == tab

    def when_shown(self, tab, rebuild):
        """rebuild now if tab is in view, else once you go to it: rebuilding lists nobody sees,
        on every song and every download, made the window lag (most on Windows)."""
        if self.shown(tab):
            self.stale.pop(tab, None)
            rebuild()
        else:
            self.stale[tab] = rebuild

    def run_stale(self, tab):
        rebuild = self.stale.pop(tab, None)
        if rebuild:
            rebuild()

    def mark_rows(self):
        """What's playing and what's saved, on the rows there are, without rebuilding the lists."""
        cur = (self.app.current_track() or {}).get("id")
        for key in ("search", "account", "music", "artist"):
            for r in self.rows(getattr(self, f"{key}_list", None)):
                (r.add_css_class if r.track["id"] == cur else r.remove_css_class)("playing")
                r.update_mark()

    def song_changed(self):
        """Another song plays: the marks move, and Up next starts from it."""
        self.mark_rows()
        self.refresh_queue()
        self.update_saved()

    def show_tab(self, key):
        if self.selecting:
            self.stop_selecting()
        if not self.tab_buttons[key].get_active():
            self.tab_buttons[key].set_active(True)
        self.stack.set_visible_child_name(key)
        self.run_stale(key)
        if key == "lyrics":
            self.lyrics.show_for(self.app.current_track())
        elif key == "music":
            self.app.rescan_soon()

