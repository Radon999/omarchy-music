            return
        self.scale.set_range(0, max(dur or 1, 1))
        self.scale.set_value(pos or 0)
        self.t_pos.set_label(fmt_time(pos))
        self.t_len.set_label(fmt_time(dur))

    def on_seek(self, _scale, _scroll, value):
        self.dragging_until = time.monotonic() + 0.4
        self.t_pos.set_label(fmt_time(value))
        self.app.player.seek(value)
        return False

    def on_key(self, _ctl, keyval, _code, state):
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        if keyval == Gdk.KEY_Escape:
            if self.selecting:
                self.stop_selecting()
            elif self.stack.get_visible_child_name() == "artist":
                self.artist_back()
            else:
                self.set_visible(False)
            return True
        if ctrl and keyval == Gdk.KEY_a and self.selecting:
            self.select_all()
            return True
        if ctrl and keyval == Gdk.KEY_q:
            self.app.quit_app()
            return True
        if ctrl and keyval in (Gdk.KEY_f, Gdk.KEY_l):
            self.entry.grab_focus()
            return True
        if state & Gdk.ModifierType.ALT_MASK and Gdk.KEY_1 <= keyval <= Gdk.KEY_5:
            self.show_tab(list(self.tab_buttons)[keyval - Gdk.KEY_1])
            return True
        focus = self.get_focus()
        if focus and (focus == self.entry or focus.is_ancestor(self.entry) or isinstance(focus, Gtk.Text)):
            return False
        if keyval in (Gdk.KEY_a, Gdk.KEY_A):   # the focused song: a queues it, Shift+A plays it next
            row = self.focused_track_row()
            if row:
                self.app.enqueue([row.track], "next" if keyval == Gdk.KEY_A else "queue")
                return True
        if keyval == Gdk.KEY_s:
            keys = list(SOURCES)
            self.app.set_source(keys[(keys.index(self.app.source) + 1) % len(keys)])
            return True
        if keyval == Gdk.KEY_w:
            self.app.open_wrapped()
            return True
        if keyval == Gdk.KEY_space:
            self.app.toggle_pause()
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_n):
            self.app.next()
            return True
        if keyval in (Gdk.KEY_Left, Gdk.KEY_p):
            self.app.previous()
            return True
        if keyval == Gdk.KEY_slash:
            self.entry.grab_focus()
            return True
        if keyval == Gdk.KEY_r:
            self.app.cycle_repeat()
            return True
        if keyval == Gdk.KEY_l:
            self.app.toggle_like()
            return True
        if keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.app.set_volume(self.app.volume + 5)
            return True
        if keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.app.set_volume(self.app.volume - 5)
            return True
        if keyval == Gdk.KEY_m:
            self.app.toggle_mute()
            return True
        if keyval == Gdk.KEY_e:
            self.eq_btn.popup()
            return True
        return False


