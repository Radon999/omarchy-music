# Library: songs on disk, with the metadata to show and play them offline
# =============================================================================

class Library:
    def __init__(self):
        SONGS.mkdir(parents=True, exist_ok=True)
        ART.mkdir(parents=True, exist_ok=True)
        self.items = read_json(LIBRARY, {})
        # Drop entries whose file was deleted by hand.
        for vid in [v for v, t in self.items.items() if not Path(t.get("file", "")).exists()]:
            del self.items[vid]
        self.missing = read_json(MISSING, {})
        self.lock = threading.Lock()

    def save(self):
        with self.lock:
            write_atomic(LIBRARY, json.dumps(self.items, indent=1))

    def has(self, vid):
        t = self.items.get(vid)
        return bool(t) and Path(t["file"]).exists()

    def file(self, vid):
        return self.items[vid]["file"] if self.has(vid) else None

    def is_flac(self, vid):
        return self.has(vid) and self.items[vid].get("format") == "flac"

    def add(self, track, path, art, fmt="", **extra):
        entry = {k: track.get(k) for k in ("id", "title", "artist", "album", "duration", "thumb")}
        entry.update({k: track[k] for k in ("source", "isrc", "apple", "spotify") if track.get(k)})
        old = self.items.get(track["id"], {})
        entry.update(file=str(path), art=str(art) if art else "", added=time.time(), format=fmt,
                     plays=old.get("plays", 0), last=old.get("last", 0), **extra)
        self.items[track["id"]] = entry
        self.save()

    def by_tidal(self, tidal_id):
        """The saved FLAC of Tidal track tidal_id, whichever service it was saved from."""
        for t in list(self.items.values()):
            if t.get("tidal") == tidal_id and t.get("format") == "flac" and Path(t["file"]).exists():
                return t
        return None

    def find(self, query):
        """The saved song a typed query means ("artist title", "title by artist"…), or None."""
        q = norm(re.sub(r"\s+by\s+", " ", query, flags=re.I))
        if not q:
            return None
        best, best_score = None, 0.0
        for t in self.items.values():
            title, artist = norm(clean_title(t.get("title", ""))), norm(t.get("artist", ""))
            lead = norm(t.get("artist", "").split(",")[0])
            score = max(similar(q, title), similar(q, f"{lead} {title}"), similar(q, f"{title} {lead}"),
                        similar(q, f"{artist} {title}"))
            if title and (q == title or q.endswith(title) and lead and q.startswith(lead)):
                score = max(score, 0.97)
            if score > best_score:
                best, best_score = t, score
        return dict(best) if best and best_score >= 0.82 else None

    def played(self, vid):
        if vid in self.items:
            self.items[vid]["plays"] = self.items[vid].get("plays", 0) + 1
            self.items[vid]["last"] = time.time()
            self.save()

    def remove(self, vid):
        t = self.items.pop(vid, None)
        if t:
            # The same recording saved from two services shares one file: keep it for the other.
            shared = {p for o in self.items.values() for p in (o.get("file"), o.get("art"))}
            for p in (t.get("file"), t.get("art")):
                if p and p not in shared:
                    Path(p).unlink(missing_ok=True)
                    if p == t.get("file"):
                        Path(p).with_suffix(".lrc").unlink(missing_ok=True)
            self.save()

    def mark_missing(self, vid, missing=True):
        with self.lock:
            if missing:
                self.missing[vid] = time.time()
            elif self.missing.pop(vid, None) is None:
                return
            write_atomic(MISSING, json.dumps(self.missing))

    def recently_missing(self, vid):
        return time.time() - self.missing.get(vid, 0) < RETRY_MISSING

    def lossy(self):
        """Songs saved before FLAC, to replace."""
        return [dict(t) for t in self.items.values() if t.get("format") != "flac"]

    def tracks(self):
        return sorted(self.items.values(), key=lambda t: (t.get("last", 0), t.get("added", 0)), reverse=True)

    def size_mb(self):
        return sum(Path(t["file"]).stat().st_size for t in self.items.values()
                   if Path(t["file"]).exists()) / 1e6

    def size_text(self):
        mb = self.size_mb()
        return f"{mb / 1000:.1f} GB" if mb >= 1000 else f"{mb:.0f} MB"


def slim(track):
    """A song as a playlist or the play history keeps it: enough to show and play it again."""
    return {k: track[k] for k in TRACK_KEYS if track.get(k) not in (None, "")}


# Seconds of a song (or half of a shorter one) before it counts as played.
PLAY_AFTER = 30


class Plays:
    """What you've played here, when last and how often: the Recently played and
    Most played lists. A song counts once you've listened to PLAY_AFTER seconds."""

    def __init__(self):
        self.items = read_json(PLAYS, {})   # id -> {"plays", "last", "track"}

    def add(self, track):
        e = self.items.get(track["id"]) or {"plays": 0}
        e.update(plays=e["plays"] + 1, last=time.time(), track=slim(track))
        self.items[track["id"]] = e
        write_atomic(PLAYS, json.dumps(self.items))

    def recent(self, n=200):
        rows = sorted(self.items.values(), key=lambda e: -e.get("last", 0))[:n]
        return [dict(e["track"]) for e in rows]

    def top(self, n=200):
        rows = sorted(self.items.values(), key=lambda e: (-e.get("plays", 0), -e.get("last", 0)))[:n]
        return [dict(e["track"], plays=e["plays"]) for e in rows]


class Playlists:
    """The playlists you make here, kept on this computer. Each song is in a
    playlist once; adding it again is a no-op."""

    def __init__(self):
        self.items = read_json(PLAYLISTS, [])   # [{"id", "name", "created", "updated", "tracks"}]

    def save(self):
        write_atomic(PLAYLISTS, json.dumps(self.items, indent=1))

    def all(self):
        return sorted(self.items, key=lambda p: -p.get("updated", 0))

    def get(self, pid):
        return next((p for p in self.items if p["id"] == pid), None)

    def create(self, name):
        pl = {"id": secrets.token_hex(6), "name": name, "created": time.time(), "updated": time.time(), "tracks": []}
        self.items.append(pl)
        self.save()
        return pl

    def rename(self, pid, name):
        pl = self.get(pid)
        if pl:
            pl["name"], pl["updated"] = name, time.time()
            self.save()

    def delete(self, pid):
        self.items = [p for p in self.items if p["id"] != pid]
        self.save()

    def add(self, pid, tracks):
        """Add tracks to the end; returns how many weren't in it already."""
        pl = self.get(pid)
        if not pl:
            return 0
        have = {t["id"] for t in pl["tracks"]}
        new = [slim(t) for t in tracks if t["id"] not in have and not have.add(t["id"])]
        if new:
            pl["tracks"] += new
            pl["updated"] = time.time()
            self.save()
        return len(new)

    def remove(self, pid, ids):
        pl = self.get(pid)
        if pl:
            pl["tracks"] = [t for t in pl["tracks"] if t["id"] not in ids]
            pl["updated"] = time.time()
            self.save()


class LocalFiles:
    """The songs in your own folders (~/Music to start; more in the accounts
    menu), named from their tags. Tags are read once and again only when a file
    changes. The app's own downloads folder is left out: those songs are in the
    library already."""

    def __init__(self):
        self.files = read_json(LOCAL_INDEX, {}).get("files", {})   # path -> {"mtime", "size", "track"}
        self.scanned = 0.0
        self.scanning = False

    def tracks(self):
        return [dict(e["track"]) for e in list(self.files.values())]

    def scan(self, folders):
        """Walk the folders (blocking) and read the new and changed files. Returns
        whether anything changed. A file that turns up after the first scan was
        added now; on the first scan, when it was last written."""
        first, skip = not self.files, MUSIC.resolve()
        seen, changed = {}, False
        for folder in folders:
            root = Path(folder).expanduser()
            if not root.is_dir() or root.resolve() == skip:
                continue
            for dirpath, dirnames, filenames in os.walk(root):
                d = Path(dirpath)
                dirnames[:] = [n for n in dirnames if not n.startswith(".") and (d / n).resolve() != skip]
                for name in filenames:
                    path = d / name
                    if path.suffix.lower() not in AUDIO_EXT:
                        continue
                    try:
                        st = path.stat()
                    except OSError:
                        continue
                    key = str(path.resolve())
                    old = self.files.get(key)
                    if old and old["mtime"] == st.st_mtime and old["size"] == st.st_size:
                        seen[key] = old
                        continue
                    t = track_from_file(path)
                    t["added"] = old["track"].get("added") if old else st.st_mtime if first else time.time()
                    seen[key] = {"mtime": st.st_mtime, "size": st.st_size, "track": t}
                    changed = True
        changed = changed or seen.keys() != self.files.keys()
        self.files = seen
        if changed:
            write_atomic(LOCAL_INDEX, json.dumps({"files": seen}))
        self.scanned = time.time()
        return changed


COVER_NAMES = ("cover.jpg", "folder.jpg", "front.jpg", "album.jpg", "cover.png", "folder.png", "front.png")


def file_cover(path):
    """The cover inside an audio file, else a cover.jpg (folder.jpg…) beside it, as bytes; None if neither."""
    try:
        import mutagen
        f = mutagen.File(path)
        pics = getattr(f, "pictures", None) if f is not None else None
        if pics:   # FLAC
            return pics[0].data
        tags = getattr(f, "tags", None)
        if tags:
            for k in list(tags.keys()):
                if str(k).startswith("APIC"):   # MP3
                    return tags[k].data
            if "covr" in tags:   # MP4 / M4A
                return bytes(tags["covr"][0])
            if "metadata_block_picture" in tags:   # Ogg Vorbis / Opus
                from mutagen.flac import Picture
                return Picture(base64.b64decode(tags["metadata_block_picture"][0])).data
    except Exception:  # noqa: BLE001 -- no cover in the file: look beside it
        pass
    try:
        names = {p.name.lower(): p for p in Path(path).parent.iterdir()}
    except OSError:
        return None
    for n in COVER_NAMES:
        if n in names:
            return names[n].read_bytes()
    return None


