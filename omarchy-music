# Apple Music: your library through the API music.apple.com's own player
# uses, signed in the way your browser is. Apple Music's audio is
# copy-protected, so its songs play from Tidal in FLAC, matched by ISRC.
# =============================================================================

APPLE_TOKEN = CACHE / "apple-token.json"
APPLE_API = "https://amp-api.music.apple.com"


def jwt_claims(token):
    try:
        part = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
    except (IndexError, ValueError):
        return {}


def apple_web_token(refresh=False):
    """The token music.apple.com's player sends to Apple's API. It is in the
    player's script and lasts a couple of months; kept until it expires."""
    saved = read_json(APPLE_TOKEN, {})
    if not refresh and saved.get("token") and saved.get("exp", 0) > time.time() + 86400:
        return saved["token"]
    page = http("https://music.apple.com/us/browse").decode("utf-8", "replace")
    for path in dict.fromkeys(re.findall(r'(/assets/[^"\'\s]+\.js)', page)):
        script = http("https://music.apple.com" + path).decode("utf-8", "replace")
        for tok in re.findall(r"eyJ[\w-]{10,}\.[\w-]{10,}\.[\w-]{10,}", script):
            claims = jwt_claims(tok)
            if claims.get("iss") and claims.get("exp", 0) > time.time():
                write_atomic(APPLE_TOKEN, json.dumps({"token": tok, "exp": claims["exp"]}))
                return tok
    raise RuntimeError("couldn't find Apple Music's web token")


def apple_art(url, px):
    return (url or "").replace("{w}", str(px)).replace("{h}", str(px)).replace("{f}", "jpg").replace("{c}", "bb")


def track_from_apple(res):
    """Normalise an Apple Music song, from the catalogue or your library, into our track dict."""
    a = res.get("attributes") or {}
    rel = ((res.get("relationships") or {}).get("catalog") or {}).get("data") or []
    cat = rel[0] if rel else {}
    cid = (a.get("playParams") or {}).get("catalogId") or cat.get("id") or (res["id"] if res.get("type") == "songs" else None)
    return {"id": f"am{cid or res.get('id')}", "source": "apple", "apple": cid,
            "isrc": a.get("isrc") or (cat.get("attributes") or {}).get("isrc"),
            "title": a.get("name") or "Unknown", "artist": a.get("artistName") or "Unknown artist",
            "album": a.get("albumName") or "", "duration": round((a.get("durationInMillis") or 0) / 1000),
            "thumb": apple_art((a.get("artwork") or (cat.get("attributes") or {}).get("artwork") or {}).get("url"), 226)}


class AppleMusic:
    """Your Apple Music library: playlists, favourites and search. Without a
    sign-in it still searches the catalogue, which the tagger uses too."""
    key, name = "apple", "Apple Music"
    hint = "Sign in at music.apple.com in Chromium,\nthen pick “Check again” below."

    def __init__(self):
        self.token = apple_web_token()
        self.browser, cookies = find_signed_in_browser("apple.com", "media-user-token")
        self.user_token = (cookies or {}).get("media-user-token")
        self.storefront, self.signed_in = "us", False
        if self.user_token:
            try:
                data = self.get("/v1/me/storefront").get("data") or []
                self.storefront = data[0]["id"] if data else "us"
                self.signed_in = True
            except Exception:  # noqa: BLE001 -- expired login: the catalogue only
                self.user_token = None

    def headers(self, body=False):
        h = {"Authorization": f"Bearer {self.token}", "Origin": "https://music.apple.com",
             "Referer": "https://music.apple.com/"}
        if self.user_token:
            h["media-user-token"] = self.user_token
        if body:
            h["Content-Type"] = "application/json"
        return h

    def request(self, path, params=None, method=None, body=None):
        url = path if path.startswith("http") else APPLE_API + path
        if params:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        try:
            return http_json(url, self.headers(data is not None), data, method)
        except urllib.error.HTTPError as e:
            if e.code != 401:
                raise
            self.token = apple_web_token(refresh=True)   # Apple moved to a new token
            return http_json(url, self.headers(data is not None), data, method)

    def get(self, path, params=None):
        return self.request(path, params)

    def pages(self, path, params=None, cap=5000):
        """Every item of a list Apple hands out a page at a time."""
        out, url = [], path
        while url and len(out) < cap:
            page = self.get(url, params)
            out += page.get("data") or []
            url = page.get("next")
            params = {k: v for k, v in (params or {}).items() if k != "offset"}   # the next link has its own
        return out

    def search(self, q):
        m = re.search(r"music\.apple\.com/(?:(\w\w)/)?(song|album|playlist)/(?:[^/?#]+/)?([\w.-]+)(?:\?i=(\d+))?", q)
        if not m:
            res = self.get(f"/v1/catalog/{self.storefront}/search", {"term": q, "types": "songs", "limit": 25})
            return [track_from_apple(s) for s in ((res.get("results") or {}).get("songs") or {}).get("data") or []]
        sf, kind, ident, song = m.groups()
        sf = sf or self.storefront
        if song or kind == "song":
            return [track_from_apple(s) for s in self.get(f"/v1/catalog/{sf}/songs/{song or ident}").get("data") or []]
        if kind == "album":
            tracks = [track_from_apple(s) for s in self.pages(f"/v1/catalog/{sf}/albums/{ident}/tracks")]
            self.fill_isrcs(tracks)
            return tracks
        return self.playlist(ident)

    def radio(self, track):
        raise NotImplementedError   # Apple's stations stream only to its own players: Tidal or YouTube Music fill in

    def my_playlists(self):
        out = []
        for p in self.pages("/v1/me/library/playlists", {"limit": 100}):
            a = p.get("attributes") or {}
            out.append({"id": p["id"], "title": a.get("name") or "Playlist", "count": "",
                        "thumb": apple_art((a.get("artwork") or {}).get("url"), 226)})
        return out

    def playlist(self, pid):
        if pid.startswith("p."):   # one of yours
            items = self.pages(f"/v1/me/library/playlists/{pid}/tracks", {"limit": 100, "include": "catalog"})
        else:                      # a public one, from a link
            items = self.pages(f"/v1/catalog/{self.storefront}/playlists/{pid}/tracks", {"limit": 100})
        tracks = [track_from_apple(s) for s in items]
        self.fill_isrcs(tracks)
        return tracks

    def fill_isrcs(self, tracks):
        """Library songs often come without their ISRC: ask the catalogue, 100 at a time."""
        need = [t for t in tracks if t.get("apple") and not t.get("isrc")]
        for i in range(0, len(need), 100):
            chunk = need[i:i + 100]
            try:
                data = self.get(f"/v1/catalog/{self.storefront}/songs",
                                {"ids": ",".join(str(t["apple"]) for t in chunk)}).get("data") or []
            except Exception:  # noqa: BLE001 -- they match by name instead
                continue
            isrcs = {s["id"]: (s.get("attributes") or {}).get("isrc") for s in data}
            for t in chunk:
                t["isrc"] = isrcs.get(str(t["apple"])) or t.get("isrc")

    def liked_ids(self):
        """Apple Music keeps the songs you favourite in a playlist of their own."""
        for p in self.my_playlists():
            if norm(p["title"]) in ("favorite songs", "favourite songs"):
                return {t["id"] for t in self.playlist(p["id"])}
        return set()

    def rate(self, track, like):
        if not track.get("apple"):
            raise RuntimeError("that song isn't in Apple's catalogue")
        path = f"/v1/me/ratings/songs/{track['apple']}"
        if like:
            self.request(path, method="PUT", body={"type": "rating", "attributes": {"value": 1}})
        else:
            self.request(path, method="DELETE")

    def library_tracks(self):
        """Every song in your playlists, each once."""
        seen, out = set(), []
        for pl in self.my_playlists():
            try:
                tracks = self.playlist(pl["id"])
            except Exception:  # noqa: BLE001 -- skip a playlist that won't load
                continue
            for t in tracks:
                if t["id"] not in seen:
                    seen.add(t["id"])
                    out.append(t)
        return out

    def artist(self, name):
        res = self.get(f"/v1/catalog/{self.storefront}/search", {"term": name, "types": "artists", "limit": 5})
        a = best_named(((res.get("results") or {}).get("artists") or {}).get("data") or [], name,
                       lambda x: (x.get("attributes") or {}).get("name") or "")
        if not a:
            return None
        base = f"/v1/catalog/{self.storefront}/artists/{a['id']}"
        top = [track_from_apple(s) for s in self.get(f"{base}/view/top-songs", {"limit": 20}).get("data") or []]
        albums = []
        for x in self.pages(f"{base}/albums", {"limit": 25}, cap=100):
            at = x.get("attributes") or {}
            albums.append(album_entry(x["id"], at.get("name"), "Single" if at.get("isSingle") else (at.get("releaseDate") or "")[:4],
                                      apple_art((at.get("artwork") or {}).get("url"), 226)))
        at = a.get("attributes") or {}
        return {"name": at.get("name") or name, "thumb": apple_art((at.get("artwork") or {}).get("url"), 320),
                "top": top, "albums": albums}

    def album(self, aid):
        tracks = [track_from_apple(s) for s in self.pages(f"/v1/catalog/{self.storefront}/albums/{aid}/tracks")]
        self.fill_isrcs(tracks)
        return tracks

    def catalog_song(self, isrc, album=""):
        """Apple's catalogue entry for the recording with this ISRC, with its album
        (genres, composer, label, release date, artwork), or None."""
        data = self.get(f"/v1/catalog/{self.storefront}/songs", {"filter[isrc]": isrc, "include": "albums"}).get("data") or []
        data.sort(key=lambda s: norm((s.get("attributes") or {}).get("albumName")) != norm(album))
        return data[0] if data else None


