def write_atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def in_thread(fn, *args, done=None):
    """Run fn(*args) off the UI thread; hand (result, error) to done on it."""
    def work():
        try:
            res, err = fn(*args), None
        except Exception as e:  # noqa: BLE001 -- surfaced to the UI
            res, err = None, e
        if done:
            GLib.idle_add(lambda: (done(res, err), False)[1])
    threading.Thread(target=work, daemon=True).start()


def fmt_time(s):
    s = int(max(0, s or 0))
    return f"{s // 60}:{s % 60:02d}"


def fmt_total(tracks):
    """How long a list of songs plays: "42 min", "2 h 5 min"."""
    m = round(sum(t.get("duration") or 0 for t in tracks) / 60)
    return f"{m // 60} h {m % 60} min" if m >= 60 else f"{m} min"


def short_path(path):
    """A folder as you'd write it: ~/Music rather than /home/you/Music."""
    p = str(Path(path).expanduser())
    return "~" + p[len(str(HOME)):] if p == str(HOME) or p.startswith(str(HOME) + "/") else p


def http(url, headers=None, data=None, method=None, timeout=20):
    req = urllib.request.Request(url, data=data, method=method, headers={"User-Agent": UA, **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def http_json(url, headers=None, data=None, method=None, timeout=20):
    body = http(url, headers, data, method, timeout)
    return json.loads(body) if body.strip() else {}


def source_of(track):
    return (track or {}).get("source") or "ytm"   # songs saved before there were other services


def is_phone_song(track):
    """A song on the phone that's the remote, played here from the phone (see Remote.from_phone)."""
    return source_of(track) == "file" and str(track.get("file") or "").startswith("http://")


def safe_name(track_id):
    return re.sub(r"[^\w.-]", "_", track_id)


@functools.lru_cache(maxsize=1 << 16)   # sorting thousands of songs asks for the same names again and again
def norm(s):
    """Lowercase letters and digits only, accents dropped: for comparing names across services."""
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode() or (s or "")
    return " ".join(re.sub(r"[^\w\s]", " ", s.lower()).split())


def rgba(hex_color, alpha):
    h = hex_color.lstrip("#")
    if len(h) < 6:
        return hex_color
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"rgba({r},{g},{b},{alpha})"


def track_from_ytm(item):
    """Normalise a ytmusicapi song/watch/playlist item into our track dict."""
    vid = item.get("videoId")
    if not vid:
        return None
    artists = ", ".join(a.get("name", "") for a in (item.get("artists") or []) if a.get("name"))
    album = item.get("album") or {}
    thumbs = item.get("thumbnails") or item.get("thumbnail") or []
    if isinstance(thumbs, dict):
        thumbs = thumbs.get("thumbnails", [])
    thumb = thumbs[-1]["url"] if thumbs else ""
    dur = item.get("duration_seconds")
    if dur is None:
        text = item.get("duration") or item.get("length") or ""
        parts = [int(p) for p in text.split(":") if p.isdigit()]
        dur = sum(p * 60 ** i for i, p in enumerate(reversed(parts))) if parts else 0
    return {"id": vid, "source": "ytm", "title": item.get("title") or "Unknown", "artist": artists or "Unknown artist",
            "album": album.get("name", "") if isinstance(album, dict) else "",
            "duration": dur, "thumb": thumb}


def sized_thumb(url, px):
    # YouTube Music art URLs end in =w120-h120-...; Apple's in /226x226bb.jpg: ask for the size we draw.
    if "googleusercontent" in url:
        return re.sub(r"=w\d+-h\d+", f"=w{px}-h{px}", url)
    if "mzstatic.com" in url:
        return re.sub(r"/\d+x\d+(bb|cc)?\.(jpg|webp|png)$", f"/{px}x{px}bb.jpg", url)
    return url


