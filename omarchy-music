class MediaKeys:
    """Windows: the keyboard's play/pause, next, previous and stop keys, taken system-wide
    (RegisterHotKey) on a thread of their own. MPRIS's counterpart, without the overlay."""
    KEYS = {0xB3: "toggle_pause", 0xB0: "next", 0xB1: "previous", 0xB2: "stop"}

    def __init__(self, app):
        self.app = app
        if os.environ.get("OMARCHY_MUSIC_MPRIS") == "0":
            return
        threading.Thread(target=self._listen, daemon=True).start()

    def _listen(self):
        import ctypes
        from ctypes import wintypes
        user32 = ctypes.WinDLL("user32", use_last_error=True)
        keys = {}
        for i, (vk, act) in enumerate(self.KEYS.items(), 1):
            if user32.RegisterHotKey(None, i, 0x4000, vk):   # MOD_NOREPEAT; fails if another app has the key
                keys[i] = act
        msg = wintypes.MSG()
        while user32.GetMessageW(ctypes.byref(msg), None, 0, 0) > 0:
            if msg.message == 0x0312 and msg.wParam in keys:   # WM_HOTKEY
                act = keys[msg.wParam]
                GLib.idle_add(lambda act=act: (self._do(act), False)[1])

    def _do(self, act):
        a = self.app
        if act == "stop":
            a.set_paused(True)
        else:
            getattr(a, act)()

    def changed(self):
        pass


class Mpris:
    def __init__(self, app):
        self.app = app
        self.conn = None
        self.node = Gio.DBusNodeInfo.new_for_xml(MPRIS_XML)
        if os.environ.get("OMARCHY_MUSIC_MPRIS") == "0":   # a test copy: leave the media keys alone
            return
        Gio.bus_own_name(Gio.BusType.SESSION, "org.mpris.MediaPlayer2.omarchy_music" + (f"_{PROFILE}" if PROFILE else ""),
                         Gio.BusNameOwnerFlags.NONE, self._acquired, None, None)

    def _acquired(self, conn, _name):
        self.conn = conn
        for iface in self.node.interfaces:
            conn.register_object(MPRIS_PATH, iface, self._call, self._get, self._set)

    def _call(self, _c, _s, _p, _iface, method, params, inv):
        a = self.app
        if method == "Raise":
            a.show_window()
        elif method == "Quit":
            a.quit_app()
        elif method == "Next":
            a.next()
        elif method == "Previous":
            a.previous()
        elif method == "Pause":
            a.set_paused(True)
        elif method == "Play":
            a.set_paused(False)
        elif method == "PlayPause":
            a.toggle_pause()
        elif method == "Stop":
            a.set_paused(True)
        elif method == "Seek":
            a.player.seek(max(0, a.position + params.unpack()[0] / 1e6))
        elif method == "SetPosition":
            a.player.seek(params.unpack()[1] / 1e6)
        inv.return_value(None)

    def _props(self):
        a = self.app
        t = a.current_track()
        meta = {"mpris:trackid": GLib.Variant("o", "/org/omarchy/music/" + (t["id"].encode().hex() if t else "none"))}
        if t:
            meta["xesam:title"] = GLib.Variant("s", t["title"])
            meta["xesam:artist"] = GLib.Variant("as", [t["artist"]])
            meta["xesam:album"] = GLib.Variant("s", t.get("album") or "")
            meta["mpris:length"] = GLib.Variant("x", int((a.duration or t.get("duration") or 0) * 1e6))
            art = a.lib.items.get(t["id"], {}).get("art") or str(THUMBS / f"{t['id']}.jpg")
            if Path(art).exists():
                meta["mpris:artUrl"] = GLib.Variant("s", Path(art).as_uri())
        status = "Stopped" if not t else ("Paused" if a.paused else "Playing")
        return {
            "CanQuit": GLib.Variant("b", True), "CanRaise": GLib.Variant("b", True),
            "HasTrackList": GLib.Variant("b", False), "Identity": GLib.Variant("s", "Omarchy Music"),
            "DesktopEntry": GLib.Variant("s", APP_ID), "SupportedUriSchemes": GLib.Variant("as", []),
            "SupportedMimeTypes": GLib.Variant("as", []),
            "PlaybackStatus": GLib.Variant("s", status),
            "LoopStatus": GLib.Variant("s", {"all": "Playlist", "one": "Track"}.get(a.repeat, "None")),
            "Rate": GLib.Variant("d", 1.0), "Shuffle": GLib.Variant("b", False),
            "Metadata": GLib.Variant("a{sv}", meta), "Volume": GLib.Variant("d", 0.0 if a.muted else a.volume / 100),
            "Position": GLib.Variant("x", int(a.position * 1e6)),
            "MinimumRate": GLib.Variant("d", 1.0), "MaximumRate": GLib.Variant("d", 1.0),
            "CanGoNext": GLib.Variant("b", True), "CanGoPrevious": GLib.Variant("b", True),
            "CanPlay": GLib.Variant("b", True), "CanPause": GLib.Variant("b", True),
            "CanSeek": GLib.Variant("b", True), "CanControl": GLib.Variant("b", True),
        }

    def _get(self, _c, _s, _p, _iface, prop):
        return self._props().get(prop)

    def _set(self, _c, _s, _p, _iface, prop, value):
        if prop == "Volume":   # playerctl volume 0.5
            self.app.set_volume(value.unpack() * 100)
        return True

    def changed(self):
        if not self.conn:
            return
        p = self._props()
        changed = {k: p[k] for k in ("PlaybackStatus", "LoopStatus", "Metadata", "Volume")}
        self.conn.emit_signal(None, MPRIS_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                              GLib.Variant("(sa{sv}as)", (PLAYER_IFACE, changed, [])))


# =============================================================================
# A song's names at their cleanest: the saved file's tags (Tidal's, then the
# tagger's) beat a YouTube title like "Song (Official Video)"
# =============================================================================

def file_tags(path):
    """The Vorbis comments of a FLAC file as {name: [values]}, {} if unreadable."""
    try:
        from mutagen.flac import FLAC
        return {k.lower(): v for k, v in (FLAC(path).tags or {}).as_dict().items()}
    except Exception:  # noqa: BLE001 -- not there, or not a FLAC
        return {}


def tidy_title(s):
    """A title without what YouTube adds, keeping its case."""
    s2 = re.sub(r"\s*[(\[][^)\]]*\b(official|video|audio|lyrics?|visuali[sz]er|hd|4k|mv)\b[^)\]]*[)\]]", "", s, flags=re.I)
    return s2.strip() or s


def song_meta(lib, track):
    entry = lib.items.get(track["id"]) or {}
    path = entry.get("file") if entry.get("format") == "flac" else (
        track.get("file") if source_of(track) == "file" and not is_phone_song(track) else None)
    tags = file_tags(path) if path else {}

    def one(k):
        return (tags.get(k) or [""])[0]
    title = one("title") or track.get("title") or ""
    artists = tags.get("artist") or [a.strip() for a in (track.get("artist") or "").split(",") if a.strip()]
    if not tags and source_of(track) == "ytm":
        title = tidy_title(title)
    return {"title": title, "artist": artists[0] if artists else "", "artists": artists,
            "album": one("album") or track.get("album") or "", "albumartist": one("albumartist"),
            "duration": entry.get("duration") or track.get("duration") or 0,
            "tidal": one("tidal_id") or entry.get("tidal") or track.get("tidal"),
            "mbid": one("musicbrainz_trackid"), "file": path, "tags": tags}


# =============================================================================
# Lyrics: Genius's text, and lines timed to the music (Tidal's, which come
# from Musixmatch, else LRCLIB's) to follow along. The tagger puts both in the
# saved songs, so lyrics work offline too.
# =============================================================================

LYRICS_CACHE = CACHE / "lyrics"
LYRICS_RETRY = 7 * 86400    # look again for lyrics nobody had, after a week
# Genius swaps a few letters of its lyrics for look-alikes from other alphabets
# (to spot copies). In a word that is otherwise Latin, put the real letter back.
HOMOGLYPHS = str.maketrans({"а": "a", "е": "e", "о": "o", "р": "p", "с": "c", "у": "y", "х": "x", "і": "i",
                            "ј": "j", "ѕ": "s", "һ": "h", "ԁ": "d", "ɡ": "g", "А": "A", "В": "B", "Е": "E",
                            "К": "K", "М": "M", "Н": "H", "О": "O", "Р": "P", "С": "C", "Т": "T", "Х": "X",
                            "І": "I", "Ј": "J", "Ѕ": "S", "ο": "o", "α": "a", "ν": "v", "Ο": "O", "Α": "A"})
LRC_TIME = re.compile(r"\[(\d+):(\d+(?:[.:]\d+)?)\]")


def degenius(text):
    def fix(m):
        word = m.group(0)
        letters = [c for c in word if c.isalpha()]
        return word.translate(HOMOGLYPHS) if 2 * sum(c.isascii() for c in letters) >= len(letters) else word
    text = re.sub(r"[  -   ]", " ", text)   # odd spaces
    text = re.sub(r"[​-‍⁠﻿]", "", text)          # invisible ones
    return re.sub(r"\w+", fix, text)


class _GeniusLyrics(HTMLParser):
    """The text of a Genius song page's lyrics, without the header Genius puts inside them."""
    VOID = {"br", "img", "hr", "input", "meta", "link", "source", "wbr", "area", "col", "embed", "param", "track"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.depth = self.skip = 0
        self.parts = []

    def handle_starttag(self, tag, attrs):
        if tag in self.VOID:
            if self.depth and tag == "br" and not self.skip:
                self.parts.append("\n")
            return
        a = dict(attrs)
        if self.depth:
            self.depth += 1
            if self.skip or a.get("data-exclude-from-selection") == "true":
                self.skip += 1
        elif a.get("data-lyrics-container") == "true":
            self.depth = 1
            if self.parts:
                self.parts.append("\n")

    def handle_startendtag(self, tag, attrs):
        if self.depth and tag == "br" and not self.skip:
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if self.depth and tag not in self.VOID:
            self.depth -= 1
            if self.skip:
                self.skip -= 1

    def handle_data(self, data):
        if self.depth and not self.skip:
            self.parts.append(data)

    def text(self):
        return re.sub(r"\n{3,}", "\n\n", "".join(self.parts)).strip()


def genius_lyrics(artist, title):
    """(text, page address) of the song on Genius, or None if Genius hasn't got it."""
    lead = artist.split(",")[0].strip()
    want = clean_title(title)
    best, best_score = None, 0.0
    for q in dict.fromkeys((f"{lead} {bare_title(title)}", f"{lead} {want}")):
        res = http_json("https://genius.com/api/search/song?" + urllib.parse.urlencode({"q": q, "per_page": 5}))
        sections = (res.get("response") or {}).get("sections") or [{}]
        for hit in sections[0].get("hits") or []:
            r = hit.get("result") or {}
            names = artist_names([r.get("artist_names") or "", (r.get("primary_artist") or {}).get("name") or ""])
            if any(n.startswith("genius") for n in names):   # its translations and romanizations
                continue
            t = similar(want, clean_title(r.get("title") or ""))
            a = max((similar(x, y) for x in artist_names([lead]) for y in names), default=0.0)
            if t >= 0.6 and a >= 0.7 and 0.6 * t + 0.4 * a > best_score:
                best, best_score = r, 0.6 * t + 0.4 * a
        if best_score >= 0.9:
            break
    if not best or not best.get("url"):
        return None
    page = _GeniusLyrics()
    page.feed(http(best["url"]).decode("utf-8", "replace"))
    text = degenius(page.text())
    return (text, best["url"]) if text else None


def lrclib_lyrics(artist, title, album, duration):
    """(timed LRC text, plain text, instrumental) from LRCLIB, or None."""
    hdr = {"User-Agent": APP_UA}
    lead = artist.split(",")[0].strip()
    found = None
    try:
        found = http_json("https://lrclib.net/api/get?" + urllib.parse.urlencode(
            {"artist_name": lead, "track_name": title, "album_name": album or "", "duration": int(duration or 0)}), hdr)
    except urllib.error.HTTPError as e:
        if e.code != 404:
            raise
    if not found:
        hits = http_json("https://lrclib.net/api/search?" + urllib.parse.urlencode(
            {"track_name": title, "artist_name": lead}), hdr) or []
        hits = [h for h in hits if not duration or abs((h.get("duration") or 0) - duration) <= 3]
        hits.sort(key=lambda h: -similar(clean_title(title), clean_title(h.get("trackName") or "")))
        found = hits[0] if hits and similar(clean_title(title), clean_title(hits[0].get("trackName") or "")) > 0.7 else None
    if not found:
        return None
    return found.get("syncedLyrics") or None, found.get("plainLyrics") or None, bool(found.get("instrumental"))


def parse_lrc(text):
    """[(seconds, line)] from LRC text, in order; [] if it has no timed lines."""
    m = re.search(r"\[offset:\s*([+-]?\d+)\]", text or "", re.I)
    offset = int(m.group(1)) / 1000 if m else 0.0   # + shows the lines sooner
    lines = []
    for raw in (text or "").splitlines():
        stamps = LRC_TIME.findall(raw)
        if not stamps:
            continue
        words = re.sub(r"<\d+:\d+(?:\.\d+)?>", "", LRC_TIME.sub("", raw)).strip()   # drops word timings
        for mm, ss in stamps:
            lines.append((max(0.0, int(mm) * 60 + float(ss.replace(":", ".")) - offset), words))
    return sorted(lines, key=lambda x: x[0])


class Lyrics:
    """Finds the lyrics of each song once and keeps them."""

    def __init__(self, app):
        self.app = app
        LYRICS_CACHE.mkdir(parents=True, exist_ok=True)

    @staticmethod
    def has(got):
        return bool(got and (got.get("plain") or got.get("synced") or got.get("instrumental")))

    def get(self, track, refresh=False):
        """{"plain", "plain_from", "synced", "synced_from", "url", "instrumental"} for track,
        or None if nobody has its lyrics. It blocks: run it off the UI thread."""
        m = song_meta(self.app.lib, track)
        if m["file"] and not refresh:
            got = self.from_file(m["file"], self.app.lib.items.get(track["id"]) or {})
            if got:
                return got
        path = LYRICS_CACHE / f"{safe_name(track['id'])}.json"
        cached = read_json(path, None)
        if cached and not refresh and (self.has(cached) or time.time() - cached.get("time", 0) < LYRICS_RETRY):
            return cached if self.has(cached) else None
        got, reached = self.fetch(m)
        if reached:   # offline, every lookup failed: don't remember that as "no lyrics"
            write_atomic(path, json.dumps(got | {"time": time.time()}))
        return got if self.has(got) else None

    @staticmethod
    def from_file(path, entry):
        tags = file_tags(path)
        plain = (tags.get("lyrics") or tags.get("unsyncedlyrics") or [None])[0]
        lrc = Path(path).with_suffix(".lrc")
        synced = lrc.read_text(errors="replace") if lrc.exists() else None
        if plain and not synced and parse_lrc(plain):   # timed lines kept in the tag itself
            synced, plain = plain, None
        if not (plain or synced):
            return None
        info = entry.get("lyrics") or {}
        return {"plain": plain, "plain_from": info.get("plain_from") or "the file", "synced": synced,
                "synced_from": info.get("synced_from") or "the file", "url": info.get("url"), "instrumental": False}

    def fetch(self, m):
        got = {"plain": None, "plain_from": None, "synced": None, "synced_from": None, "url": None, "instrumental": False}
        reached = False
        try:
            g = genius_lyrics(m["artist"], m["title"])
            reached = True
            if g:
                got.update(plain=g[0], plain_from="Genius", url=g[1])
        except (OSError, ValueError):   # offline, or Genius changed: the others may still have them
            pass
        tidal = self.app.dl.tidal
        if m["tidal"] and tidal and tidal.connected:
            try:
                synced, plain = tidal.lyrics(m["tidal"])
                reached = True
                if synced:
                    got.update(synced=synced, synced_from="Musixmatch, through Tidal")
                if plain and not got["plain"]:
                    got.update(plain=plain, plain_from="Musixmatch, through Tidal")
            except Exception:  # noqa: BLE001 -- Tidal has none for it
                pass
        if not got["synced"]:
            try:
                r = lrclib_lyrics(m["artist"], m["title"], m["album"], m["duration"])
                reached = True
                if r:
                    synced, plain, instrumental = r
                    if synced:
                        got.update(synced=synced, synced_from="LRCLIB")
                    if plain and not got["plain"]:
                        got.update(plain=plain, plain_from="LRCLIB")
                    got["instrumental"] = instrumental and not (got["plain"] or got["synced"])
            except (OSError, ValueError):
                pass
        return got, reached


# =============================================================================
# Auto-tagger: what Tidal's tags leave out, for every saved song
# =============================================================================

TAGGER_VERSION = 1
MB_API = "https://musicbrainz.org/ws/2"


def lucene(s):
    return re.sub(r'([+\-&|!(){}\[\]^"~*?:\\/])', r"\\\1", s)


class Tagger:
    """Fills in, for each saved FLAC: genre, composer, label, barcode, original
    release date and track total (Apple's catalogue, by ISRC), MusicBrainz IDs
    (so other apps and Last.fm know the exact recording), a 1280 px cover, and
    lyrics: Genius's text in the file, the timed lines beside it as a .lrc
    (Poweramp and most players read those). A few songs at a time, in the
    background. A playing song is safe: each file is tagged as a copy that is
    then swapped in."""

    WORKERS = 3   # songs at once: MusicBrainz is slow to answer, so overlap its waits

    def __init__(self, app):
        self.app = app
        self.queue, self.current = [], set()
        self.done = self.total = self.workers = 0
        self.running = False
        self.lock = threading.Lock()
        self.apple = None          # Apple's catalogue, opened on first use
        self.mb_lock = threading.Lock()
        self.mb_next = 0.0         # MusicBrainz takes one request a second
        self.last_error = None

    def untagged(self):
        return [vid for vid, t in list(self.app.lib.items.items())
                if t.get("format") == "flac" and t.get("tagged", 0) < TAGGER_VERSION]

    def start(self, ids=None):
        """Tag ids (default: every saved song not tagged yet), after what is already waiting."""
        with self.lock:
            files = {self.app.lib.items[i]["file"] for i in [*self.queue, *self.current] if i in self.app.lib.items}
            for vid in self.untagged() if ids is None else ids:
                t = self.app.lib.items.get(vid)
                if t and t.get("format") == "flac" and t["file"] not in files:
                    self.queue.append(vid)
                    files.add(t["file"])   # one file saved from two services is tagged once
                    self.total += 1
            more = min(self.WORKERS - self.workers, len(self.queue))
            if more <= 0:
                return
            self.workers += more
            self.running = True
        for _ in range(more):
            threading.Thread(target=self._run, daemon=True).start()
        self.app.update_sync()

    def status(self):
        if not self.running:
            return ""
        return f"Tagging · {self.done} of {self.total}"

    def _run(self):
        while True:
            with self.lock:
                if not self.queue:
                    self.workers -= 1
                    last = not self.workers
                    if last:
                        self.running, self.done, self.total = False, 0, 0
                    break
                vid = self.queue.pop(0)
                self.current.add(vid)
            try:
                self.tag(vid)
            except Exception as e:  # noqa: BLE001 -- the next song; this one is tried again next time
                self.last_error = f"{vid}: {e}"
            with self.lock:
                self.current.discard(vid)
                self.done += 1
            GLib.idle_add(lambda: (self.app.update_sync(), False)[1])
        if last:
            GLib.idle_add(lambda: (self.app.tagging_finished(), False)[1])

    def apple_song(self, isrc, album):
        if not isrc:
            return None
        if not self.apple:
            self.apple = self.app.sources.get("apple") or AppleMusic()
        try:
            return self.apple.catalog_song(isrc, album)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            raise

    def mb(self, path, **params):
        with self.mb_lock:   # the songs being tagged take turns: a request a second between them
            wait = self.mb_next - time.monotonic()
            if wait > 0:
                time.sleep(wait)
            self.mb_next = time.monotonic() + 1.1
        try:
            return http_json(f"{MB_API}/{path}?" + urllib.parse.urlencode({**params, "fmt": "json"}),
                             {"User-Agent": APP_UA})
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return {}
            raise

    def musicbrainz(self, isrc, title, artist, album, duration):
        """MusicBrainz's IDs for the recording, its release, release group and artists."""
        recs = self.mb(f"isrc/{isrc}").get("recordings") or [] if isrc else []
        if not recs and title and artist:
            q = f'recording:"{lucene(title)}" AND artist:"{lucene(artist)}"'
            recs = [r for r in self.mb("recording", query=q, limit=5).get("recordings") or [] if r.get("score", 0) >= 95]
        if not recs:
            return {}
        best = min(recs, key=lambda r: abs((r.get("length") or 0) / 1000 - duration) if duration and r.get("length") else 999)
        # The ISRC lookup leaves the releases out whatever it's asked for: the recording's own lookup has them all.
        rec = self.mb(f"recording/{best['id']}", inc="releases+release-groups+artist-credits") or best
        out = {"musicbrainz_trackid": best["id"]}
        ids = [c["artist"]["id"] for c in rec.get("artist-credit") or [] if c.get("artist")]
        if ids:
            out["musicbrainz_artistid"] = ids
        releases = rec.get("releases") or []
        if releases:
            rel = max(releases, key=lambda r: (similar(norm(r.get("title")), norm(album)), r.get("status") == "Official",
                                               bool(r.get("date"))))
            out["musicbrainz_albumid"] = rel["id"]
            if (rel.get("release-group") or {}).get("id"):
                out["musicbrainz_releasegroupid"] = rel["release-group"]["id"]
            ids = [c["artist"]["id"] for c in rel.get("artist-credit") or [] if c.get("artist")]
            if ids:
                out["musicbrainz_albumartistid"] = ids
        return out

    def mb_genres(self, artist_ids):
        """The genres MusicBrainz lists for the song's first artist, most voted first."""
        if not artist_ids:
            return []
        found = self.mb(f"artist/{artist_ids[0]}", inc="genres").get("genres") or []
        return [g["name"].title() for g in sorted(found, key=lambda g: -g.get("count", 0)) if g.get("count", 0) > 0][:2]

    def tag(self, vid):
        from mutagen.flac import FLAC, Picture
        lib = self.app.lib
        entry = lib.items.get(vid)
        if not entry or entry.get("format") != "flac" or not Path(entry["file"]).exists():
            return
        path = Path(entry["file"])
        m = song_meta(lib, entry)
        tags = m["tags"]
        isrc = (tags.get("isrc") or [entry.get("isrc") or ""])[0]
        new = {}

        song = self.apple_song(isrc, m["album"])
        artwork = None
        if song:
            a = song.get("attributes") or {}
            albums = ((song.get("relationships") or {}).get("albums") or {}).get("data") or [{}]
            aa = albums[0].get("attributes") or {}
            genres = [g for g in a.get("genreNames") or [] if g != "Music"][:3]
            new.update({k: v for k, v in {
                "genre": genres, "composer": a.get("composerName"), "label": aa.get("recordLabel"),
                "barcode": aa.get("upc"), "originaldate": a.get("releaseDate"),
                "tracktotal": str(aa["trackCount"]) if aa.get("trackCount") else None,
                "apple_music_id": song.get("id"),
            }.items() if v})
            artwork = (a.get("artwork") or {}).get("url")
        try:
            new.update(self.musicbrainz(isrc, m["title"], m["artist"], m["album"], m["duration"]))
        except (OSError, ValueError):   # MusicBrainz is down: the rest still goes in
            pass
        if not new.get("genre"):
            try:
                new["genre"] = self.mb_genres(new.get("musicbrainz_artistid")) or None
            except (OSError, ValueError):
                pass

        got = self.app.lyrics.get(entry)
        lrc = credit = None
        if got:
            if got.get("plain"):
                new["lyrics"] = got["plain"]
            lrc = got.get("synced")
            credit = {"plain_from": got.get("plain_from"), "synced_from": got.get("synced_from"), "url": got.get("url")}

        cover = None
        f = FLAC(path)
        if max((len(p.data) for p in f.pictures), default=0) < 120_000:   # 640 px from before: get 1280
            try:
                tidal = self.app.dl.tidal
                if m["tidal"] and tidal and tidal.connected:
                    with tidal.lock:
                        url = tidal.session.track(int(m["tidal"])).album.image(1280)
                else:
                    url = apple_art(artwork, 1280) if artwork else None
                cover = fetch_bytes(url) if url else None
            except Exception:  # noqa: BLE001 -- keep the cover it has
                cover = None

        # Keep what the file already says (Tidal's names, numbers, date); add the rest.
        fill = {k: v for k, v in new.items() if v and (k in ("lyrics", "genre") or not tags.get(k))}
        if fill or cover:
            tmp = path.with_name(path.stem + ".tagging.flac")
            import shutil
            shutil.copyfile(path, tmp)
            try:
                f = FLAC(tmp)
                for k, v in fill.items():
                    f[k] = v
                if cover:
                    f.clear_pictures()
                    pic = Picture()
                    pic.type, pic.mime, pic.data = 3, "image/jpeg", cover   # 3: front cover
                    f.add_picture(pic)
                f.save()
                os.replace(tmp, path)
            finally:
                tmp.unlink(missing_ok=True)
        if lrc:
            write_atomic(path.with_suffix(".lrc"), lrc)
        genres = fill.get("genre") or tags.get("genre") or []
        with lib.lock:   # not while another song's tagging is saving the library
            for e in [e for e in list(lib.items.values()) if e.get("file") == str(path)]:   # every service's entry for it
                e["tagged"] = TAGGER_VERSION
                if genres:
                    e["genre"] = genres[0]
                if credit:
                    e["lyrics"] = credit
        lib.save()


