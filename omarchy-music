# =============================================================================
# Library: songs on disk, with the metadata to show and play them offline
# =============================================================================

class Library:
    def __init__(self):
        SONGS.mkdir(parents=True, exist_ok=True)
        ART.mkdir(parents=True, exist_ok=True)
        self.items = read_json(LIBRARY, {})
        # Drop entries whose file was deleted by hand.
        for vid in [v for v, t in self.items.items() if not Path(t.get("file", "")).exists()]:
            del self.items[vid]
        self.missing = read_json(MISSING, {})
        self.lock = threading.Lock()

    def save(self):
        with self.lock:
            write_atomic(LIBRARY, json.dumps(self.items, indent=1))

    def has(self, vid):
        t = self.items.get(vid)
        return bool(t) and Path(t["file"]).exists()

    def file(self, vid):
        return self.items[vid]["file"] if self.has(vid) else None

    def is_flac(self, vid):
        return self.has(vid) and self.items[vid].get("format") == "flac"

    def add(self, track, path, art, fmt="", **extra):
        entry = {k: track.get(k) for k in ("id", "title", "artist", "album", "duration", "thumb")}
        entry.update(file=str(path), art=str(art) if art else "", added=time.time(), format=fmt,
                     plays=self.items.get(track["id"], {}).get("plays", 0),
                     last=self.items.get(track["id"], {}).get("last", 0), **extra)
        self.items[track["id"]] = entry
        self.save()

    def played(self, vid):
        if vid in self.items:
            self.items[vid]["plays"] = self.items[vid].get("plays", 0) + 1
            self.items[vid]["last"] = time.time()
            self.save()

    def remove(self, vid):
        t = self.items.pop(vid, None)
        if t:
            for p in (t.get("file"), t.get("art")):
                if p:
                    Path(p).unlink(missing_ok=True)
            self.save()

    def mark_missing(self, vid, missing=True):
        with self.lock:
            if missing:
                self.missing[vid] = time.time()
            elif self.missing.pop(vid, None) is None:
                return
            write_atomic(MISSING, json.dumps(self.missing))

    def recently_missing(self, vid):
        return time.time() - self.missing.get(vid, 0) < RETRY_MISSING

    def lossy(self):
        """Songs saved before FLAC, to replace."""
        return [dict(t) for t in self.items.values() if t.get("format") != "flac"]

    def tracks(self):
        return sorted(self.items.values(), key=lambda t: (t.get("last", 0), t.get("added", 0)), reverse=True)

    def size_mb(self):
        return sum(Path(t["file"]).stat().st_size for t in self.items.values()
                   if Path(t["file"]).exists()) / 1e6

    def size_text(self):
        mb = self.size_mb()
        return f"{mb / 1000:.1f} GB" if mb >= 1000 else f"{mb:.0f} MB"


# =============================================================================
# Downloads: FLAC from Tidal, once per song. Each YouTube Music song is matched
# on Tidal by title, artist and length; songs Tidal has no lossless copy of
# are skipped, never saved lossy. .part files mean a crash never leaves a half
# song that looks finished.
# =============================================================================

TIDAL_SESSION = HOME / ".local" / "state" / "omarchy-music-tidal.json"
RETRY_MISSING = 7 * 86400   # look again for songs Tidal didn't have after a week
SYNC_EVERY = 3 * 3600       # pick up songs added to your playlists (on your phone, say)
LOSSLESS = {"LOSSLESS", "HI_RES", "HI_RES_LOSSLESS"}
# The best Tidal has of each song: hi-res FLAC (up to 24-bit/192 kHz) where it
# exists, CD-quality FLAC otherwise. "LOSSLESS" would keep everything 16-bit/44.1.
TIDAL_QUALITY = "HI_RES_LOSSLESS"
# Words that make a different recording: a match must agree on each of them.
VERSION_WORDS = ("live", "remix", "acoustic", "instrumental", "karaoke", "sped up", "slowed", "nightcore",
                 "demo", "unplugged", "orchestral", "a cappella", "acapella", "radio edit", "extended")


class NoLosslessMatch(RuntimeError):
    pass


def clean_title(s):
    """A title without what YouTube adds: (Official Video), feat. credits,
    remaster notes, punctuation."""
    s = s.lower()
    s = re.sub(r"[(\[][^)\]]*\b(official|video|audio|lyrics?|visuali[sz]er|hd|4k|mv|remaster(ed)?|feat|ft|with"
               r"|original|album version|explicit|clean|single version)\b[^)\]]*[)\]]", " ", s)
    s = re.sub(r"\s[-–]\s[^-–]*\b(official|video|audio|lyrics?|remaster(ed)?)\b.*$", " ", s)
    s = re.sub(r"\b(feat|ft)\b\.?\s.*$", " ", s)
    return " ".join(re.sub(r"[^\w\s]", " ", s).split())


def bare_title(s):
    """Just the song's name: no brackets, nothing after " - "."""
    return clean_title(re.sub(r"[(\[][^)\]]*[)\]]|\s[-–]\s.*$", " ", s))


def featured(title):
    """Artists credited in a title: "Song (feat. A & B)" -> {a, b}."""
    m = re.search(r"\b(?:feat|ft|with)\b\.?\s*([^)\]]+)", title, re.I)
    return artist_names([m.group(1)]) if m else set()


def artist_names(names):
    """Each artist in names, lowercased; splits "A, B & C" and drops "- Topic"."""
    out = set()
    for n in names:
        n = re.sub(r"\s*-\s*topic$|vevo$", "", n.lower().strip())
        for part in re.split(r",|&|\bx\b|\band\b|\bfeat\b\.?|\bft\b\.?", n):
            part = " ".join(re.sub(r"[^\w\s]", " ", part).split())
            if part:
                out.add(part)
    return out


def similar(a, b):
    return difflib.SequenceMatcher(None, a, b).ratio()


def has_word(text, word):
    return re.search(rf"\b{word}\b", text) is not None


def fetch_bytes(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return r.read()


def write_file(dest, data):
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(".part")
    tmp.write_bytes(data)
    os.replace(tmp, dest)


def fetch_url(url, dest):
    write_file(dest, fetch_bytes(url))


class Tidal:
    """Your Tidal account: finds each song and downloads it in FLAC.

    Tidal streams lossless only to the browser ("PKCE") login: you sign in on
    Tidal's page and paste back the address of the "Oops" page it ends on.
    """

    def __init__(self):
        import tidalapi
        self.td = tidalapi
        self.session = tidalapi.Session(tidalapi.Config(quality=TIDAL_QUALITY))
        self.lock = threading.Lock()   # one API call at a time; file downloads run in parallel
        self.connected = False
        if TIDAL_SESSION.exists():
            try:
                self.connected = (bool(self.session.load_session_from_file(TIDAL_SESSION))
                                  and self.session.check_login() and self.session.is_pkce)
            except Exception:  # noqa: BLE001 -- expired or broken login: connect again
                self.connected = False
            if self.connected:
                self._save()   # keep the refreshed token

    def _save(self):
        TIDAL_SESSION.parent.mkdir(parents=True, exist_ok=True)
        TIDAL_SESSION.touch(mode=0o600, exist_ok=True)
        self.session.save_session_to_file(TIDAL_SESSION)
        TIDAL_SESSION.chmod(0o600)

    def login_url(self):
        """Logging in, step 1: the page to sign in to Tidal on."""
        return self.session.pkce_login_url()

    def finish_login(self, oops_url):
        """Step 2: the address of the "Oops" page Tidal ends on after signing in."""
        token = self.session.pkce_get_auth_token(oops_url.strip())
        self.session.process_auth_token(token, is_pkce_token=True)
        self._save()
        self.connected = True

    def match(self, track):
        """The Tidal track that is this song, available in lossless, or None."""
        # (artists, title) readings of the song: as YouTube has it, and for
        # uploads titled "Artist - Song", the way the title has it.
        readings = [(track["artist"].split(","), track["title"])]
        m = re.match(r"(.+?)\s[-–]\s(.+)", track["title"])
        if m:
            readings.append((re.split(r",|&|\bx\b", m.group(1)), m.group(2)))
        queries = []
        for artists, title in readings:
            for q in (f"{artists[0].strip()} {clean_title(title)}", f"{artists[0].strip()} {bare_title(title)}"):
                if q not in queries:
                    queries.append(q)
        queries.append(clean_title(track["title"]))
        best, best_score, seen = None, 0.0, set()
        for query in queries:
            with self.lock:
                found = self.session.search(query, models=[self.td.Track], limit=20)["tracks"]
            for c in found:
                if c.id not in seen:
                    seen.add(c.id)
                    score = max(self._score(track, artists, title, c) for artists, title in readings)
                    if score > best_score:
                        best, best_score = c, score
            if best_score >= 0.9:
                break
        return best

    @staticmethod
    def _score(track, artists, title, c):
        """How sure we are that c is the song, 0 (it isn't) .. ~1."""
        if not c.available or not (c.audio_quality in LOSSLESS or "LOSSLESS" in (c.media_metadata_tags or [])):
            return 0.0
        dur = track.get("duration") or 0
        if dur and abs((c.duration or 0) - dur) > 6:
            return 0.0
        name = f"{c.name} ({c.version})" if c.version else c.name
        album = getattr(c.album, "name", "") or ""
        if any(has_word(f"{title} {track.get('album') or ''}".lower(), w) != has_word(f"{name} {album}".lower(), w)
               for w in VERSION_WORDS):
            return 0.0
        t = similar(clean_title(title), clean_title(name))
        theirs = artist_names(a.name for a in c.artists or []) | featured(name)

        def found(artist):
            return max((similar(artist, y) for y in theirs), default=0.0)
        lead = max((found(x) for x in artist_names(artists[:1])), default=0.0)
        if t < 0.75 or lead < 0.8:
            return 0.0
        ours = artist_names(artists) | featured(title)
        credits = sum(found(x) for x in ours) / len(ours)    # prefers the version with the featured artists
        closeness = 1 - abs(c.duration - dur) / 6 if dur else 0.5
        same_album = 0.05 if track.get("album") and similar(track["album"].lower(), album.lower()) > 0.8 else 0.0
        return 0.55 * t + 0.2 * lead + 0.1 * credits + 0.15 * closeness + same_album

    def download(self, c, dest, cover, vid):
        """Save Tidal track c at dest as tagged FLAC; returns (bits, sample rate)."""
        import requests
        with self.lock:
            stream = c.get_stream()
            manifest = stream.get_stream_manifest()
        if stream.audio_quality not in LOSSLESS or "FLAC" not in str(manifest.get_codecs()).upper():
            raise NoLosslessMatch("Tidal only has it lossy")
        if manifest.is_encrypted:
            raise RuntimeError("Tidal sent an encrypted stream")
        part = dest.with_suffix(".part")
        with open(part, "wb") as f:
            for url in manifest.get_urls():
                with requests.get(url, stream=True, timeout=30) as r:
                    r.raise_for_status()
                    for chunk in r.iter_content(1 << 16):
                        f.write(chunk)
        if manifest.is_mpd:
            # FLAC in MP4 segments: take the FLAC out, untouched.
            flac = dest.with_suffix(".remux.flac")
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(part), "-map", "0:a", "-c:a", "copy",
                            str(flac)], check=True, capture_output=True, timeout=300)
            part.unlink()
            part = flac
        info = tag_flac(part, c, cover, vid)
        os.replace(part, dest)
        return info


def tag_flac(path, c, cover, vid):
    """Title, artists, album, numbers and cover from Tidal; returns (bits, sample rate)."""
    from mutagen.flac import FLAC, Picture
    f = FLAC(path)
    f.clear()
    album = c.album
    tags = {
        "title": f"{c.name} ({c.version})" if c.version else c.name,
        "artist": [a.name for a in c.artists or []],
        "album": getattr(album, "name", None),
        "albumartist": getattr(getattr(album, "artist", None), "name", None),
        "tracknumber": str(c.track_num) if c.track_num else None,
        "discnumber": str(c.volume_num) if c.volume_num else None,
        "date": str(getattr(album, "release_date", None) or c.tidal_release_date or "")[:10] or None,
        "isrc": c.isrc, "copyright": c.copyright, "youtube_music_id": vid, "tidal_id": str(c.id),
    }
    for key, value in tags.items():
        if value:
            f[key] = value
    if cover:
        pic = Picture()
        pic.type, pic.mime, pic.data = 3, "image/jpeg", cover   # 3: front cover
        f.add_picture(pic)
    f.save()
    return f.info.bits_per_sample, f.info.sample_rate


class Downloader:
    def __init__(self, library):
        self.lib = library
        self.tidal = None          # a Tidal once it is set up
        self.active = {}           # vid -> [callbacks]
        self.lock = threading.Lock()

    def fetch(self, track, done):
        """Make sure track is on disk; done(path or None, error) on the UI thread."""
        vid = track["id"]
        if self.lib.has(vid):
            done(self.lib.file(vid), None)
            return
        with self.lock:
            if vid in self.active:
                self.active[vid].append(done)
                return
            self.active[vid] = [done]
        in_thread(self._download, track, done=lambda res, err: self._finish(vid, res, err))

    def busy(self, vid):
        return vid in self.active

    def sync(self, tracks, progress):
        """Save every song in tracks as FLAC, one at a time (blocking). Songs
        Tidal recently didn't have are left alone; progress() runs on the UI
        thread after each song."""
        for track in tracks:
            vid = track["id"]
            if self.lib.is_flac(vid) or self.lib.recently_missing(vid):
                continue
            with self.lock:
                if vid in self.active:
                    continue          # playback is already getting it
                self.active[vid] = []
            path, err = None, None
            try:
                path = self._download(track)
            except Exception as e:  # noqa: BLE001 -- next song; it is tried again next sync
                err = e
            finally:
                self._finish(vid, path or self.lib.file(vid), None if self.lib.has(vid) else err)
            GLib.idle_add(lambda: (progress(), False)[1])

    def _download(self, track):
        vid = track["id"]
        if not (self.tidal and self.tidal.connected):
            raise RuntimeError("connect Tidal in the Library tab first")
        match = self.tidal.match(track)
        if not match:
            self.lib.mark_missing(vid)
            raise NoLosslessMatch("not on Tidal in lossless")
        cover = None
        try:
            cover = fetch_bytes(match.album.image(640))
        except Exception:  # noqa: BLE001 -- the song without its cover
            pass
        old = self.lib.file(vid)
        path = SONGS / f"{vid}.flac"
        try:
            bits, rate = self.tidal.download(match, path, cover, vid)
        except NoLosslessMatch:
            self.lib.mark_missing(vid)
            raise
        art = ART / f"{vid}.jpg"
        try:
            if cover:
                write_file(art, cover)
            elif track.get("thumb"):
                fetch_url(sized_thumb(track["thumb"], 226), art)
            else:
                art = None
        except OSError:
            art = None
        self.lib.add(track, path, art, "flac", quality=f"{bits}-bit/{rate / 1000:g} kHz", tidal=match.id)
        self.lib.mark_missing(vid, False)
        if old and old != str(path):
            Path(old).unlink(missing_ok=True)    # the lossy copy it replaces
        return str(path)

    def _finish(self, vid, path, err):
        with self.lock:
            callbacks = self.active.pop(vid, [])
        for cb in callbacks:
            cb(path, err)


class ArtCache:
    """Album art for rows: library art on disk, else a cached thumbnail."""

    def __init__(self, library):
        self.lib = library
        self.textures = {}
        self.waiting = {}
        THUMBS.mkdir(parents=True, exist_ok=True)

    def apply(self, picture, track, px=226):
        vid = track["id"]
        if vid in self.textures:
            picture.set_from_paintable(self.textures[vid])
            return
        lib = self.lib.items.get(vid)
        path = Path(lib["art"]) if lib and lib.get("art") else THUMBS / f"{vid}.jpg"
        if path.exists():
            self._load(vid, path, picture)
            return
        if not track.get("thumb"):
            return
        self.waiting.setdefault(vid, []).append(picture)
        if len(self.waiting[vid]) > 1:
            return
        in_thread(fetch_url, sized_thumb(track["thumb"], px), path,
                  done=lambda _r, err: [self._load(vid, path, p) for p in self.waiting.pop(vid, [])] if not err else self.waiting.pop(vid, None))

    def _load(self, vid, path, picture):
        try:
            tex = Gdk.Texture.new_from_filename(str(path))
        except GLib.Error:
            return
        self.textures[vid] = tex
        picture.set_from_paintable(tex)


