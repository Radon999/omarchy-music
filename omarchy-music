        s = self.slide(4)
        s.append(w_label("YOUR TOP ARTISTS", "w-kicker"))
        s.append(w_label(f"#1 of {d['artist_count']:,}", "w-mid w-accent"))
        lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=12)
        self.ranked(lst, [(n, "", p) for n, p in d["artists"][:5]], meter=True)
        s.append(lst)

        title, artist, plays, art, first = d["songs"][0]
        s = self.slide(5)
        s.append(w_label("YOUR TOP SONG", "w-kicker"))
        s.append(w_picture(art, self.px(240)))
        s.append(w_label(title, "w-big"))
        s.append(w_label(artist, "w-sub"))
