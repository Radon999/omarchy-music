    def volume_button(self):
        """Click for a slider, scroll on it to step, middle-click (or m) to mute."""
        self.vol_scale = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL, inverted=True, draw_value=False)
        self.vol_scale.add_css_class("volume")
        self.vol_scale.set_range(0, 100)
        self.vol_scale.set_increments(5, 10)
        self.vol_scale.set_value(self.app.volume)
        self.vol_scale.connect("value-changed", lambda sc: self.app.set_volume(sc.get_value()))
        self.vol_btn = Gtk.MenuButton(popover=Gtk.Popover(child=self.vol_scale), valign=Gtk.Align.CENTER,
                                      direction=Gtk.ArrowType.UP)
        self.vol_btn.add_css_class("ctl")
        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", lambda _c, _dx, dy: (self.app.set_volume(self.app.volume - 5 * dy), True)[1])
        self.vol_btn.add_controller(scroll)
        middle = Gtk.GestureClick(button=Gdk.BUTTON_MIDDLE)
        middle.connect("pressed", lambda *_: self.app.toggle_mute())
        self.vol_btn.add_controller(middle)
        self.update_volume()
        return self.vol_btn

    def update_volume(self):
        a = self.app
        level = 0 if a.muted else a.volume
        icon = ("muted" if level == 0 else "low" if level < 34 else "medium" if level < 67 else "high")
        self.vol_btn.set_icon_name(f"audio-volume-{icon}-symbolic")
        self.vol_btn.set_tooltip_text(("Muted" if a.muted else f"Volume {a.volume:.0f}%")
                                      + "  (scroll, + / −, m to mute)")
        if abs(self.vol_scale.get_value() - a.volume) > 0.5:
            self.vol_scale.set_value(a.volume)

    def eq_button(self):
        """The equalizer: a correction for your headphones, then ten bands to taste."""
        a = self.app
        self.syncing_eq = False
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.add_css_class("eq")
        head = Gtk.Box(spacing=8)
        title = Gtk.Label(label="Equalizer", xalign=0, hexpand=True)
        title.add_css_class("title")
        self.eq_switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.eq_switch.connect("notify::active", lambda sw, _p: self.syncing_eq or a.set_eq_on(sw.get_active()))
        head.append(title)
        head.append(self.eq_switch)
        box.append(head)

        grid = Gtk.Grid(column_spacing=10, row_spacing=6)
        self.eq_phones = Gtk.DropDown.new_from_strings([name for name, _ in HEADPHONES.values()])
        self.eq_phones.connect("notify::selected", lambda dd, _p: self.syncing_eq
                               or a.set_eq_headphones(list(HEADPHONES)[dd.get_selected()]))
        self.eq_preset = Gtk.DropDown.new_from_strings([name for name, _ in EQ_PRESETS.values()])
        self.eq_preset.connect("notify::selected", lambda dd, _p: self.syncing_eq
                               or a.set_eq_preset(list(EQ_PRESETS)[dd.get_selected()]))
        for row, (label, dd) in enumerate((("Headphones", self.eq_phones), ("Sound", self.eq_preset))):
            name = Gtk.Label(label=label, xalign=0)
            name.add_css_class("sub")
            dd.set_hexpand(True)
            grid.attach(name, 0, row, 1, 1)
            grid.attach(dd, 1, row, 1, 1)
        box.append(grid)

        bands = Gtk.Box(homogeneous=True)
        self.eq_scales, self.eq_values = [], []
        for i, hz in enumerate(EQ_BANDS):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            value = Gtk.Label(width_chars=4)
            value.add_css_class("time")
            sc = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL, inverted=True, draw_value=False,
                           halign=Gtk.Align.CENTER, tooltip_text=f"{hz} Hz")
            sc.add_css_class("volume")
            sc.add_css_class("eqband")
            sc.set_range(-EQ_RANGE, EQ_RANGE)
            sc.set_increments(0.5, 1)
            sc.connect("value-changed", lambda s, i=i: self.syncing_eq or a.set_eq_band(i, s.get_value()))
            reset = Gtk.GestureClick(button=Gdk.BUTTON_MIDDLE)  # middle-click a band: back to 0
            reset.connect("pressed", lambda *_, i=i: a.set_eq_band(i, 0))
            sc.add_controller(reset)
            hz_label = Gtk.Label(label=f"{hz // 1000}k" if hz >= 1000 else str(hz))
            hz_label.add_css_class("hz")
            for w in (value, sc, hz_label):
                col.append(w)
            bands.append(col)
            self.eq_scales.append(sc)
            self.eq_values.append(value)
        box.append(bands)
        self.eq_note = Gtk.Label(xalign=0, wrap=True, max_width_chars=44)
        self.eq_note.add_css_class("sub")
        box.append(self.eq_note)

        pop = Gtk.Popover(child=box)
        pop.connect("closed", lambda *_: a.eq_settled())
        self.eq_btn = Gtk.MenuButton(popover=pop, label="EQ", valign=Gtk.Align.CENTER, direction=Gtk.ArrowType.UP,
                                     tooltip_text="Equalizer (e)")
        self.eq_btn.add_css_class("ctl")
        self.eq_btn.add_css_class("eq-btn")
        self.update_eq()
        return self.eq_btn

    def update_eq(self):
        eq = self.app.eq
        self.syncing_eq = True  # show the settings without the widgets setting them again
        self.eq_switch.set_active(eq["on"])
        self.eq_phones.set_selected(list(HEADPHONES).index(eq["headphones"]))
        self.eq_preset.set_selected(list(EQ_PRESETS).index(eq["preset"]))
        for sc, value, g in zip(self.eq_scales, self.eq_values, eq["bands"]):
            if abs(sc.get_value() - g) > 0.01:
                sc.set_value(g)
            value.set_label(fmt_db(g))
        self.syncing_eq = False
        (self.eq_btn.add_css_class if eq["on"] else self.eq_btn.remove_css_class)("on")
        if eq["on"]:
            pre = self.app.eq_preamp()
            self.eq_note.set_label(f"Pre-gain {fmt_db(pre)} dB so boosts can't clip. Middle-click a band to zero it."
                                   if pre else "Middle-click a band to zero it.")
        else:
            self.eq_note.set_label("Off: the music plays untouched.")

    # ---- tabs & lists ----
    def show_tab(self, key):
        if not self.tab_buttons[key].get_active():
            self.tab_buttons[key].set_active(True)
        self.stack.set_visible_child_name(key)

    def set_empty(self, lst, title, body):
        lst.remove_all()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.add_css_class("empty")
        t = Gtk.Label(label=title)
        t.add_css_class("empty-title")
        b = Gtk.Label(label=body, justify=Gtk.Justification.CENTER, wrap=True)
        box.append(t)
        box.append(b)
        row = Gtk.ListBoxRow(activatable=False, selectable=False, child=box)
        lst.append(row)

    def fill(self, lst, tracks, removable=False, playing=None):
        lst.remove_all()
        for i, t in enumerate(tracks):
            row = TrackRow(self, t, i, removable)
            if playing is not None and i == playing:
                row.add_css_class("playing")
            lst.append(row)

    def section(self, lst, label):
        lab = Gtk.Label(label=label, xalign=0)
        lab.add_css_class("section")
        lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=lab))

    def refresh_count(self):
        n = len(self.lib.items)
        self.count.set_label(f"{n} saved · {self.lib.size_text()}" if n else "")

    def refresh_library(self):
        tracks = self.lib.tracks()
        self.refresh_count()
        lst = self.library_list
        if not tracks:
            self.set_empty(lst, "Nothing saved yet",
                           "Every song you play, and every song in your playlists,\nis saved here in FLAC and plays without data.")
            return
        lst.remove_all()
        playing_id = (self.app.current_track() or {}).get("id")
        for i, t in enumerate(tracks):
            row = TrackRow(self, t, i, removable=True)
            if t["id"] == playing_id:
                row.add_css_class("playing")
            lst.append(row)

    # ---- your YouTube Music library ----
    playlists = None        # your playlists, once loaded
    open_playlist = None    # (playlist, tracks) while one is open

    def refresh_account(self):
        lst = self.account_list
        ytm = self.app.ytm
        if not ytm:
            self.set_empty(lst, "Connecting…", "Reading your YouTube login from the browser.")
            return
        if not ytm.account:
            self.set_empty(lst, "Not signed in",
                           "Sign in at music.youtube.com in Chromium,\nthen reopen Music to see your playlists.")
            return
        if self.open_playlist:
            pl, tracks = self.open_playlist
            lst.remove_all()
            back = Gtk.ListBoxRow(child=Gtk.Label(label=f"‹  {pl['title']}", xalign=0))
            back.add_css_class("back")
            back.account_action = "back"
            lst.append(back)
            if tracks is None:
                self.section(lst, "LOADING…")
                return
            playing_id = (self.app.current_track() or {}).get("id")
            for i, t in enumerate(tracks):
                row = TrackRow(self, t, i)
                if t["id"] == playing_id:
                    row.add_css_class("playing")
                lst.append(row)
            return
        if self.playlists is None:
            self.set_empty(lst, "Loading your library…", "")
            in_thread(ytm.my_playlists, done=self._playlists_loaded)
            self.playlists = []
            return
        lst.remove_all()
        lst.append(self.sync_row())
        if self.app.tidal_link:
            paste = Gtk.Entry(placeholder_text="Paste the “Oops” page address, then Enter")
            paste.add_css_class("search")
            paste.connect("activate", lambda e: e.get_text().strip() and self.app.finish_tidal_login(e.get_text()))
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=paste))
        for pl in self.playlists:
            lst.append(PlaylistRow(self, pl))

    sync_label = None

    def sync_row(self):
        """Tidal and the FLAC sync: connect, or how far it has got."""
        self.sync_label = Gtk.Label(xalign=0, wrap=True)
        self.sync_label.add_css_class("sync")
        row = Gtk.ListBoxRow(child=self.sync_label)
        row.account_action = "tidal"
        self.update_sync()
        return row

    def update_sync(self):
        self.refresh_count()
        if self.sync_label:
            self.sync_label.set_label(self.app.sync_status())

    def _playlists_loaded(self, res, err):
        if err:
            self.playlists = None
            self.set_empty(self.account_list, "Couldn't load your library", str(err)[:120])
            return
        self.playlists = res or []
        self.refresh_account()

    def open_list(self, pl):
        self.open_playlist = (pl, None)
        self.refresh_account()

        def done(res, err):
            if not self.open_playlist or self.open_playlist[0] is not pl:
                return
            if err:
                self.open_playlist = None
                self.toast(f"Couldn't open {pl['title']}: {str(err)[:80]}")
            else:
                self.open_playlist = (pl, res or [])
            self.refresh_account()
        in_thread(self.app.ytm.playlist, pl["id"], done=done)

    def refresh_queue(self):
        q, i = self.app.queue, self.app.index
        if not q:
            self.set_empty(self.queue_list, "Queue is empty", "Pick a song and a radio of similar songs follows it.")
            return
        self.fill(self.queue_list, q, playing=i)

    def refresh_results(self):
        if self.results:
            self.fill(self.search_list, self.results)

    def refresh_all(self):
        self.refresh_library()
        if self.open_playlist and self.open_playlist[1] is not None:
            self.refresh_account()
        self.refresh_queue()
        self.refresh_results()

    def on_row(self, key, row):
        if getattr(row, "account_action", None) == "back":
            self.open_playlist = None
            self.refresh_account()
            return
        if getattr(row, "account_action", None) == "tidal":
            self.app.connect_tidal()
            return
        if isinstance(row, PlaylistRow):
            self.open_list(row.playlist)
            return
        if not isinstance(row, TrackRow):
            return
        if key == "search":
            self.app.play_from(self.results, row.index, radio=len(self.results) > 1 and not self.results_is_list)
        elif key == "library":
            self.app.play_from(self.lib.tracks(), row.index, radio=False)
        elif key == "account" and self.open_playlist:
            self.app.play_from(self.open_playlist[1], row.index, radio=False)
        else:
            self.app.play_index(row.index)

    # ---- search ----
    results_is_list = False

    def on_search_changed(self, entry):
        if entry.get_text().strip():
            self.show_tab("search")

    def search(self):
        q = self.entry.get_text().strip()
        if not q:
            return
        if not self.app.ytm:
            self.toast("Still connecting to YouTube Music…")
            return
        self.show_tab("search")
        self.search_seq += 1
        seq = self.search_seq
        self.set_empty(self.search_list, "Searching…", q)
        self.results_is_list = "list=" in q

        def done(res, err):
            if seq != self.search_seq:
                return
            if err:
                self.set_empty(self.search_list, "Search failed", "Offline? Downloaded songs still play.\n" + str(err)[:120])
                return
            self.results = res or []
            if not self.results:
                self.set_empty(self.search_list, "No songs found", q)
            else:
                self.refresh_results()
        in_thread(self.app.ytm.search, q, done=done)

    # ---- actions ----
    def download_only(self, track):
        self.dl.fetch(track, lambda _p, err: (self.toast(f"Download failed: {err}") if err else None, self.refresh_all()))
        self.refresh_all()

    def remove_download(self, vid):
        cur = self.app.current_track()
        if cur and cur["id"] == vid:
            self.toast("That song is playing; skip it first")
            return
        self.lib.remove(vid)
        self.refresh_all()

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    # ---- now playing ----
    def update_now_playing(self):
        a = self.app
        t = a.current_track()
        if not t:
            return
        self.np_title.set_label(t["title"])
        self.np_sub.set_label(t["artist"] + (f" · {t['album']}" if t.get("album") else ""))
        self.np_art.clear()
        self.art.apply(self.np_art, t)
        self.play_btn.set_icon_name("media-playback-start-symbolic" if a.paused else "media-playback-pause-symbolic")
        saved = self.lib.items.get(t["id"]) if self.lib.has(t["id"]) else None
        flac = bool(saved) and saved.get("format") == "flac"
        self.saved_label.set_label("FLAC" if flac else "✓ offline" if saved else "")
        self.saved_label.set_tooltip_text(f"FLAC {saved.get('quality', '')} on disk: plays without data" if flac
                                          else "Saved on disk: plays without data" if saved else None)
        self.update_like()

    def update_like(self):
        t = self.app.current_track()
        liked = bool(t) and t["id"] in self.app.liked
        self.like_btn.set_visible(bool(t) and bool(self.app.ytm and self.app.ytm.account))
        self.like_btn.get_child().set_label("󰋑" if liked else "󰋕")
        (self.like_btn.add_css_class if liked else self.like_btn.remove_css_class)("liked")
        self.like_btn.set_tooltip_text(("Unlike" if liked else "Like on YouTube Music") + " (l)")

    def update_repeat(self):
        mode = self.app.repeat
        self.repeat_btn.set_icon_name("media-playlist-repeat-song-symbolic" if mode == "one"
                                      else "media-playlist-repeat-symbolic")
        (self.repeat_btn.add_css_class if mode != "off" else self.repeat_btn.remove_css_class)("on")
        self.repeat_btn.set_tooltip_text({"off": "Repeat: off", "all": "Repeat: all",
                                          "one": "Repeat: this song"}[mode] + " (r)")

    def set_status(self, text):
        self.np_status.set_label(text or "")
        self.np_status.set_visible(bool(text))

    def update_position(self, pos, dur):
        if time.monotonic() < self.dragging_until:
            return
        self.scale.set_range(0, max(dur or 1, 1))
        self.scale.set_value(pos or 0)
        self.t_pos.set_label(fmt_time(pos))
        self.t_len.set_label(fmt_time(dur))

    def on_seek(self, _scale, _scroll, value):
        self.dragging_until = time.monotonic() + 0.4
        self.t_pos.set_label(fmt_time(value))
        self.app.player.seek(value)
        return False

    def on_key(self, _ctl, keyval, _code, state):
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        if keyval == Gdk.KEY_Escape:
            self.set_visible(False)
            return True
        if ctrl and keyval == Gdk.KEY_q:
            self.app.quit_app()
            return True
        if ctrl and keyval in (Gdk.KEY_f, Gdk.KEY_l):
            self.entry.grab_focus()
            return True
        if state & Gdk.ModifierType.ALT_MASK and Gdk.KEY_1 <= keyval <= Gdk.KEY_4:
            self.show_tab(list(self.tab_buttons)[keyval - Gdk.KEY_1])
            return True
        focus = self.get_focus()
        if focus and (focus == self.entry or focus.is_ancestor(self.entry)):
            return False
        if keyval == Gdk.KEY_space:
            self.app.toggle_pause()
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_n):
            self.app.next()
            return True
        if keyval in (Gdk.KEY_Left, Gdk.KEY_p):
            self.app.previous()
            return True
        if keyval == Gdk.KEY_slash:
            self.entry.grab_focus()
            return True
        if keyval == Gdk.KEY_r:
            self.app.cycle_repeat()
            return True
        if keyval == Gdk.KEY_l:
            self.app.toggle_like()
            return True
        if keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.app.set_volume(self.app.volume + 5)
            return True
        if keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.app.set_volume(self.app.volume - 5)
            return True
        if keyval == Gdk.KEY_m:
            self.app.toggle_mute()
            return True
        if keyval == Gdk.KEY_e:
            self.eq_btn.popup()
            return True
        return False


class MusicApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.win = None
        self.provider = None
        self.ytm = None
        self.queue, self.index = [], -1
        self.paused, self.position, self.duration = True, 0.0, 0.0
        self.radio_from = None
        self.repeat = "off"     # off | all | one
        self.liked = set()      # your liked songs on YouTube Music
        self.load_seq = 0
        self.volume, self.muted = 100.0, False
        self.eq = json.loads(json.dumps(EQ_DEFAULT))
        self.eq_synced = True   # mpv's filter graph matches self.eq, not just its running gains
        self.tidal_error = None
        self.tidal_link = None  # the page to approve the Tidal login on, while connecting
        self.syncing = False
        self.sync_tracks = []   # every song in your YouTube Music library

    # ---- lifecycle ----
    def do_startup(self):
        Adw.Application.do_startup(self)
        self.hold()  # keep playing with the window hidden
        self.lib = Library()
        self.dl = Downloader(self.lib)
        self.art = ArtCache(self.lib)
        self.player = Player(self.on_mpv)
        self.mpris = Mpris(self)
        self.reload_theme()
        self.watch_theme()
        state = read_json(STATE, {})
        self.queue = [t for t in state.get("queue", []) if isinstance(t, dict) and t.get("id")]
        self.index = min(state.get("index", -1), len(self.queue) - 1)
        self.radio_from = state.get("radio_from")
        self.repeat = state.get("repeat") if state.get("repeat") in ("off", "all", "one") else "off"
        self.volume = max(0.0, min(100.0, float(state.get("volume", 100))))
        self.muted = bool(state.get("muted", False))
        self.player.set_volume(self.volume, self.muted)
        self.load_eq(state.get("eq") or {})
        if self.current_track():
            self.load_current(autoplay=False)

        def connected(ytm, err):
            self.ytm = ytm
            if ytm and self.win:
                self.win.refresh_account()
            if ytm and ytm.account:
                in_thread(ytm.liked_ids, done=got_likes)
                self.sync_library()

        def got_likes(ids, err):
            if ids:
                self.liked = ids
            if self.win:
                self.win.update_like()

        def tidal_ready(tidal, err):
            self.dl.tidal, self.tidal_error = tidal, err
            if self.win:
                self.win.refresh_account()
            self.sync_library()
        in_thread(YTM, done=connected)
        in_thread(Tidal, done=tidal_ready)
        GLib.timeout_add_seconds(SYNC_EVERY, lambda: (self.sync_library(), True)[1])

    def do_activate(self):
        if not self.win:
            self.win = MusicWindow(self)
            self.win.update_now_playing()
            self.win.update_position(self.position, self.duration or (self.current_track() or {}).get("duration"))
            self.win.present()
            self.win.entry.grab_focus()
            return
        if self.win.get_visible():  # bar icon / keybind toggle the dropdown
            self.win.set_visible(False)
        else:
            self.show_window()

    def show_window(self):
        if self.win:
            self.win.present()
            self.win.entry.grab_focus()

    def quit_app(self):
        self.save_state()
        self.player.quit()
        self.quit()

    def save_state(self):
        write_atomic(STATE, json.dumps({"queue": self.queue, "index": self.index, "radio_from": self.radio_from,
                                       "repeat": self.repeat, "volume": self.volume, "muted": self.muted,
                                       "eq": self.eq}))

    def save_soon(self):
        """Remember the settings, without a disk write per scroll step or slider move."""
        if getattr(self, "_save_timer", 0):
            GLib.source_remove(self._save_timer)
        self._save_timer = GLib.timeout_add(800, lambda: (setattr(self, "_save_timer", 0), self.save_state(), False)[2])

    # ---- theme ----
    def reload_theme(self):
        theme = load_theme()
        provider = Gtk.CssProvider()
        provider.load_from_string(theme_css(theme))
        display = Gdk.Display.get_default()
        if display:
            if self.provider:
                Gtk.StyleContext.remove_provider_for_display(display, self.provider)
            Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.provider = provider
        Adw.StyleManager.get_default().set_color_scheme(
            Adw.ColorScheme.FORCE_LIGHT if theme["c"].get("mode") == "light" else Adw.ColorScheme.FORCE_DARK)

    def watch_theme(self):
        self.monitors, self._theme_timer = [], 0
        for path in (CURRENT, THEME_DIR):
            try:
                mon = Gio.File.new_for_path(str(path)).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
                mon.connect("changed", lambda *_: self._debounce_theme())
                self.monitors.append(mon)
            except GLib.Error:
                pass

    def _debounce_theme(self):
        if self._theme_timer:
            GLib.source_remove(self._theme_timer)
        self._theme_timer = GLib.timeout_add(400, lambda: (setattr(self, "_theme_timer", 0), self.reload_theme(), False)[2])

    # ---- Tidal and the FLAC sync of your whole library ----
    def connect_tidal(self):
        """Open Tidal's sign-in page; the Library tab then asks for the address it ends on."""
        tidal = self.dl.tidal
        if not tidal or tidal.connected:
            return
        self.tidal_link = self.tidal_link or tidal.login_url()
        try:
            Gio.AppInfo.launch_default_for_uri(self.tidal_link, None)
        except GLib.Error:
            Gdk.Display.get_default().get_clipboard().set_content(Gdk.ContentProvider.new_for_value(self.tidal_link))
            if self.win:
                self.win.toast("Couldn't open a browser; the sign-in link is copied")
        if self.win:
            self.win.refresh_account()

    def finish_tidal_login(self, oops_url):
        def done(_res, err):
            if err:
                if self.win:
                    self.win.toast(f"Tidal didn't accept that: {str(err)[:80]}")
                return
            self.tidal_link = None
            if self.win:
                self.win.refresh_account()
                self.win.toast("Tidal connected: downloading your music in FLAC")
            self.sync_library()
        in_thread(self.dl.tidal.finish_login, oops_url, done=done)

    def sync_library(self):
        """Download every song in your playlists and liked songs in FLAC, and
        replace songs saved lossy before."""
        if self.syncing or not (self.ytm and self.ytm.account and self.dl.tidal and self.dl.tidal.connected):
            return
        self.syncing = True
        self.update_sync()
        lossy = self.lib.lossy()

        def work():
            tracks = self.ytm.library_tracks()
            GLib.idle_add(lambda: (setattr(self, "sync_tracks", tracks), self.update_sync(), False)[2])
            ids = {t["id"] for t in tracks}
            self.dl.sync(tracks + [t for t in lossy if t["id"] not in ids], self.update_sync)

        def done(_res, err):
            self.syncing = False
            self.update_sync()
            if err and self.win:
                self.win.toast(f"FLAC sync stopped: {str(err)[:80]}")
            if self.win:
                self.win.refresh_all()
        in_thread(work, done=done)

    def sync_status(self):
        tidal = self.dl.tidal
        if not tidal:
            return f"Tidal isn't available: {str(self.tidal_error)[:80]}" if self.tidal_error else "Connecting to Tidal…"
        if not tidal.connected:
            return ("Sign in on the Tidal page that opened. It ends on an “Oops” page:\n"
                    "copy that page's address and paste it below." if self.tidal_link
                    else "Connect Tidal to download your music in FLAC  ›")
        tracks = self.sync_tracks
        if not tracks:
            return "FLAC · reading your playlists…" if self.syncing else "FLAC · Tidal connected"
        flac = sum(self.lib.is_flac(t["id"]) for t in tracks)
        missing = sum(self.lib.recently_missing(t["id"]) and not self.lib.is_flac(t["id"]) for t in tracks)
        text = f"FLAC · {flac} of {len(tracks)} songs saved"
        if missing:
            text += f" · {missing} not on Tidal"
        return text + (" · downloading…" if self.syncing else "")

    def update_sync(self):
        if self.win:
            self.win.update_sync()

    # ---- queue ----
    def current_track(self):
        return self.queue[self.index] if 0 <= self.index < len(self.queue) else None

    def play_from(self, tracks, i, radio):
        self.queue = list(tracks)
        self.index = i
        self.radio_from = None
        self.load_current()
        if radio:
            self.extend_radio(self.queue[i]["id"], keep_until=i)

    def extend_radio(self, vid, keep_until=None):
        if not self.ytm:
            return
        self.radio_from = vid

        def done(res, err):
            if err or not res:
                return
            have = {t["id"] for t in self.queue}
            if keep_until is not None:
                # A song picked from results: its radio replaces the rest of the results.
                self.queue = self.queue[:keep_until + 1]
                have = {t["id"] for t in self.queue}
            self.queue += [t for t in res if t["id"] not in have]
            self.after_queue_change()
        in_thread(self.ytm.radio, vid, done=done)

    def play_index(self, i):
        if 0 <= i < len(self.queue):
            self.index = i
            self.load_current()

    def next(self):
        if self.index + 1 < len(self.queue):
            self.index += 1
            self.load_current()
        elif self.repeat == "all" and self.queue:
            self.index = 0
            self.load_current()
        else:
            self.set_paused(True)

    def track_ended(self):
        if self.repeat == "one":
            self.load_current()
        else:
            self.next()

    def cycle_repeat(self):
        self.repeat = {"off": "all", "all": "one", "one": "off"}[self.repeat]
        self.save_state()
        self.mpris.changed()
        if self.win:
            self.win.update_repeat()

    def toggle_like(self):
        t = self.current_track()
        if not t or not (self.ytm and self.ytm.account):
            return
        vid, like = t["id"], t["id"] not in self.liked
        (self.liked.add if like else self.liked.discard)(vid)  # show it now; undo if YouTube refuses

        def done(_res, err):
            if err:
                (self.liked.discard if like else self.liked.add)(vid)
                if self.win:
                    self.win.toast(f"Couldn't {'like' if like else 'unlike'} it: {str(err)[:80]}")
            if self.win:
                self.win.update_like()
        if self.win:
            self.win.update_like()
        in_thread(self.ytm.rate, vid, like, done=done)

    def previous(self):
        if self.position > 4 or self.index <= 0:
            self.player.seek(0)
        else:
            self.index -= 1
            self.load_current()

    def shuffle(self):
        rest = self.queue[self.index + 1:]
        random.shuffle(rest)
        self.queue = self.queue[:self.index + 1] + rest
        self.after_queue_change()

    def after_queue_change(self):
        self.save_state()
        self.prefetch()
        if self.win:
            self.win.refresh_queue()

    def load_current(self, autoplay=True):
        t = self.current_track()
        if not t:
            return
        self.load_seq += 1
        seq = self.load_seq
        self.position, self.duration = 0.0, t.get("duration") or 0
        if self.win:
            self.win.update_now_playing()
            self.win.update_position(0, self.duration)
            self.win.set_status("" if self.lib.has(t["id"]) else "Downloading FLAC…")
            self.win.refresh_queue()

        def ready(path, err):
            if seq != self.load_seq:
                return  # user moved on while it downloaded
            if err:
                if self.win:
                    self.win.set_status("")
                    self.win.toast(f"Skipped “{t['title']}”: {err}" if isinstance(err, NoLosslessMatch)
                                   else f"Couldn't get “{t['title']}”: {err}")
                GLib.timeout_add(1500, lambda: (seq == self.load_seq and self.next(), False)[1])
                return
            if self.win:
                self.win.set_status("")
            self.player.load(path, paused=not autoplay)
            self.paused = not autoplay
            if autoplay:
                self.lib.played(t["id"])
            if self.win:
                self.win.refresh_all()
                self.win.update_now_playing()
            self.mpris.changed()
            self.prefetch()
        self.dl.fetch(t, ready)
        self.save_state()
        # Keep a radio going: near the end of the queue, ask for more like the last song.
        if self.radio_from and self.index >= len(self.queue) - 2:
            self.extend_radio(self.queue[-1]["id"])

    def prefetch(self):
        nxt = self.queue[self.index + 1] if self.index + 1 < len(self.queue) else None
        if nxt and not self.lib.has(nxt["id"]):
            self.dl.fetch(nxt, lambda *_: self.win and self.win.refresh_all())

    # ---- playback ----
    def toggle_pause(self):
        if not self.current_track():
            return
        self.set_paused(not self.paused)

    def set_paused(self, paused):
        self.player.set_pause(paused)

    def set_volume(self, volume):
        volume = round(max(0.0, min(100.0, volume)))
        if volume == self.volume and not self.muted:
            return
        self.volume, self.muted = volume, False
        self.volume_changed()

    def toggle_mute(self):
        self.muted = not self.muted
        self.volume_changed()

    def volume_changed(self):
        self.player.set_volume(self.volume, self.muted)
        self.mpris.changed()
        if self.win:
            self.win.update_volume()
        self.save_soon()

    # ---- equalizer ----
    def load_eq(self, saved):
        eq = self.eq
        if saved.get("headphones") in HEADPHONES:
            eq["headphones"] = saved["headphones"]
        if saved.get("preset") in EQ_PRESETS:
            eq["preset"] = saved["preset"]
        for key in ("bands", "custom"):
            vals = saved.get(key)
            if isinstance(vals, list) and len(vals) == len(EQ_BANDS):
                eq[key] = [max(-EQ_RANGE, min(EQ_RANGE, float(g))) for g in vals]
        eq["on"] = bool(saved.get("on"))
        if eq["on"]:
            self.apply_eq()

    def eq_correction(self):
        return HEADPHONES[self.eq["headphones"]][1]

    def eq_preamp(self):
        return eq_preamp([*self.eq_correction(), *(("pk", hz, g, EQ_Q) for hz, g in zip(EQ_BANDS, self.eq["bands"]))])

    def apply_eq(self):
        """(Re)build mpv's filters from the settings; the music skips a beat."""
        self.player.set_filters(eq_graph(self.eq_correction(), self.eq["bands"], self.eq_preamp())
                                if self.eq["on"] else "")
        self.eq_synced = True

    def retune_eq(self):
        """Set the bands and pre-gain in the running filters, without a gap. mpv
        rebuilds its filters from the graph on a seek or a new song, so eq_settled
        rebuilds that too once you're done adjusting."""
        for i, g in enumerate(self.eq["bands"]):
            self.player.filter_cmd("g", g, f"equalizer@g{i}")
        self.player.filter_cmd("volume", f"{self.eq_preamp()}dB", "volume@pre")
        self.eq_synced = False

    def eq_settled(self):
        if not self.eq_synced:
            self.apply_eq()

    def eq_changed(self, rebuild=False):
        if rebuild or not self.eq["on"]:
            self.eq["on"] = True
            self.apply_eq()
        else:
            self.retune_eq()
        if self.win:
            self.win.update_eq()
        self.save_soon()

    def set_eq_on(self, on):
        if on != self.eq["on"]:
            self.eq["on"] = on
            self.apply_eq()
            if self.win:
                self.win.update_eq()
            self.save_soon()

    def set_eq_headphones(self, key):
        if key != self.eq["headphones"]:
            self.eq["headphones"] = key
            self.eq_changed(rebuild=True)  # a different set of filters

    def set_eq_preset(self, key):
        bands = EQ_PRESETS[key][1] or self.eq["custom"]
        self.eq["preset"], self.eq["bands"] = key, [float(g) for g in bands]
        self.eq_changed()

    def set_eq_band(self, i, gain):
        gain = round(max(-EQ_RANGE, min(EQ_RANGE, gain)) * 2) / 2
        if gain == self.eq["bands"][i] and self.eq["on"]:
            return
        self.eq["bands"][i] = gain
        self.eq["custom"] = list(self.eq["bands"])
        self.eq["preset"] = "custom"
        self.eq_changed()

    def on_mpv(self, msg):
        ev = msg.get("event")
        if ev == "property-change":
            name, data = msg.get("name"), msg.get("data")
            if name == "time-pos" and data is not None:
                if abs(data - self.position) >= 0.25 or data < self.position:
                    self.position = data
                    if self.win:
                        self.win.update_position(self.position, self.duration)
            elif name == "duration" and data:
                self.duration = data
            elif name == "pause" and data is not None:
                self.paused = bool(data)
                if self.win:
                    self.win.update_now_playing()
                self.mpris.changed()
        elif ev == "playback-restart" and not self.eq_synced:
            self.retune_eq()  # a seek or new song rebuilt the filters from the graph, before the latest tweaks
        elif ev == "end-file" and msg.get("reason") == "eof":
            self.track_ended()


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    if "--tidal-login" in sys.argv:
        tidal = Tidal()
        if not tidal.connected:
            print("Sign in to Tidal on this page; it ends on an \"Oops\" page:", tidal.login_url(), sep="\n", flush=True)
            tidal.finish_login(input("Paste the address of that \"Oops\" page: "))
        print("Tidal is connected.")
        return 0
    app = MusicApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
