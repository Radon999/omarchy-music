# Last.fm: scrobbles (what you listened to: your stats there, and Wrapped),
# and the like heart loves the song there too
# =============================================================================

LASTFM = STATE_DIR / "omarchy-music-lastfm.json"                  # API account + login, mode 600
SCROBBLES = HOME / ".local" / "state" / f"omarchy-music{SUFFIX}-scrobbles.json"    # waiting for the network
LASTFM_API = "https://ws.audioscrobbler.com/2.0/"


class LastFMError(RuntimeError):
    def __init__(self, code, message):
        super().__init__(f"Last.fm: {message} ({code})")
        self.code = code


def write_private(path, text):
    """write_atomic, readable by you alone (it holds logins)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


class LastFM:
    """Your Last.fm account. Last.fm lets an app in only with an API account of
    its own: you make one (free, a minute) at last.fm/api/account/create and give
    the app its key and secret, then approve the app on Last.fm's site."""

    def __init__(self):
        self.reload()
        self.token = None          # while you approve the app on Last.fm
        self.pending = read_json(SCROBBLES, [])
        self.lock = threading.Lock()
        self.send_lock = threading.Lock()

    def reload(self):
        """The saved login (again, after --lastfm-login in a terminal)."""
        saved = read_json(LASTFM, {})
        self.key, self.secret = saved.get("key", ""), saved.get("secret", "")
        self.session, self.user = saved.get("session", ""), saved.get("user", "")

    @property
    def connected(self):
        return bool(self.key and self.secret and self.session)

    def _save(self):
        write_private(LASTFM, json.dumps({"key": self.key, "secret": self.secret, "session": self.session,
                                          "user": self.user}))

    def call(self, method, signed=False, post=False, **params):
        params = {k: str(v) for k, v in params.items() if v not in (None, "")}
        params.update(method=method, api_key=self.key)
        if signed:
            if self.session and not method.startswith("auth."):
                params["sk"] = self.session
            params["api_sig"] = hashlib.md5(("".join(k + params[k] for k in sorted(params)) + self.secret)
                                            .encode()).hexdigest()
        params["format"] = "json"
        body = urllib.parse.urlencode(params)
        hdr = {"User-Agent": APP_UA}
        try:
            if post:
                res = http_json(LASTFM_API, hdr | {"Content-Type": "application/x-www-form-urlencoded"},
                                body.encode(), "POST")
            else:
                res = http_json(f"{LASTFM_API}?{body}", hdr)
        except urllib.error.HTTPError as e:   # Last.fm explains what went wrong in the body
            try:
                res = json.loads(e.read())
            except ValueError:
                raise e from None
        if isinstance(res, dict) and "error" in res:
            raise LastFMError(res["error"], res.get("message", ""))
        return res

    # ---- connecting ----
    def set_account(self, key, secret):
        self.key, self.secret = key.strip(), secret.strip()
        self.session = self.user = ""
        self._save()

    def auth_url(self):
        """Connecting, step 1: the page to approve the app on."""
        self.token = self.call("auth.getToken", signed=True)["token"]
        return f"https://www.last.fm/api/auth/?api_key={self.key}&token={self.token}"

    def finish_auth(self):
        """Step 2, once you approved it; raises LastFMError 14 until you have."""
        s = self.call("auth.getSession", signed=True, token=self.token)["session"]
        self.session, self.user, self.token = s["key"], s["name"], None
        self._save()

    def disconnect(self):
        self.session = self.user = ""
        self._save()

    # ---- scrobbling ----
    @staticmethod
    def _song(m, i=None):
        n = "" if i is None else f"[{i}]"
        return {f"artist{n}": m["artist"], f"track{n}": m["title"], f"album{n}": m.get("album"),
                f"albumArtist{n}": m.get("albumartist"), f"duration{n}": int(m.get("duration") or 0) or None,
                f"mbid{n}": m.get("mbid")}

    def now_playing(self, m):
        self.call("track.updateNowPlaying", signed=True, post=True, **self._song(m))

    def scrobble(self, m, when):
        keep = {k: m.get(k) for k in ("artist", "title", "album", "albumartist", "duration", "mbid")}
        with self.lock:
            self.pending.append(keep | {"timestamp": int(when)})
            write_atomic(SCROBBLES, json.dumps(self.pending))
        self.flush()

    def flush(self):
        """Send the scrobbles waiting, 50 at a time; offline, they wait for next
        time (for the two weeks Last.fm still takes them)."""
        if not self.connected:
            return
        with self.send_lock:
            with self.lock:
                fresh = [s for s in self.pending if s["timestamp"] > time.time() - 14 * 86400 + 3600]
                if len(fresh) != len(self.pending):
                    self.pending = fresh
                    write_atomic(SCROBBLES, json.dumps(fresh))
            while True:
                with self.lock:
                    batch = self.pending[:50]
                if not batch:
                    return
                params = {}
                for i, s in enumerate(batch):
                    params |= self._song(s, i) | {f"timestamp[{i}]": s["timestamp"]}
                try:
                    self.call("track.scrobble", signed=True, post=True, **params)
                except LastFMError as e:
                    if e.code != 6:   # 6: Last.fm won't take these at all; drop them, not the rest
                        raise
                with self.lock:
                    self.pending = self.pending[len(batch):]
                    write_atomic(SCROBBLES, json.dumps(self.pending))

    def love(self, m, on):
        self.call("track.love" if on else "track.unlove", signed=True, post=True, artist=m["artist"], track=m["title"])

    # ---- your history, for Wrapped ----
    def recent(self, start, end, progress=None):
        """Every scrobble from start to end (unix times): [(time, artist, title, album, image)]."""
        out, page, pages = [], 1, 1
        while page <= pages:
            rt = self.call("user.getRecentTracks", user=self.user, limit=200, page=page,
                           **{"from": int(start), "to": int(end)}).get("recenttracks") or {}
            pages = int((rt.get("@attr") or {}).get("totalPages") or 1)
            tracks = rt.get("track") or []
            for t in [tracks] if isinstance(tracks, dict) else tracks:
                if not t.get("date"):    # the song playing right now
                    continue
                img = next((i["#text"] for i in reversed(t.get("image") or []) if i.get("#text")), "")
                out.append((int(t["date"]["uts"]), t["artist"]["#text"], t["name"],
                            (t.get("album") or {}).get("#text", ""), img))
            if progress:
                progress(page, pages)
            page += 1
        return out

    def duration(self, artist, title):
        t = self.call("track.getInfo", artist=artist, track=title, autocorrect=1).get("track") or {}
        return int(t.get("duration") or 0) / 1000

    def artist_tags(self, artist):
        tags = (self.call("artist.getTopTags", artist=artist, autocorrect=1).get("toptags") or {}).get("tag") or []
        return [(t["name"], int(t.get("count") or 0)) for t in tags[:12]]

    def info(self):
        """Your profile: {"registered": unix time, "playcount": all your scrobbles, ...}."""
        u = self.call("user.getInfo", user=self.user).get("user") or {}
        reg = u.get("registered") or {}
        return {"name": u.get("name") or self.user, "playcount": int(u.get("playcount") or 0),
                "registered": int(reg.get("unixtime") or reg.get("#text") or 0),
                "image": next((i["#text"] for i in reversed(u.get("image") or []) if i.get("#text")), "")}

    def count(self, start, end):
        """How many scrobbles you have from start to end (one quick request)."""
        rt = self.call("user.getRecentTracks", user=self.user, limit=1, **{"from": int(start), "to": int(end)})
        return int(((rt.get("recenttracks") or {}).get("@attr") or {}).get("total") or 0)

    def top(self, kind, limit=10, period="overall"):
        """Your all-time (or period's) top artists, tracks or albums: [(name, artist, plays, image)]."""
        res = self.call(f"user.getTop{kind.title()}s", user=self.user, period=period, limit=limit)
        items = (res.get(f"top{kind}s") or {}).get(kind) or []
        out = []
        for x in [items] if isinstance(items, dict) else items:
            artist = x.get("artist") or {}
            img = next((i["#text"] for i in reversed(x.get("image") or []) if i.get("#text")), "")
            out.append((x.get("name") or "", artist.get("name", "") if isinstance(artist, dict) else "",
                        int(x.get("playcount") or 0), img))
        return out


# =============================================================================
# DJ, like Spotify's: what you play most, songs you haven't heard in a while and
# new ones, in sets of a few songs, each begun with a line from the DJ. Your
# history is Last.fm (when it's connected) and what you play here; the new songs
# come from Tidal's and YouTube Music's radios. "Switch it up" starts another
# kind of set, and you can ask for one: a mood, a decade, a genre or an artist.
# =============================================================================
DJ_SET = 6   # songs in a set
DJ_ORDER = ("repeat", "fresh", "throwback", "deep", "fresh", "genre", "like")
# Playing from songs you picked (a playlist, a folder, an album): sets of only those.
DJ_FROM_ORDER = ("loved", "unplayed", "artist", "throwback", "mix")
DJ_KINDS = {"repeat": "On repeat", "fresh": "New for you", "throwback": "Throwback", "deep": "Deep cuts",
            "genre": "Your genre", "like": "More like this", "ask": "You asked", "loved": "Your favourites",
            "unplayed": "Not played yet", "artist": "One artist", "mix": "Mix"}
# Words in a request and the Last.fm tags they mean.
DJ_MOODS = {
    "chill": ("chill", "chillout"), "chilled": ("chill", "chillout"), "relax": ("chill", "relaxing"),
    "relaxing": ("relaxing", "chill"), "calm": ("calm", "chill"), "study": ("study", "chill"),
    "studying": ("study", "chill"), "focus": ("focus", "instrumental"), "work": ("focus", "chill"),
    "sleep": ("sleep", "ambient"), "lofi": ("lo-fi",), "sad": ("sad", "melancholic"), "happy": ("happy", "feel good"),
    "upbeat": ("upbeat", "happy"), "hype": ("energetic", "hype"), "energy": ("energetic",),
    "workout": ("workout", "energetic"), "gym": ("workout", "energetic"), "running": ("running", "workout"),
    "party": ("party", "dance"), "dance": ("dance",), "love": ("love", "romantic"), "romantic": ("romantic", "love"),
    "angry": ("aggressive",), "rainy": ("rainy day", "chill"), "summer": ("summer",), "driving": ("driving",),
    "drive": ("driving",), "night": ("night", "late night"), "morning": ("morning",),
}
# Tags that say nothing about how a song sounds.
DJ_JUNK_TAGS = {"seen live", "favorites", "favourites", "favorite", "favourite", "albums i own", "under 2000 listeners",
                "spotify", "youtube", "male vocalists", "female vocalists", "american", "british", "usa", "uk"}
DJ_FILLER = {"play", "some", "something", "songs", "song", "music", "me", "for", "a", "the", "please", "mix", "of",
             "like", "more", "vibes", "vibe", "tunes", "stuff", "give", "i", "want", "to", "listen", "put", "on", "and"}


def dj_tags(text):
    """The Last.fm tags a request means: its mood words, its decade ("80s", "2010s"), else the
    request itself as a genre ("house", "k-pop")."""
    every = re.findall(r"[\w'-]+", text.lower())
    words = [w for w in every if w not in DJ_FILLER]
    tags = []
    for w in words:
        if re.fullmatch(r"(19|20)?\d0s", w):
            tags.append(w)   # "80s", "1980s", "2010s"
        tags.extend(DJ_MOODS.get(w, ()))
    while every and every[0] in DJ_FILLER:   # "play some drum and bass music": "drum and bass"
        every.pop(0)
    while every and every[-1] in DJ_FILLER:
        every.pop()
    if not tags and every:
        tags.append(" ".join(every))
    return list(dict.fromkeys(tags))


def dj_pick(pool, n, used, rng=random):
    """n songs of pool at random, the ones nearer the top likelier, none twice and none in used
    (song keys of what the DJ played already)."""
    seen, out = set(used), []
    weighted = [(rng.random() ** (1 + 8 * i / max(1, len(pool))), t) for i, t in enumerate(pool)]
    for _w, t in sorted(weighted, key=lambda x: -x[0]):
        k = song_key(t)
        if k in seen:
            continue
        seen.add(k)
        out.append(t)
        if len(out) == n:
            break
    return out


def dj_names(tracks, n=2):
    """ "A and B": the lead artists of tracks, each once."""
    names = list(dict.fromkeys((t.get("artist") or "").split(",")[0].strip() for t in tracks if t.get("artist")))[:n]
    return " and ".join(names) if len(names) < 3 else ", ".join(names[:-1]) + " and " + names[-1]


class DJ:
    """The DJ's sets. Building a set blocks (run it in a thread); the app plays them."""

    def __init__(self, app):
        self.app = app
        self.taste_at, self.taste = 0, None
        self.used = set()      # song keys the DJ has played this session
        self.step = 0          # where in DJ_ORDER (or DJ_FROM_ORDER) the next set comes from
        self.scope = None      # (name, songs): what the DJ plays from; None: everything

    def play_from(self, name, songs):
        """Play only songs (named name: a playlist, a folder), or with None everything."""
        self.scope = (name, [dict(t) for t in songs]) if songs else None
        self.step = 0

    # ---- what you like ----
    def load_taste(self):
        """(blocking) Your history, asked of Last.fm at most every ten minutes."""
        if self.taste and time.time() - self.taste_at < 600:
            return self.taste
        a = self.app
        mine = {}
        for t in [e["track"] for e in a.plays.items.values()] + a.my_songs():
            mine[song_key(t)] = t
        taste = {"mine": mine, "recent": [], "all": [], "artists": []}
        if a.lastfm.connected:
            def songs(rows):
                return [dict(a.fm_song(name, artist, img, mine), plays=n) for name, artist, n, img in rows]
            try:
                taste["recent"] = songs(a.lastfm.top("track", 50, "1month"))
                taste["all"] = songs(a.lastfm.top("track", 200, "overall"))
                taste["artists"] = [name for name, _a, _n, _i in a.lastfm.top("artist", 20, "3month")]
            except Exception:  # noqa: BLE001 -- what you played here, then
                pass
        now = time.time()
        rows = list(a.plays.items.values())
        if not taste["recent"]:
            taste["recent"] = [dict(e["track"], plays=e["plays"]) for e in sorted(
                (e for e in rows if now - e.get("last", 0) < 30 * 86400), key=lambda e: -e.get("plays", 0))[:50]]
        if not taste["all"]:
            taste["all"] = [dict(e["track"], plays=e["plays"]) for e in sorted(rows, key=lambda e: -e.get("plays", 0))[:200]]
        if not taste["artists"]:
            count = Counter((t.get("artist") or "").split(",")[0].strip() for t in taste["recent"] + taste["all"])
            taste["artists"] = [n for n, _c in count.most_common(20) if n]
        taste["last"] = {song_key(e["track"]): e.get("last", 0) for e in rows}
        self.taste, self.taste_at = taste, time.time()
        return taste

    def known(self, taste):
        return set(taste["mine"]) | {song_key(t) for t in taste["all"]} | set(taste["last"])

    def radio(self, seed, key):
        src = self.app.sources.get(key)
        if not src or (key == "tidal" and not src.signed_in):
            return []
        try:
            return src.radio(seed)
        except Exception:  # noqa: BLE001 -- the other service, then
            return []

    def services(self):
        """The services new songs come from: Tidal and YouTube Music both, when both are there."""
        tidal = self.app.sources.get("tidal")
        return (["tidal"] if tidal and tidal.signed_in else []) + ["ytm"]

    # ---- the kinds of set: each gives (songs, line) or None ----
    def set_repeat(self, taste, first):
        songs = dj_pick(taste["recent"][:25], DJ_SET, self.used)
        if len(songs) < 3:
            return None
        if first:
            return songs, f"{greeting()}, I'm your DJ. Let's start with what you've had on repeat, like “{songs[0]['title']}” by {dj_names(songs[:1])}."
        return songs, f"Back to what you've had on repeat lately: {dj_names(songs, 3)}."

    def set_throwback(self, taste, first):
        recent = {song_key(t) for t in taste["recent"]}
        now = time.time()
        pool = [t for t in taste["all"] if song_key(t) not in recent and now - taste["last"].get(song_key(t), 0) > 21 * 86400]
        songs = dj_pick(pool[:120], DJ_SET, self.used)
        if len(songs) < 3:
            return None
        t = songs[0]
        n = t.get("plays") or 0
        return songs, (f"Throwback time. You've played “{t['title']}” {n} times, but not for a while." if n > 1
                       else f"Throwback time, starting with “{t['title']}” by {dj_names([t])}.")

    def set_fresh(self, taste, first):
        seeds = dj_pick(taste["recent"][:20] or taste["all"][:40], 2, set())
        if not seeds:
            return None
        known = self.known(taste) | self.used
        found = []
        for i, seed in enumerate(seeds):
            keys = self.services()
            got = self.radio(seed, keys[i % len(keys)]) or self.radio(seed, keys[(i + 1) % len(keys)])
            found.append([t for t in got if song_key(t) not in known])
        mixed = [t for pair in itertools.zip_longest(*found) for t in pair if t]
        songs = dj_pick(mixed[:30], DJ_SET, self.used)
        if len(songs) < 3:
            return None
        return songs, f"Something new for you, picked from {dj_names(seeds)}. Let's see what you think."

    def set_deep(self, taste, first):
        for name in random.sample(taste["artists"][:10], min(3, len(taste["artists"][:10]))):
            try:
                info = self.app.artist_info(name)
            except Exception:  # noqa: BLE001 -- the next artist
                info = None
            if not info:
                continue
            known = self.known(taste) | self.used
            songs = [t for t in info.get("top") or [] if song_key(t) not in known][:DJ_SET]
            if len(songs) >= 3:
                return songs, f"Deep cuts from {info.get('name') or name}: songs of theirs you haven't played yet."
        return None

    def set_genre(self, taste, first):
        fm = self.app.lastfm
        if not fm.key:
            return None
        weight = Counter()
        lead = taste["artists"][:3]
        for name in lead:
            try:
                for tag, n in fm.artist_tags(name)[:6]:
                    if tag.lower() not in DJ_JUNK_TAGS:
                        weight[tag.lower()] += n
            except Exception:  # noqa: BLE001 -- the other artists' tags
                pass
        if not weight:
            return None
        tag = random.choice([t for t, _n in weight.most_common(3)])
        songs = self.tag_songs(tag, taste)
        if len(songs) < 3:
            return None
        return songs, f"Some {tag}, since you've been playing {dj_names([{'artist': lead[0]}])} so much."

    def set_like(self, taste, first):
        """Radio of what's playing (or, when no service has one of it, of a song you play a lot)."""
        seeds = [t for t in [self.app.current_track()] + taste["recent"][:5] if t]
        for seed in seeds[:4]:
            for key in self.services():
                songs = dj_pick([t for t in self.radio(seed, key)[:25] if song_key(t) != song_key(seed)], DJ_SET, self.used)
                if len(songs) >= 3:
                    return songs, f"More like “{seed['title']}” by {dj_names([seed])}."
        return None

    def tag_songs(self, tag, taste):
        """Songs Last.fm files under tag, the ones by artists you play first."""
        fm = self.app.lastfm
        if not fm.key:
            return []
        try:
            res = fm.call("tag.getTopTracks", tag=tag, limit=100)
        except Exception:  # noqa: BLE001 -- none, then
            return []
        rows = ((res.get("tracks") or {}).get("track")) or []
        yours = {norm(n) for n in taste["artists"]}
        pool = []
        for x in [rows] if isinstance(rows, dict) else rows:
            artist = (x.get("artist") or {}).get("name", "") if isinstance(x.get("artist"), dict) else ""
            img = next((i["#text"] for i in reversed(x.get("image") or []) if i.get("#text")), "")
            if x.get("name") and artist:
                pool.append(self.app.fm_song(x["name"], artist, img, taste["mine"]))
        pool.sort(key=lambda t: norm(t["artist"].split(",")[0]) not in yours)   # stable: Last.fm's order within each
        return dj_pick(pool, DJ_SET, self.used)

    # ---- playing from songs you picked ----
    def from_set(self, kind, taste, first):
        """A set of kind from the songs the DJ plays from: (songs, line) or None."""
        name, pool = self.scope
        fresh = [t for t in pool if song_key(t) not in self.used]
        if len(fresh) < min(3, len(pool)):   # all of them played: around again, but not with songs still to come
            a = self.app
            coming = {song_key(t) for t in a.queue[a.index:]}
            fresh = [t for t in pool if song_key(t) not in coming]
            if len(fresh) < min(3, len(pool)):
                fresh = list(pool)
        plays = {song_key(e["track"]): e.get("plays", 0) for e in self.app.plays.items.values()}
        for t in taste["all"]:
            plays[song_key(t)] = max(plays.get(song_key(t), 0), t.get("plays") or 0)
        last, now = taste["last"], time.time()
        recent = {song_key(t) for t in taste["recent"]}
        n, least = min(DJ_SET, len(fresh)), min(3, len(fresh))
        songs, line = [], ""
        if kind == "loved":
            loved = sorted((t for t in fresh if plays.get(song_key(t))), key=lambda t: -plays[song_key(t)])
            songs = dj_pick(loved[:30], n, set())
            if songs:
                line = f"From {name}, the ones you keep coming back to, like “{songs[0]['title']}” by {dj_names(songs[:1])}."
        elif kind == "unplayed":
            new = [t for t in fresh if not plays.get(song_key(t)) and song_key(t) not in last]
            songs = random.sample(new, min(n, len(new)))
            if songs:
                line = f"Some from {name} you haven't played yet, starting with “{songs[0]['title']}” by {dj_names(songs[:1])}."
        elif kind == "throwback":
            old = [t for t in fresh if plays.get(song_key(t)) and song_key(t) not in recent
                   and now - last.get(song_key(t), 0) > 21 * 86400]
            songs = random.sample(old, min(n, len(old)))
            if songs:
                line = f"From {name}, a few you haven't played in a while, like “{songs[0]['title']}”."
        elif kind == "artist":
            count = Counter((t.get("artist") or "").split(",")[0].strip() for t in fresh)
            who = [a for a, c in count.items() if a and c >= least]
            if len(who) > 1:   # one artist in it all: that's not a set of its own
                a = random.choices(who, weights=[count[w] for w in who])[0]
                theirs = [t for t in fresh if (t.get("artist") or "").split(",")[0].strip() == a]
                songs = random.sample(theirs, min(n, len(theirs)))
                line = f"A few from {a}, from {name}."
        else:
            songs = random.sample(fresh, n)
            line = f"More from {name}: {dj_names(songs, 3)}." if songs else ""
        if len(songs) < least or not songs:
            return None
        if first:
            line = f"{greeting()}, I'm your DJ, playing {name}. " + line[0].upper() + line[1:]
        return songs, line

    def ask_from(self, text):
        """A set of the songs the DJ plays from that match what you asked (artist, title, album, genre)."""
        name, pool = self.scope
        words = [norm(w) for w in re.findall(r"[\w'&.-]+", text) if w.lower() not in DJ_FILLER and norm(w)]
        if not words:
            return None
        hits = [t for t in pool if all(w in norm(" ".join(str(t.get(k) or "") for k in ("title", "artist", "album", "genre")))
                                       for w in words)]
        unplayed = [t for t in hits if song_key(t) not in self.used]
        songs = dj_pick(random.sample(unplayed, len(unplayed)) + random.sample(hits, len(hits)), DJ_SET, set())
        if not songs:
            return None
        return "ask", songs, f"From {name}, you asked for {text.strip()}: “{songs[0]['title']}” by {dj_names(songs[:1])} first."

    def ask(self, text):
        """(blocking) A set for what you asked, ("ask", songs, line): an artist, a mood, a decade or a genre.
        Playing from songs you picked: the ones of them that match, else from everywhere."""
        if self.scope:
            got = self.ask_from(text)
            if got:
                return got
            got = self.ask_all(text)
            return got and (got[0], got[1], f"There's nothing like that in {self.scope[0]}, so from everywhere: {got[2]}")
        return self.ask_all(text)

    def ask_all(self, text):
        taste = self.load_taste()
        words = " ".join(w for w in re.findall(r"[\w'&.-]+", text) if w.lower() not in DJ_FILLER)
        names = {norm(n): n for n in taste["artists"]}
        names.update({norm(t["artist"].split(",")[0]): t["artist"].split(",")[0].strip() for t in taste["mine"].values()})
        who = best_named(list(names.values()), words, lambda n: n) if words else None
        moods = any(w in DJ_MOODS for w in words.lower().split()) or re.search(r"\d0s", words)
        if not who and words and not moods:
            try:
                info = self.app.artist_info(words)
            except Exception:  # noqa: BLE001 -- not an artist, then
                info = None
            # Only an artist called just that: "drum and bass" isn't DrymBass.
            if info and norm(re.sub(r"^the ", "", info.get("name") or "", flags=re.I)) == norm(re.sub(r"^the ", "", words, flags=re.I)):
                who = info["name"]
        if who:
            info = self.app.artist_info(who) or {}
            theirs = [t for t in taste["mine"].values() if norm(who) in {norm(a) for a in split_artists(t.get("artist") or "")}]
            pool = dj_pick(theirs, 2, self.used) + [t for t in info.get("top") or []]
            songs = dj_pick(pool, DJ_SET, self.used)
            if songs:
                return "ask", songs, f"{info.get('name') or who}, coming up: some you know, and some you might not."
        for tag in dj_tags(text):
            songs = self.tag_songs(tag, taste)
            if len(songs) >= 3:
                return "ask", songs, f"You asked for {text.strip()}, so here's some {tag}, starting with “{songs[0]['title']}” by {dj_names(songs[:1])}."
        # A playlist of it: named by its mood ("chill"), which finds a curated one more often than a sentence.
        for q in dict.fromkeys(dj_tags(text)[:1] + [text.strip()]):
            for key in self.services():
                src = self.app.sources.get(key)
                try:
                    found = src.mix_for(q) if src else []
                except Exception:  # noqa: BLE001 -- the other service
                    found = []
                songs = dj_pick(found, DJ_SET, self.used)
                if len(songs) >= 3:
                    return "ask", songs, f"You asked for {text.strip()}. Here's a mix of it, starting with “{songs[0]['title']}” by {dj_names(songs[:1])}."
        return None

    def build(self, kind=None, avoid=None, first=False):
        """(blocking) The next set: of kind, else the next kind in the DJ's order that has songs
        (not avoid, the kind playing now). (kind, songs, line), or None."""
        taste = self.load_taste()
        order = DJ_FROM_ORDER if self.scope else DJ_ORDER
        spots = [None] if kind else [(self.step + i) % len(order) for i in range(len(order))]
        if avoid and not kind:   # the kind playing now only when nothing else has songs
            spots = [i for i in spots if order[i] != avoid] + [i for i in spots if order[i] == avoid][:1]
        for spot in spots:
            k = kind or order[spot]
            got = self.from_set(k, taste, first) if self.scope else getattr(self, f"set_{k}")(taste, first)
            if got:
                if not kind:
                    self.step = spot + 1
                return k, [dict(t) for t in got[0]], got[1]
        return None


def greeting():
    h = datetime.now().hour
    return "Good morning" if 5 <= h < 12 else "Good afternoon" if h < 17 else "Good evening" if h < 23 else "Hey, night owl"


# =============================================================================
# Phone remote: the Android app plays here instead of on the phone. Off until
# you switch it on in the accounts menu; then a small HTTP API on your network
# (port REMOTE_PORT) answers phones paired once with the code the menu shows.
# =============================================================================

REMOTE_PORT = 8896 if PROFILE else 8897
PHONE_SHARE_PORT = 8899   # where the phone app serves its own songs, while it is the remote


def version_tuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v or "")[:3])


class Updater:
    """New releases on GitHub. It looks at start, every 12 hours and when you open the accounts
    menu (Check looks now), and installs only when you pick Update: on Linux the git clone moves
    to the release and install.sh runs again; on Windows the release's installer replaces this
    copy and opens the new one."""

    def __init__(self, app):
        self.app = app
        self.latest = None       # the newer release's tag ("v1.2.0"), once there is one
        self.installer = None    # its Windows installer's address
        self.state = ""          # "", "working", "restart" (Linux, updated), or what went wrong
        self.dir = Path(__file__).resolve().parent   # the git clone, or (Windows) where it's installed
        self.checking, self.checked_at, self.check_error = False, 0, ""

    @staticmethod
    def release():
        import requests
        r = requests.get(f"https://api.github.com/repos/{REPO}/releases/latest", timeout=15,
                         headers={"User-Agent": f"omarchy-music/{VERSION}", "Accept": "application/vnd.github+json"})
        r.raise_for_status()
        return r.json()

    @staticmethod
    def setup_of(rel):
        return next((x["browser_download_url"] for x in rel.get("assets", []) if x.get("name") == "OmarchyMusic-Setup.exe"), None)

    def check_soon(self):
        """The accounts menu opened: look again if the last look is over ten minutes old."""
        if time.time() - self.checked_at > 600:
            self.check()

    def check(self, quiet=True):
        """Look for a newer release (quiet: no message when there's none, as at start)."""
        if self.checking:
            return
        self.checking = True

        def done(rel, err):
            self.checking, self.checked_at = False, time.time()
            self.check_error = f"couldn't check: {str(err)[:60]}" if err else ""
            self.app.accounts_changed()
            if err or not rel:
                return
            if version_tuple(rel.get("tag_name")) <= version_tuple(VERSION):
                if not quiet:
                    self.app.toast(f"Omarchy Music {VERSION} is the newest")
                return
            tag = rel["tag_name"]
            if tag != self.latest:
                self.app.toast(f"Omarchy Music {tag.lstrip('v')} is out: update it in the accounts menu (☰)")
            self.latest = tag
            self.installer = self.setup_of(rel)
            self.app.accounts_changed()
        in_thread(self.release, done=done)

    def install(self):
        if self.state in ("working", "restart") or not self.latest:
            return
        self.state = "working"
        self.app.accounts_changed()
        in_thread(self._windows if WINDOWS else self._linux, done=self._done)

    def _linux(self):
        def git(*args):
            return subprocess.run(["git", "-C", str(self.dir), *args], capture_output=True, text=True, timeout=180)
        if git("rev-parse", "--is-inside-work-tree").returncode:
            raise RuntimeError("this copy isn't a git clone: get it again from GitHub")
        if git("status", "--porcelain", "--untracked-files=no").stdout.strip():
            raise RuntimeError("this copy has changes of yours: update it with git")
        for args in (("fetch", "--tags", "origin"), ("merge", "--ff-only", self.latest)):
            r = git(*args)
            if r.returncode:
                raise RuntimeError((r.stderr.strip().splitlines() or ["git " + args[0] + " failed"])[-1])
        r = subprocess.run([str(self.dir / "install.sh")], capture_output=True, text=True, timeout=900)
        if r.returncode:
            raise RuntimeError((r.stdout + r.stderr).strip().splitlines()[-1] if (r.stdout + r.stderr).strip()
                               else "install.sh failed")

    def _windows(self):
        import requests
        import tempfile
        if not self.installer:   # it comes a few minutes after the release: look again
            self.installer = self.setup_of(self.release())
        if not self.installer:
            raise RuntimeError("the release has no Windows installer yet: try again in a few minutes")
        dest = Path(tempfile.gettempdir()) / "OmarchyMusic-Setup.exe"
        with requests.get(self.installer, stream=True, timeout=30) as r:
            r.raise_for_status()
            with open(dest, "wb") as f:
                for chunk in r.iter_content(1 << 16):
                    f.write(chunk)
        return dest

    def _done(self, setup, err):
        if err:
            self.state = f"Couldn't update: {err}"[:160]
            self.app.accounts_changed()
            return
        if WINDOWS:
            import tempfile
            # The installer replaces the files this copy runs from, so it starts once this has
            # quit (a moment later; it also waits for anything still running from here), and
            # /UPDATE=1 has it open the new copy when it's done. /LOG leaves a record in %TEMP%.
            log = Path(tempfile.gettempdir()) / "OmarchyMusic-Update.log"
            subprocess.Popen(f'cmd /c ping -n 4 127.0.0.1 >nul & "{setup}" /SILENT /SUPPRESSMSGBOXES /NORESTART '
                             f'/CLOSEAPPLICATIONS /UPDATE=1 /LOG="{log}"',
                             creationflags=subprocess.CREATE_NO_WINDOW | subprocess.CREATE_NEW_PROCESS_GROUP)
            self.app.quit_app()
            return
        self.state = "restart"
        self.app.accounts_changed()
        self.app.toast(f"Updated to {self.latest.lstrip('v')}: restart it from the accounts menu")

    def restart(self):
        """Start the new copy once this one has quit."""
        subprocess.Popen(["sh", "-c", f"sleep 2; exec {shlex.quote(sys.executable)} {shlex.quote(str(self.dir / 'omarchy-music'))}"],
                         start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
        self.app.quit_app()
REMOTE_SERVICE = "_omarchy-music._tcp"


def on_ui(fn, timeout=5):
    """Run fn on the UI thread and wait for what it returns (from a server thread)."""
    box, done = {}, threading.Event()

    def run():
        try:
            box["value"] = fn()
        except Exception as e:  # noqa: BLE001 -- handed back to the caller
            box["error"] = e
        done.set()
        return False
    GLib.idle_add(run)
    if not done.wait(timeout):
        raise TimeoutError("the app is busy")
    if "error" in box:
        raise box["error"]
    return box.get("value")



def lan_address():
    """This computer's address on your network (what the phone types in), else "this computer"."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sk:
            sk.connect(("192.0.2.1", 9))   # nothing is sent: it only picks the interface
            return sk.getsockname()[0]
    except OSError:
        return "this computer"


class Remote:
    """The server the phone app talks to. Pairing swaps the code for a token the phone
    keeps; every other request carries that token. Commands run on the UI thread
    through the same methods the window's buttons use."""

    def __init__(self, app):
        self.app = app
        self.server = self.avahi = None
        self.code = ""
        self.misses = 0

    @property
    def running(self):
        return self.server is not None

    def new_code(self):
        self.code = f"{secrets.randbelow(10 ** 6):06d}"
        self.misses = 0

    def start(self):
        if self.server:
            return
        self.new_code()
        remote = self

        class Handler(BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(h, *_a):
                pass

            def answer(h, code, body, ctype="application/json"):
                data = body if isinstance(body, bytes) else json.dumps(body).encode()
                h.send_response(code)
                h.send_header("Content-Type", ctype)
                h.send_header("Content-Length", str(len(data)))
                h.end_headers()
                h.wfile.write(data)

            def phone(h):
                auth = h.headers.get("Authorization", "")
                tok = auth[7:] if auth.startswith("Bearer ") else ""
                return tok if tok and tok in remote.app.remote_tokens else None

            def body(h):
                n = int(h.headers.get("Content-Length") or 0)
                return json.loads(h.rfile.read(n) or b"{}") if 0 < n < 8_000_000 else {}

            def do_GET(h):
                url = urllib.parse.urlparse(h.path)
                q = dict(urllib.parse.parse_qsl(url.query))
                if url.path == "/hello":   # for "is this the app?" checks: that, and its version
                    return h.answer(200, {"app": "omarchy-music", "version": VERSION})
                if not h.phone():
                    return h.answer(401, {"error": "pair this phone first"})
                try:
                    if url.path == "/status":
                        return h.answer(200, on_ui(lambda: remote.status(q.get("qv"))))
                    if url.path == "/art":
                        data = remote.art(q.get("id", ""))
                        return h.answer(200, data, "image/jpeg") if data else h.answer(404, {"error": "no picture"})
                except Exception as e:  # noqa: BLE001 -- the phone shows it
                    return h.answer(500, {"error": str(e)[:200]})
                h.answer(404, {"error": "no such thing"})

            def do_POST(h):
                url = urllib.parse.urlparse(h.path)
                try:
                    body = h.body()
                except ValueError:
                    return h.answer(400, {"error": "that isn't JSON"})
                if url.path == "/pair":
                    return h.answer(*on_ui(lambda: remote.pair(str(body.get("code", "")).strip(), str(body.get("name") or "Phone"))))
                if not h.phone():
                    return h.answer(401, {"error": "pair this phone first"})
                if url.path == "/cmd":
                    try:
                        on_ui(lambda: remote.command(body, h.client_address[0]))
                        return h.answer(200, {"ok": True})
                    except Exception as e:  # noqa: BLE001
                        return h.answer(400, {"error": str(e)[:200]})
                h.answer(404, {"error": "no such thing"})

        class Server(ThreadingHTTPServer):
            daemon_threads = True
            allow_reuse_address = True

        try:
            self.server = Server(("0.0.0.0", REMOTE_PORT), Handler)
        except OSError as e:
            self.app.toast(f"Couldn't start the phone remote: {e.strerror or e}")
            return
        threading.Thread(target=self.server.serve_forever, daemon=True).start()
        self.announce()

    def announce(self):
        """Tell the network, so the phone finds this app without typing an address: Avahi on
        Linux, the zeroconf module on Windows. Without either, the phone takes the address."""
        name = f"Omarchy Music on {socket.gethostname()}"
        if not WINDOWS:
            try:
                self.avahi = child(["avahi-publish-service", name, REMOTE_SERVICE, str(REMOTE_PORT)],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                self.avahi = None
            return
        try:
            from zeroconf import ServiceInfo, Zeroconf
            info = ServiceInfo(f"{REMOTE_SERVICE}.local.", f"{name}.{REMOTE_SERVICE}.local.", port=REMOTE_PORT,
                               addresses=[socket.inet_aton(lan_address())], server=f"{socket.gethostname()}.local.")
            zc = Zeroconf()
            zc.register_service(info)
            self.avahi = (zc, info)
        except Exception:  # noqa: BLE001 -- no zeroconf module, or no network yet
            self.avahi = None

    def stop(self):
        if self.server:
            self.server.shutdown()
            self.server.server_close()
            self.server = None
        if isinstance(self.avahi, tuple):
            zc, info = self.avahi
            try:
                zc.unregister_service(info)
                zc.close()
            except Exception:  # noqa: BLE001 -- going anyway
                pass
        elif self.avahi:
            self.avahi.terminate()
        self.avahi = None

    def pair(self, code, name):
        if not self.code or code != self.code:
            self.misses += 1
            if self.misses >= 5:   # guessing: a new code
                self.new_code()
                self.app.accounts_changed()
            return 403, {"error": "that isn't the code the desktop shows"}
        tok = secrets.token_urlsafe(24)
        self.app.remote_tokens[tok] = {"name": name[:60], "added": int(time.time())}
        self.app.save_state()
        self.new_code()   # one code, one phone
        self.app.toast(f"Paired with {name[:60]}: it can play music here now")
        self.app.accounts_changed()
        return 200, {"token": tok, "name": socket.gethostname()}

    @staticmethod
    def for_phone(t):
        """A song as the phone gets it: without the path of a file of yours."""
        return {k: v for k, v in t.items() if k != "file"}

    def status(self, qv=None):
        a = self.app
        t = a.current_track()
        version = hashlib.sha1(json.dumps([(x["id"], bool(x.get("queued"))) for x in a.queue]).encode()).hexdigest()[:16]
        out = {"index": a.index, "paused": a.paused, "position": a.position,
               "duration": a.duration or (t or {}).get("duration") or 0, "repeat": a.repeat,
               "liked": bool(t and t["id"] in a.liked), "radio": bool(a.radio_from), "qv": version,
               "message": a.win.np_status.get_label() if a.win and a.win.np_status.get_visible() else ""}
        shown = (a.dj["sets"].get(str(a.dj.get("shown") or "")) if a.dj["on"] else None) or {}
        out["dj"] = {"on": a.dj["on"], "busy": a.dj_busy or "", "kind": shown.get("kind", ""), "line": shown.get("line", ""),
                     "from": (a.dj_source(a.dj.get("from")) or ("",))[0] if a.dj.get("from") else "",
                     "kinds": {n: s["kind"] for n, s in a.dj["sets"].items()}}
        if qv != version:   # the queue only when it changed: a long one is big
            out["queue"] = [self.for_phone(x) for x in a.queue]
        return out

    def art(self, vid):
        """The cover of a song in the queue or the library: the saved one, the cached thumbnail, the file's own."""
        a = self.app
        if not vid or "/" in vid:
            return None
        entry = a.lib.items.get(vid) or {}
        for path in (entry.get("art"), a.art.paths.get(vid), THUMBS / f"{safe_name(vid)}.jpg"):
            if path and Path(path).is_file():
                return Path(path).read_bytes()
        t = next((x for x in a.queue if x["id"] == vid), None)
        if t and source_of(t) == "file" and t.get("file"):
            return file_cover(t["file"])
        return None

    @staticmethod
    def from_phone(t, phone):
        """Whether t is a song a phone sent to play here as itself: a song on that phone,
        which streams from it (only from the phone that sent it, and only its own songs)."""
        if not isinstance(t, dict) or not t.get("id"):
            return False
        f = str(t.get("file") or "")
        if source_of(t) != "file" and not f:
            return True   # a song of a service: the desktop plays it as always
        u = urllib.parse.urlsplit(f)
        ok = (u.scheme == "http" and u.hostname == phone and u.port == PHONE_SHARE_PORT
              and re.fullmatch(r"/song/\d+", u.path or "") is not None)
        thumb = urllib.parse.urlsplit(str(t.get("thumb") or ""))
        if ok and t.get("thumb") and not (thumb.scheme == "http" and thumb.hostname == phone and thumb.port == PHONE_SHARE_PORT):
            t["thumb"] = ""
        return ok

    def command(self, b, phone=""):
        a = self.app
        verb = b.get("verb")
        tracks = [t for t in b.get("tracks") or [] if self.from_phone(t, phone)]
        if verb in ("play", "pause"):
            if verb == "play" and a.paused and a.current_track() and a.ended:
                a.load_current()
            else:
                a.set_paused(verb == "pause")
        elif verb == "next":
            a.next()
        elif verb == "prev":
            a.previous()
        elif verb == "seek":
            a.player.seek(max(0.0, float(b.get("position") or 0)))
        elif verb == "repeat":
            a.cycle_repeat()
        elif verb == "shuffle":
            a.shuffle()
        elif verb == "like":
            a.toggle_like()
        elif verb == "play_index":
            a.play_index(int(b.get("index", -1)))
        elif verb == "unqueue":
            a.unqueue_many([int(i) for i in b.get("indices") or []])
        elif verb == "play_from":
            if not tracks:
                raise ValueError("no songs the desktop can play")
            a.play_from(tracks, max(0, min(int(b.get("index") or 0), len(tracks) - 1)), bool(b.get("radio")))
            a.save_state()
        elif verb == "enqueue":
            if not tracks:
                raise ValueError("no songs the desktop can play")
            a.enqueue(tracks, "next" if b.get("how") == "next" else "queue")
        elif verb == "dj":
            do = b.get("do")
            if do == "start":
                if b.get("from") == "all":
                    a.dj_start({"kind": "all"})
                elif b.get("tracks") is not None:   # the phone's playlist, folder or album
                    if not tracks:
                        raise ValueError("no songs the desktop can play")
                    a.dj_start({"kind": "songs", "name": str(b.get("name") or "the phone's songs")[:80], "songs": tracks})
                else:
                    a.dj_start()
            elif do == "stop":
                a.dj_stop()
            elif do == "switch":
                a.dj_switch()
            elif do == "ask" and str(b.get("text") or "").strip():
                a.dj_switch(ask=str(b["text"])[:200])
            else:
                raise ValueError(f"unknown DJ command {do!r}")
        else:
            raise ValueError(f"unknown command {verb!r}")


