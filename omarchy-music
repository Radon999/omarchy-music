    pic = Gtk.Image(pixel_size=px)
    frame = Gtk.Box(overflow=Gtk.Overflow.HIDDEN, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    frame.add_css_class("art")
    frame.set_size_request(px, px)
    frame.append(pic)
    return frame, pic


class TrackRow(Gtk.ListBoxRow):
    def __init__(self, win, track, index, removable=False):
        super().__init__()
        self.track, self.index = track, index
        box = Gtk.Box(spacing=10)
        frame, pic = art_widget(42)
        win.art.apply(pic, track)
        box.append(frame)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
        title = Gtk.Label(label=track["title"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
        title.add_css_class("title")
        dur = f" · {fmt_time(track['duration'])}" if track.get("duration") else ""
        sub = Gtk.Label(label=f"{track['artist']}{dur}", xalign=0, ellipsize=Pango.EllipsizeMode.END)
        sub.add_css_class("sub")
        text.append(title)
        text.append(sub)
        box.append(text)
        vid = track["id"]
        if removable:
            box.append(icon_button("user-trash-symbolic", "row-action", "Remove download",
                                   lambda: win.remove_download(vid)))
        elif win.lib.has(vid):
            ok = Gtk.Label(label="✓", tooltip_text="Downloaded: plays without data")
            ok.add_css_class("saved")
            box.append(ok)
        elif win.dl.busy(vid):
            box.append(Adw.Spinner())
        elif win.lib.recently_missing(vid):
            miss = Gtk.Label(label="–", tooltip_text="No lossless copy on Tidal: skipped")
            miss.add_css_class("pending")
            box.append(miss)
        else:
            box.append(icon_button("folder-download-symbolic", "row-action", "Download in FLAC",
                                   lambda: win.download_only(track)))
        self.set_child(box)


