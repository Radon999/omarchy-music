        menu.connect("pressed", lambda _g, _n, x, y: win.track_menu(self, x, y))
        self.add_controller(menu)
        ctrl = Gtk.GestureClick(button=Gdk.BUTTON_PRIMARY)     # Ctrl+click: select it
        ctrl.connect("pressed", self.on_press)
        self.add_controller(ctrl)
        box = Gtk.Box(spacing=10)
        self.check = Gtk.CheckButton(valign=Gtk.Align.CENTER, visible=False)
        self.check.add_css_class("pick")
        self.check.connect("toggled", lambda c: win.set_selected(self, c.get_active()))
        box.append(self.check)
