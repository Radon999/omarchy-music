def _die_with_parent():
    # mpv must not outlive the app (a killed app would leave music playing).
    import ctypes
    ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG


class Player:
    def __init__(self, on_event):
        self.on_event = on_event
        SOCK.unlink(missing_ok=True)
        self.proc = subprocess.Popen(
            ["mpv", "--idle=yes", "--no-video", "--no-terminal", "--load-scripts=no",
             "--audio-client-name=omarchy-music",  # the desktop visualizer listens to this stream only
             "--no-config", "--audio-display=no", "--gapless-audio=weak", "--volume=100",
             f"--input-ipc-server={SOCK}"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            preexec_fn=_die_with_parent)
        self.sock = None
        for _ in range(100):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(str(SOCK))
                self.sock = s
                break
            except OSError:
                time.sleep(0.05)
        if not self.sock:
            raise RuntimeError("mpv did not start")
        self.wlock = threading.Lock()
        threading.Thread(target=self._reader, daemon=True).start()
        for i, prop in enumerate(("time-pos", "duration", "pause", "idle-active"), 1):
            self.cmd("observe_property", i, prop)

    def cmd(self, *args):
        with self.wlock:
            try:
                self.sock.sendall((json.dumps({"command": list(args)}) + "\n").encode())
            except OSError:
                pass

    def _reader(self):
        buf = b""
        while True:
            try:
                chunk = self.sock.recv(65536)
            except OSError:
                return
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if "event" in msg:
                    GLib.idle_add(lambda m=msg: (self.on_event(m), False)[1])

    def load(self, path, paused=False):
        self.cmd("loadfile", path, "replace", -1, f"pause={'yes' if paused else 'no'}")

    def set_volume(self, volume, muted):
        self.cmd("set_property", "volume", volume)
        self.cmd("set_property", "mute", muted)

    def set_filters(self, graph):
        """mpv's audio filters: a libavfilter graph, or none for untouched audio."""
        self.cmd("set_property", "af", f"@eq:lavfi=[{graph}]" if graph else "")

    def filter_cmd(self, command, arg, target):
        """Change one setting of one filter in the running graph, without a gap."""
        self.cmd("af-command", "eq", command, str(arg), target)

    def set_pause(self, paused):
        self.cmd("set_property", "pause", paused)

    def seek(self, seconds):
        self.cmd("seek", seconds, "absolute")

    def stop(self):
        self.cmd("stop")

    def quit(self):
        self.cmd("quit")
        try:
            self.proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        SOCK.unlink(missing_ok=True)


