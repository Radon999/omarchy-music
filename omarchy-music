def _die_with_parent():
    # mpv must not outlive the app (a killed app would leave music playing).
    import ctypes
    ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG


def child(args, **kw):
    """Start a helper program that goes when the app goes, however it goes."""
    if not WINDOWS:
        return subprocess.Popen(args, preexec_fn=_die_with_parent, **kw)
    proc = subprocess.Popen(args, **NO_WINDOW, **kw)
    _windows_job().assign(proc)
    return proc


class _WindowsJob:
    """A Windows job object that ends its processes when the app's handle on it closes
    (Windows' counterpart of PR_SET_PDEATHSIG)."""

    def __init__(self):
        import ctypes
        from ctypes import wintypes
        self.k32 = k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        k32.CreateJobObjectW.restype = wintypes.HANDLE
        self.job = k32.CreateJobObjectW(None, None)

        class Basic(ctypes.Structure):
            _fields_ = [("PerProcessUserTimeLimit", ctypes.c_int64), ("PerJobUserTimeLimit", ctypes.c_int64),
                        ("LimitFlags", wintypes.DWORD), ("MinimumWorkingSetSize", ctypes.c_size_t),
                        ("MaximumWorkingSetSize", ctypes.c_size_t), ("ActiveProcessLimit", wintypes.DWORD),
                        ("Affinity", ctypes.c_size_t), ("PriorityClass", wintypes.DWORD),
                        ("SchedulingClass", wintypes.DWORD)]

        class Extended(ctypes.Structure):
            _fields_ = [("BasicLimitInformation", Basic), ("IoInfo", ctypes.c_uint64 * 6),
                        ("ProcessMemoryLimit", ctypes.c_size_t), ("JobMemoryLimit", ctypes.c_size_t),
                        ("PeakProcessMemoryUsed", ctypes.c_size_t), ("PeakJobMemoryUsed", ctypes.c_size_t)]
        info = Extended()
        info.BasicLimitInformation.LimitFlags = 0x2000   # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
        k32.SetInformationJobObject(wintypes.HANDLE(self.job), 9, ctypes.byref(info), ctypes.sizeof(info))

    def assign(self, proc):
        from ctypes import wintypes
        self.k32.AssignProcessToJobObject(wintypes.HANDLE(self.job), wintypes.HANDLE(int(proc._handle)))


_JOB = None


def _windows_job():
    global _JOB
    if _JOB is None:
        _JOB = _WindowsJob()
    return _JOB


class _PipeIPC:
    """mpv's IPC on Windows: a named pipe, read and written at once through asyncio's
    overlapped I/O (a plain handle to a pipe can't read and write at the same time)."""

    def __init__(self, path, on_line):
        import asyncio
        self.loop = asyncio.ProactorEventLoop()
        self.transport = None
        ready, failed = threading.Event(), []

        class Proto(asyncio.Protocol):
            buf = b""

            def data_received(p, data):
                p.buf += data
                while b"\n" in p.buf:
                    line, p.buf = p.buf.split(b"\n", 1)
                    on_line(line)

        async def connect():
            for _ in range(100):
                try:
                    self.transport, _proto = await self.loop.create_pipe_connection(Proto, path)
                    return
                except OSError:
                    await asyncio.sleep(0.05)

        def run():
            asyncio.set_event_loop(self.loop)
            try:
                self.loop.run_until_complete(connect())
            except Exception as e:  # noqa: BLE001 -- reported below
                failed.append(e)
            ready.set()
            if self.transport:
                self.loop.run_forever()
        threading.Thread(target=run, daemon=True).start()
        ready.wait(15)
        if not self.transport:
            raise RuntimeError("mpv did not start")

    def send(self, data):
        self.loop.call_soon_threadsafe(self.transport.write, data)


class Player:
    def __init__(self, on_event):
        self.on_event = on_event
        if not WINDOWS:
            SOCK.unlink(missing_ok=True)
        self.proc = child(
            ["mpv", "--idle=yes", "--no-video", "--no-terminal", "--load-scripts=no",
             f"--audio-client-name=omarchy-music{SUFFIX}",  # the desktop visualizer listens to this stream only
             "--no-config", "--audio-display=no", "--gapless-audio=weak", "--volume=100",
             f"--input-ipc-server={PIPE if WINDOWS else SOCK}", *shlex.split(os.environ.get("OMARCHY_MUSIC_MPV", ""))],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.sock = self.pipe = None
        self.heard = False
        self.wlock = threading.Lock()
        if WINDOWS:
            self.pipe = _PipeIPC(PIPE, self._line)
        else:
            for _ in range(100):
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.connect(str(SOCK))
                    self.sock = s
                    break
                except OSError:
                    time.sleep(0.05)
            if not self.sock:
                raise RuntimeError("mpv did not start")
            threading.Thread(target=self._reader, daemon=True).start()
        for i, prop in enumerate(("time-pos", "duration", "pause", "idle-active"), 1):
            self.cmd("observe_property", i, prop)

    def cmd(self, *args):
        data = (json.dumps({"command": list(args)}) + "\n").encode()
        if self.pipe:
            self.pipe.send(data)
            return
        with self.wlock:
            try:
                self.sock.sendall(data)
            except OSError:
                pass

    def _reader(self):
        buf = b""
        while True:
            try:
                chunk = self.sock.recv(65536)
            except OSError:
                return
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                self._line(line)

    def _line(self, line):
        try:
            msg = json.loads(line)
        except ValueError:
            return
        self.heard = True   # mpv answered (the self-test checks this)
        if "event" in msg:
            GLib.idle_add(lambda m=msg: (self.on_event(m), False)[1])

    def load(self, path, paused=False, start=0):
        opts = f"pause={'yes' if paused else 'no'}" + (f",start={start:.1f}" if start else "")
        self.cmd("loadfile", path, "replace", -1, opts)

    def set_volume(self, volume, muted):
        self.cmd("set_property", "volume", volume)
        self.cmd("set_property", "mute", muted)

    def set_filters(self, graph):
        """mpv's audio filters: a libavfilter graph, or none for untouched audio."""
        self.cmd("set_property", "af", f"@eq:lavfi=[{graph}]" if graph else "")

    def filter_cmd(self, command, arg, target):
        """Change one setting of one filter in the running graph, without a gap."""
        self.cmd("af-command", "eq", command, str(arg), target)

    def set_pause(self, paused):
        self.cmd("set_property", "pause", paused)

    def seek(self, seconds):
        self.cmd("seek", seconds, "absolute")

    def stop(self):
        self.cmd("stop")

    def quit(self):
        self.cmd("quit")
        try:
            self.proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        SOCK.unlink(missing_ok=True)


