NOT_GENRES = {"seen live", "favorites", "favourites", "favorite", "favourite", "my favorites", "albums i own",
              "female vocalists", "male vocalists", "female vocalist", "male vocalist", "female", "male",
              "under 2000 listeners", "spotify", "beautiful", "awesome", "love", "amazing", "epic", "cool",
              "british", "american", "uk", "usa", "canadian", "australian", "dutch", "german", "french",
              "swedish", "norwegian", "korean", "japanese", "english", "all", "vocal", "singer-songwriter",
              "masterpiece", "best", "good", "great", "favorite songs", "catchy", "sexy", "fun"}
GENRE_NAMES = {"edm": "EDM", "idm": "IDM", "r&b": "R&B", "rnb": "R&B", "dnb": "DnB", "uk garage": "UK Garage",
               "lo-fi": "Lo-fi", "lofi": "Lo-fi", "k-pop": "K-pop", "j-pop": "J-pop", "hip-hop": "Hip-hop",
               "hip hop": "Hip-hop", "uk drill": "UK Drill"}
MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()
WEEKDAYS = "Mondays Tuesdays Wednesdays Thursdays Fridays Saturdays Sundays".split()
WEEK_LETTERS = "M T W T F S S".split()
PERIOD_KINDS = (("week", "Week"), ("month", "Month"), ("year", "Year"), ("all", "All time"))


def day_label(dt):
    """"October 19" (strftime's %-d isn't there on Windows)."""
    return f"{dt:%B} {dt.day}"


def hour_label(h):
    return f"{h % 12 or 12} {'AM' if h < 12 else 'PM'}"


def add_months(dt, n):
    m = dt.month - 1 + n
    return datetime(dt.year + m // 12, m % 12 + 1, 1)


def week_start(dt):
    return datetime(dt.year, dt.month, dt.day) - timedelta(days=dt.weekday())


# A Wrapped is of a period: a year (2026), a month ("m2026-10"), a week from its Monday
# ("w2026-10-19") or "all".
def period_kind(period):
    return "all" if period == "all" else "year" if isinstance(period, int) else {"m": "month", "w": "week"}[period[0]]


def period_start(period):
    kind = period_kind(period)
    return (datetime(period, 1, 1) if kind == "year" else datetime.strptime(period[1:], "%Y-%m")
            if kind == "month" else datetime.strptime(period[1:], "%Y-%m-%d"))


def period_end(period):
    start, kind = period_start(period), period_kind(period)
    return (datetime(start.year + 1, 1, 1) if kind == "year" else add_months(start, 1) if kind == "month"
            else start + timedelta(days=7))


def this_period(kind):
    now = datetime.now()
    return {"year": wrapped_year(), "month": f"m{now:%Y-%m}", "week": f"w{week_start(now):%Y-%m-%d}",
            "all": "all"}[kind]


def week_span(start):
    end = start + timedelta(days=6)
    return f"{start:%b} {start.day}–{end.day}" if start.month == end.month else f"{start:%b} {start.day}–{end:%b} {end.day}"


def period_name(period):
    """"2026", "October 2026", "Week of Oct 19–25", "All time"."""
    kind = period_kind(period)
    if kind == "all":
        return "All time"
    if kind == "year":
        return str(period)
    start = period_start(period)
    return f"{start:%B %Y}" if kind == "month" else f"Week of {week_span(start)}"


def period_title(period):
    """The big word on the first slide: "2026", "October", "Oct 19–25"."""
    kind, start = period_kind(period), period_start(period)
    return str(period) if kind == "year" else f"{start:%B}" if kind == "month" else week_span(start)


def period_of(period):
    """For "your first song of ...": "2026", "October", "the week"."""
    kind = period_kind(period)
    return str(period) if kind == "year" else f"{period_start(period):%B}" if kind == "month" else "the week"


def period_choices(kind, years):
    """What the picker offers for a kind: [(period, its name)], the newest first."""
    now = datetime.now()
    if kind == "year":
        return [(y, str(y)) for y in years]
    if kind == "month":
        first = datetime(now.year, now.month, 1)
        return [(f"m{add_months(first, -i):%Y-%m}", f"{add_months(first, -i):%B %Y}") for i in range(12)]
    if kind == "week":
        monday = week_start(now)
        out = []
        for i in range(12):
            start = monday - timedelta(weeks=i)
            out.append((f"w{start:%Y-%m-%d}", "This week" if i == 0 else "Last week" if i == 1 else week_span(start)))
        return out
    return []


def wrapped_year():
    """The year Wrapped opens on: this one, or last year until March, while this one has hardly begun."""
    now = datetime.now()
    return now.year if now.month >= 3 else now.year - 1


def genre_name(tag):
    t = tag.lower().strip()
    return GENRE_NAMES.get(t) or " ".join(w if w.isupper() else w.capitalize() for w in t.split())


def is_genre(tag, artist):
    t = tag.lower().strip()
    return (t not in NOT_GENRES and t != artist.lower() and len(t) <= 28 and not re.fullmatch(r"\d+s?|\d{2,4}s", t)
            and not re.search(r"seen|favou?rite|vocalist|listeners|albums? i|my |best of", t))


def cached_image(url):
    """The picture at url, downloaded once; its path, or "" if there's none."""
    if not url or LASTFM_BLANK in url or "/artist//" in url:
        return ""
    path = WRAPPED / "img" / (hashlib.sha1(url.encode()).hexdigest() + ".jpg")
    if not path.exists():
        try:
            write_file(path, fetch_bytes(url))
        except Exception:  # noqa: BLE001 -- no picture, then
            return ""
    return str(path)


def big_lastfm(url):
    return url.replace("/300x300/", "/770x0/").replace("/174s/", "/770x0/") if url else url


def deezer_artist_image(name):
    data = http_json("https://api.deezer.com/search/artist?" + urllib.parse.urlencode({"q": name, "limit": 5})).get("data") or []
    data.sort(key=lambda a: -similar(norm(a.get("name")), norm(name)))
    if data and similar(norm(data[0].get("name")), norm(name)) > 0.85:
        return data[0].get("picture_xl") or data[0].get("picture_big")
    return None


def deezer_cover(artist, title):
    q = f'artist:"{artist}" track:"{title}"'
    data = http_json("https://api.deezer.com/search?" + urllib.parse.urlencode({"q": q, "limit": 1})).get("data") or []
    return ((data[0].get("album") or {}).get("cover_xl")) if data else None


def year_stats(rows):
    """Your year in numbers, from its scrobbles [(time, artist, title, album, image)]."""
    artists, songs, albums = Counter(), Counter(), Counter()
    names, art, first_play = {}, {}, {}
    months, hours, weekdays, days = [0] * 12, [0] * 24, [0] * 7, Counter()
    for t, artist, title, album, img in rows:
        ka, ks = artist.lower(), (artist.lower(), title.lower())
        artists[ka] += 1
        songs[ks] += 1
        names.setdefault(ka, artist)
        names.setdefault(ks, (title, artist))
        first_play.setdefault(ks, t)
        if img and LASTFM_BLANK not in img:
            art[ks] = img
        if album:
            kb = (artist.lower(), album.lower())
            albums[kb] += 1
            names.setdefault(kb, (album, artist))
            if img and LASTFM_BLANK not in img:
                art[kb] = img
        d = datetime.fromtimestamp(t)
        months[d.month - 1] += 1
        hours[d.hour] += 1
        weekdays[d.weekday()] += 1
        days[d.date()] += 1
    streak = run = 0
    prev = None
    for day in sorted(days):
        run = run + 1 if prev and (day - prev).days == 1 else 1
        streak, prev = max(streak, run), day
    busiest, busiest_n = days.most_common(1)[0]
    top_artist = artists.most_common(1)[0][0]
    by_top = [(k, n) for k, n in songs.most_common() if k[0] == top_artist]
    t0 = rows[0]
    return {
        "scrobbles": len(rows), "artist_count": len(artists), "song_count": len(songs),
        "artists": [(names[k], n) for k, n in artists.most_common(30)],
        "songs": [(names[k][0], names[k][1], n, art.get(k, ""), first_play[k]) for k, n in songs.most_common(10)],
        "albums": [(names[k][0], names[k][1], n, art.get(k, "")) for k, n in albums.most_common(5)],
        "top_artist_song": (names[by_top[0][0]][0], by_top[0][1]) if by_top else None,
        "months": months, "hours": hours, "weekdays": weekdays, "streak": streak, "days": len(days),
        "busiest": busiest.isoformat(), "busiest_n": busiest_n,
        "first": {"title": t0[2], "artist": t0[1], "time": t0[0]},
        "plays": songs, "names": names,   # for the minutes; dropped before showing
    }


def listening_minutes(app, rows):
    """Minutes of music in rows: each song's length (yours on disk, else Last.fm's),
    the typical length for the few nobody knows."""
    fm = app.lastfm
    known = {}
    for e in list(app.lib.items.values()):
        if e.get("duration"):
            known[f"{norm(e.get('artist', '').split(',')[0])}|{norm(clean_title(e.get('title', '')))}"] = e["duration"]
    path = WRAPPED / "durations.json"
    cache = read_json(path, {})
    plays = Counter((r[1], r[2]) for r in rows)
    lengths, asked = {}, 0
    for (artist, title), _n in plays.most_common():
        k = f"{norm(artist)}|{norm(clean_title(title))}"
        sec = known.get(k) or cache.get(k)
        if sec is None and asked < 80:   # Last.fm, for your most played; one request each
            asked += 1
            try:
                sec = cache[k] = fm.duration(artist, title)
            except Exception:  # noqa: BLE001 -- the typical length, then
                sec = cache[k] = 0
        if sec:
            lengths[(artist, title)] = sec
    write_atomic(path, json.dumps(cache))
    typical = sorted(lengths.values())[len(lengths) // 2] if lengths else 210
    return round(sum(n * (lengths.get(k) or typical) for k, n in plays.items()) / 60)


def top_genres(app, artists):
    """Your top genres: each top artist's Last.fm tags, weighted by how much you played them."""
    path = WRAPPED / "tags.json"
    cache = read_json(path, {})
    score = Counter()
    for name, plays in artists[:30]:
        tags = cache.get(name.lower())
        if tags is None:
            try:
                tags = cache[name.lower()] = app.lastfm.artist_tags(name)
            except Exception:  # noqa: BLE001 -- that artist counts for no genre
                tags = []
        tags = [(t, c) for t, c in tags if is_genre(t, name)][:4]
        total = sum(c for _, c in tags) or 1
        for t, c in tags:
            score[t.lower()] += plays * c / total
    write_atomic(path, json.dumps(cache))
    return [genre_name(g) for g, _ in score.most_common(5)]


def wrapped_data(app, period, progress):
    """Everything Wrapped shows for a year (or "all"). It blocks: a big year takes a
    minute the first time (Last.fm hands out 200 scrobbles a request), then it's kept."""
    fm = app.lastfm
    WRAPPED.mkdir(parents=True, exist_ok=True)
    progress("Opening your Last.fm…")
    me = fm.info()
    first_year = datetime.fromtimestamp(me["registered"]).year if me["registered"] else datetime.now().year
    years = list(range(datetime.now().year, first_year - 1, -1))
    base = {"period": period, "kind": period_kind(period), "user": me["name"], "years": years, "since": first_year}
    if period == "all":
        counts = []
        for y in reversed(years):
            progress(f"Counting your scrobbles · {y}")
            counts.append((y, fm.count(datetime(y, 1, 1).timestamp(), datetime(y + 1, 1, 1).timestamp())))
        progress("Your all-time favourites…")
        artists = [(n, p) for n, _a, p, _i in fm.top("artist", 30)]
        songs = [(n, a, p, img, None) for n, a, p, img in fm.top("track", 10)]
        albums = [(n, a, p, img) for n, a, p, img in fm.top("album", 5)]
        if not me["playcount"]:
            return base | {"empty": True}
        data = base | {"scrobbles": me["playcount"], "artists": artists, "songs": songs, "albums": albums,
                       "years_count": counts, "artist_count": None,
                       "minutes": round(me["playcount"] * 3.5)}   # about three and a half minutes a song
    else:
        start = period_start(period).timestamp()
        natural_end = period_end(period).timestamp()
        end = min(natural_end, time.time())
        path = WRAPPED / f"{safe_name(fm.user.lower())}-{period}.json"
        saved = read_json(path, {})
        rows = [tuple(r) for r in saved.get("rows", [])]
        since = saved.get("until", start)
        if since < end - 60:
            new = fm.recent(since, end, lambda p, n: progress(f"Reading your scrobbles · {period_name(period)} · "
                                                               f"page {p} of {n}"))
            have = {(r[0], r[2]) for r in rows}
            rows = sorted(rows + [r for r in new if (r[0], r[2]) not in have])
            write_atomic(path, json.dumps({"rows": rows, "until": end}))
        if not rows:
            return base | {"empty": True}
        data = base | year_stats(rows)
        progress("Adding up your minutes…")
        data["minutes"] = listening_minutes(app, rows)
        del data["plays"], data["names"]
        data["span_days"] = max(1, math.ceil((end - start) / 86400))
        data["partial"] = end < natural_end - 60
        if data["kind"] != "year":   # day by day
            first_day = period_start(period).date()
            daily = [0] * (period_end(period).date() - first_day).days
            for r in rows:
                i = (datetime.fromtimestamp(r[0]).date() - first_day).days
                if 0 <= i < len(daily):
                    daily[i] += 1
            data["daily"] = daily
        progress("Comparing with before…")
        try:   # as far into the period before as this one has gone
            length = natural_end - start
            data["prev_count"] = fm.count(start - length, start - length + (end - start))
        except Exception:  # noqa: BLE001 -- no comparison, then
            data["prev_count"] = None
    progress("Finding your genres…")
    data["genres"] = top_genres(app, data["artists"])
    progress("Getting the pictures…")
    try:
        data["artist_image"] = cached_image(deezer_artist_image(data["artists"][0][0]))
    except Exception:  # noqa: BLE001 -- no photo
        data["artist_image"] = ""
    for key in ("songs", "albums"):
        out = []
        for i, item in enumerate(data[key]):
            name, artist, img = item[0], item[1], item[3]
            path = cached_image(big_lastfm(img) if i == 0 else img) or cached_image(img)
            if not path:
                try:
                    path = cached_image(deezer_cover(artist, name))
                except Exception:  # noqa: BLE001
                    path = ""
            out.append((*item[:3], path, *item[4:]))
        data[key] = out
    return data


def bars(values, labels=None, height=110, top=None):
    """A little bar chart; top is the bar to light up. A label sits under its bar
    and runs on under the unlabelled ones after it, so 24 hours fit a narrow window."""
    grid = Gtk.Grid(column_spacing=3, row_spacing=4, column_homogeneous=True)
    peak = max(values) or 1
    for i, v in enumerate(values):
        bar = Gtk.Box(valign=Gtk.Align.END)
        bar.add_css_class("w-bar")
        if i == top:
            bar.add_css_class("peak")
        bar.set_size_request(-1, max(3, round(height * v / peak)))
        grid.attach(bar, i, 0, 1, 1)
    for i, text in enumerate(labels or []):
        if text:
            span = next((j for j in range(i + 1, len(labels)) if labels[j]), len(labels)) - i
            lab = Gtk.Label(label=text, xalign=0.5 if span == 1 else 0)
            lab.add_css_class("w-small")
            grid.attach(lab, i, 1, span, 1)
    return grid


def w_label(text, css, wrap=True, xalign=0.0, ellipsize=False):
    lab = Gtk.Label(label=text, xalign=xalign, wrap=wrap, wrap_mode=Pango.WrapMode.WORD_CHAR)
    if ellipsize:
        lab.set_ellipsize(Pango.EllipsizeMode.END)
    for c in css.split():
        lab.add_css_class(c)
    return lab


def w_meter(fraction):
    """A thin bar, filled as far as fraction (0..1)."""
    bar = Gtk.ProgressBar(fraction=max(0.02, min(1.0, fraction)), hexpand=True, valign=Gtk.Align.CENTER)
    bar.add_css_class("w-meter")
    return bar


def w_stat(value, label):
    tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
    tile.add_css_class("w-tile")
    tile.append(w_label(value, "w-mid", wrap=False, ellipsize=True))
    tile.append(w_label(label, "w-small"))
    return tile


def w_stats(*tiles):
    grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True, margin_top=10)
    for i, (value, label) in enumerate(tiles):
        grid.attach(w_stat(value, label), i % 2, i // 2, 1, 1)
    return grid


def w_change(d):
    """"▲ 12% more than the month before", or None when there's nothing to compare with."""
    before, now = d.get("prev_count"), d.get("scrobbles") or 0
    if not before or d.get("kind") not in ("year", "month", "week"):
        return None
    pct = round((now - before) * 100 / before)
    than = f"this far into the {d['kind']} before" if d.get("partial") else f"the {d['kind']} before"
    text = (f"▲ {pct}% more than {than}" if pct > 0 else f"▼ {-pct}% less than {than}" if pct < 0
            else f"Just like {than}")
    lab = w_label(text, "w-chip", xalign=0)
    lab.add_css_class("up" if pct >= 0 else "down")
    lab.set_halign(Gtk.Align.START)
    return lab


def w_rule():
    rule = Gtk.Box(halign=Gtk.Align.START)
    rule.add_css_class("w-rule")
    return rule


def w_picture(path, px, round_=False):
    frame, pic = art_widget(px)
    frame.add_css_class("w-art")
    if round_:
        frame.add_css_class("w-round")
    frame.set_halign(Gtk.Align.START)
    tex = load_texture(path, px * 2) if path else None
    if tex:
        pic.set_from_paintable(tex)
    return frame


class WrappedWindow(Adw.Window):
    """Your week, month or year in music (or all of it) from your Last.fm history, a slide at
    a time: click the right of a slide (or press →) for the next, the left (←) to go back.
    F11 (or the button by the close one) fills the screen; so does maximizing it."""

    def __init__(self, app, period):
        super().__init__(title="Wrapped", default_width=430, default_height=780, resizable=True)
        self.app, self.period, self.seq, self.data = app, period, 0, None
        self.k = 1.0             # how much bigger pictures and charts are drawn: 1.5 full screen
        self.choices = []        # the picker's [(period, name)]
        self.add_css_class("wrapped")
        self.toasts = Adw.ToastOverlay()
        overlay = Gtk.Overlay()
        self.toasts.set_child(overlay)
        self.set_content(self.toasts)
        self.carousel = Adw.Carousel(allow_scroll_wheel=True, vexpand=True, hexpand=True)
        overlay.set_child(self.carousel)

        top = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=12, margin_start=16,
                      margin_end=12, margin_bottom=6)
        row = Gtk.Box(spacing=8)
        # A segment a slide, story style (libadwaita's indicator lines need ~40px a slide: too wide for 12)
        self.segments = Gtk.Box(spacing=4, homogeneous=True, hexpand=True, valign=Gtk.Align.CENTER)
        row.append(self.segments)
        self.carousel.connect("notify::n-pages", lambda *_: self.make_segments())
        self.carousel.connect("notify::position", lambda *_: self.light_segments())
        self.full = Gtk.Button(icon_name="view-fullscreen-symbolic", valign=Gtk.Align.CENTER,
                               tooltip_text="Full screen (F11)")
        self.full.add_css_class("w-nav")
        self.full.connect("clicked", lambda *_: self.toggle_fullscreen())
        row.append(self.full)
        close = Gtk.Button(icon_name="window-close-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Close (Esc)")
        close.add_css_class("w-nav")
        close.connect("clicked", lambda *_: self.close())
        row.append(close)
        top.append(row)

        # Week · Month · Year · All time, and which one of them
        row = Gtk.Box(spacing=8)
        tabs = Gtk.Box(valign=Gtk.Align.CENTER)
        tabs.add_css_class("linked")
        tabs.add_css_class("w-tabs")
        self.tabs, group = {}, None
        for kind, name in PERIOD_KINDS:
            b = Gtk.ToggleButton(label=name)
            b.add_css_class("w-tab")
            if group:
                b.set_group(group)
            group = group or b
            b.connect("toggled", self.on_tab, kind)
            self.tabs[kind] = b
            tabs.append(b)
        row.append(tabs)
        row.append(Gtk.Box(hexpand=True))
        self.picker = Gtk.DropDown(valign=Gtk.Align.CENTER, visible=False)
        self.picker.connect("notify::selected", self.on_pick)
        row.append(self.picker)
        top.append(row)
        # The bar moves the window (it has no title bar) and double-clicking it maximizes it.
        handle = Gtk.WindowHandle(child=top, valign=Gtk.Align.START)
        overlay.add_overlay(handle)

        click = Gtk.GestureClick()
        click.connect("released", self.on_click)
        self.carousel.add_controller(click)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("notify::fullscreened", lambda *_: self.on_size_mode())
        self.connect("notify::maximized", lambda *_: self.on_size_mode())
        # Its own app ID, so the music dropdown's window rules leave it alone.
        self.connect("realize", lambda *_: self.own_app_id())
        self.picking = False
        self.load(period)

    def own_app_id(self):
        try:
            gi.require_version("GdkWayland", "4.0")
            from gi.repository import GdkWayland
            surface = self.get_surface()
            if isinstance(surface, GdkWayland.WaylandToplevel):
                surface.set_application_id(APP_ID + ".wrapped")
        except (ImportError, ValueError, AttributeError):
            pass

    # ---- full screen ----
    def toggle_fullscreen(self):
        if self.is_fullscreen():
            self.unfullscreen()
        else:
            self.fullscreen()

    def on_size_mode(self):
        big = self.is_fullscreen() or self.is_maximized()
        self.full.set_icon_name("view-restore-symbolic" if self.is_fullscreen() else "view-fullscreen-symbolic")
        self.full.set_tooltip_text("Leave full screen (F11)" if self.is_fullscreen() else "Full screen (F11)")
        (self.add_css_class if big else self.remove_css_class)("big")
        k = 1.5 if big else 1.0
        if k != self.k:
            self.k = k
            if self.data:   # draw the slides again at the new size, staying on the same one
                at = round(self.carousel.get_position())
                self.show(self.data, None)
                n = self.carousel.get_n_pages()
                if n:
                    GLib.idle_add(lambda: (self.carousel.scroll_to(self.carousel.get_nth_page(min(at, n - 1)), False),
                                           False)[1])

    # ---- loading ----
    def load(self, period):
        self.seq += 1
        seq = self.seq
        self.period = period
        self.set_tabs(period)
        self.clear()
        slide = self.slide(0)
        spinner = Adw.Spinner(width_request=48, height_request=48, halign=Gtk.Align.START)
        slide.append(spinner)
        slide.append(w_label(period_name(period).upper(), "w-kicker"))
        slide.append(w_label("Your Wrapped is on its way", "w-big"))
        self.progress = w_label("", "w-sub")
        slide.append(self.progress)

        def progress(text):
            GLib.idle_add(lambda: (seq == self.seq and self.progress.set_label(text), False)[1])
        in_thread(wrapped_data, self.app, period, progress, done=lambda d, err: seq == self.seq and self.show(d, err))

    def clear(self):
        while self.carousel.get_n_pages():
            self.carousel.remove(self.carousel.get_nth_page(0))

    def make_segments(self):
        while child := self.segments.get_first_child():
            self.segments.remove(child)
        n = self.carousel.get_n_pages()
        for _ in range(n if n > 1 else 0):
            seg = Gtk.Box()
            seg.add_css_class("w-seg")
            self.segments.append(seg)
        self.light_segments()

    def light_segments(self):
        now = round(self.carousel.get_position())
        seg, i = self.segments.get_first_child(), 0
        while seg:
            (seg.add_css_class if i <= now else seg.remove_css_class)("on")
            seg, i = seg.get_next_sibling(), i + 1

    def slide(self, color):
        """A new page; returns the box to fill, centred on the page (its parent) and kept to
        a readable width however wide the window is."""
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, vexpand=True)
        page.add_css_class("slide")
        page.add_css_class(f"s{color % 8}")
        clamp = Adw.Clamp(maximum_size=round(560 * self.k), tightening_threshold=round(420 * self.k), vexpand=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=round(10 * self.k), vexpand=True,
                      valign=Gtk.Align.CENTER)
        clamp.set_child(box)
        page.append(clamp)
        self.carousel.append(page)
        return box

    def px(self, n):
        return round(n * self.k)

    def show(self, d, err):
        self.clear()
        if err:
            s = self.slide(4)
            s.append(w_label("COULDN'T OPEN YOUR WRAPPED", "w-kicker"))
            s.append(w_label(str(err)[:200], "w-sub"))
            retry = Gtk.Button(label="Try again", halign=Gtk.Align.START)
            retry.add_css_class("pill")
            retry.connect("clicked", lambda *_: self.load(self.period))
            s.append(retry)
            return
        self.data = d
        self.fill_picker(d)
        if d.get("empty"):
            s = self.slide(0)
            s.append(w_label(period_name(d["period"]).upper(), "w-kicker"))
            s.append(w_label("No scrobbles here yet", "w-big"))
            s.append(w_label("Play some music and come back: everything you play is scrobbled to Last.fm.", "w-sub"))
            return
        if d["period"] == "all":
            self.all_time(d)
        else:
            self.period_slides(d)

    def set_tabs(self, period):
        self.picking = True
        self.tabs[period_kind(period)].set_active(True)
        self.picking = False

    def fill_picker(self, d):
        self.choices = period_choices(period_kind(d["period"]), d["years"])
        self.picking = True
        if self.choices:
            self.picker.set_model(Gtk.StringList.new([name for _p, name in self.choices]))
            self.picker.set_selected(next((i for i, (p, _n) in enumerate(self.choices) if p == d["period"]), 0))
        self.picker.set_visible(bool(self.choices))
        self.picking = False

    def on_tab(self, button, kind):
        if self.picking or not button.get_active():
            return
        period = this_period(kind)
        if period != self.period:
            self.load(period)

    def on_pick(self, dd, _p):
        if self.picking or not self.choices:
            return
        i = dd.get_selected()
        if 0 <= i < len(self.choices) and self.choices[i][0] != self.period:
            self.load(self.choices[i][0])

    # ---- the slides ----
    def ranked(self, box, items, with_art=False, meter=False):
        top = max((item[2] if len(item) > 2 else item[1] for item in items), default=0) or 1
        for i, item in enumerate(items, 1):
            plays = item[2] if len(item) > 2 else item[1]
            row = Gtk.Box(spacing=12)
            row.append(w_label(str(i), "w-rank", wrap=False))
            if with_art:
                row.append(w_picture(item[3], self.px(44)))
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER, hexpand=True)
            name = Gtk.Label(label=item[0], xalign=0, ellipsize=Pango.EllipsizeMode.END)
            name.add_css_class("w-name")
            text.append(name)
            if len(item) > 2 and item[1]:
                text.append(w_label(item[1], "w-small", wrap=False, ellipsize=True))
            if meter:
                text.append(w_meter(plays / top))
            row.append(text)
            row.append(w_label(f"{plays:,}", "w-small", wrap=False))
            box.append(row)

    def period_slides(self, d):
        """A year's, a month's or a week's Wrapped."""
        period, user, kind = d["period"], d["user"], d["kind"]
        s = self.slide(0)
        s.append(w_label("YOUR", "w-kicker"))
        s.append(w_label(period_title(period), "w-huge w-accent"))
        s.append(w_label("WRAPPED", "w-big"))
        s.append(w_rule())
        s.append(w_label(f"{user} · {d['scrobbles']:,} scrobbles", "w-sub"))
        if chip := w_change(d):
            s.append(chip)
        s.append(w_label("Click, or press →, to start · F11 for full screen", "w-small"))

        s = self.slide(1)
        s.append(w_label("YOU LISTENED FOR", "w-kicker"))
        s.append(w_label(f"{d['minutes']:,}", "w-huge"))
        s.append(w_label("minutes", "w-big"))
        hours = d["minutes"] / 60
        s.append(w_label(f"That's {d['minutes'] / 1440:.1f} days of music." if hours >= 48
                         else f"That's {hours:.1f} hours of music.", "w-sub"))
        s.append(w_stats((f"{d['song_count']:,}", "different songs"), (f"{d['artist_count']:,}", "artists"),
                         (f"{d['days']} of {d['span_days']}", "days with music"),
                         (f"{round(d['minutes'] / d['span_days']):,}", "minutes a day")))

        if d["genres"]:
            s = self.slide(2)
            s.append(w_label("YOUR TOP GENRE", "w-kicker"))
            s.append(w_label(d["genres"][0], "w-big w-accent"))
            s.append(w_rule())
            more = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12)
            for i, g in enumerate(d["genres"][1:], 2):
                row = Gtk.Box(spacing=12)
                row.append(w_label(str(i), "w-rank", wrap=False))
                row.append(w_label(g, "w-name", wrap=False, ellipsize=True))
