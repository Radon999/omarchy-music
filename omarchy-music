def find_signed_in_browser():
    """(browser, youtube cookie header) for the first browser signed in to YouTube.

    Chromium encrypts cookies with a key held in the GNOME keyring; without
    the keyring (and the secretstorage module) every value decrypts to garbage
    and YouTube quietly treats the requests as signed out.
    """
    try:
        from yt_dlp.cookies import extract_cookies_from_browser
    except ImportError:
        return None, None
    keyring = cookie_keyring()
    for b in BROWSERS:
        try:
            jar = extract_cookies_from_browser(b, keyring=keyring if b != "firefox" else None,
                                               logger=_QuietLogger())
        except Exception:  # noqa: BLE001 -- browser not installed / locked
            continue
        cookies = {c.name: c.value for c in jar if c.domain.endswith("youtube.com")}
        if "__Secure-3PAPISID" in cookies:
            return b, "; ".join(f"{k}={v}" for k, v in cookies.items())
    return None, None


def cookie_keyring():
    return "GNOMEKEYRING" if subprocess.run(["pgrep", "-x", "gnome-keyring-d"],
                                            capture_output=True).returncode == 0 else None


class _QuietLogger:
    def debug(self, *_a, **_k): pass
    def info(self, *_a, **_k): pass
    def warning(self, *_a, **_k): pass
    def error(self, *_a, **_k): pass


class YTM:
    def __init__(self):
        from ytmusicapi import YTMusic
        from ytmusicapi.helpers import initialize_headers
        self.anon = YTMusic()
        self.browser, cookie = find_signed_in_browser()
        self.account = None
        if cookie:
            # Browser auth sends only these headers, so start from the normal
            # ones; the placeholder authorization marks it as browser auth and
            # ytmusicapi recomputes the real SAPISIDHASH on every request.
            headers = dict(initialize_headers())
            headers.update({"cookie": cookie, "x-goog-authuser": "0", "origin": "https://music.youtube.com",
                            "authorization": "SAPISIDHASH 0_0"})
            try:
                self.account = YTMusic(auth=headers)
                self.account.get_account_info()
            except Exception:  # noqa: BLE001 -- expired login: stay anonymous
                self.account = None

    @property
    def api(self):
        return self.account or self.anon

    def search(self, q):
        m = re.search(r"[?&]list=([\w-]+)", q)
        if m:
            return self.playlist(m.group(1))
        m = re.search(r"(?:v=|youtu\.be/)([\w-]{11})", q)
        if m:
            return self.radio(m.group(1))[:1]
        return [t for t in map(track_from_ytm, self.api.search(q, filter="songs", limit=30)) if t]

    def radio(self, vid):
        tracks = self.api.get_watch_playlist(videoId=vid, limit=40).get("tracks", [])
        return [t for t in map(track_from_ytm, tracks) if t]

    def my_playlists(self):
        out = []
        for p in self.account.get_library_playlists(limit=None):
            if not p.get("playlistId"):
                continue
            thumbs = p.get("thumbnails") or []
            out.append({"id": p["playlistId"], "title": p.get("title") or "Playlist",
                        "count": p.get("count") or "", "thumb": thumbs[-1]["url"] if thumbs else ""})
        return out

    def liked_ids(self):
        tracks = self.account.get_liked_songs(limit=None).get("tracks", [])
        return {t["videoId"] for t in tracks if t.get("videoId")}

    def rate(self, vid, like):
        from ytmusicapi.models.content.enums import LikeStatus
        self.account.rate_song(vid, LikeStatus.LIKE if like else LikeStatus.INDIFFERENT)

    def playlist(self, pid):
        api = self.account or self.anon
        return [t for t in map(track_from_ytm, api.get_playlist(pid, limit=None).get("tracks", [])) if t]

    def library_tracks(self):
        """Every song in your liked songs and playlists, each once."""
        ids = [p["id"] for p in self.my_playlists()]
        if "LM" not in ids:
            ids.insert(0, "LM")   # liked music
        seen, out = set(), []
        for pid in ids:
            try:
                tracks = self.playlist(pid)
            except Exception:  # noqa: BLE001 -- skip a playlist that won't load
                continue
            for t in tracks:
                if t["id"] not in seen:
                    seen.add(t["id"])
                    out.append(t)
        return out


