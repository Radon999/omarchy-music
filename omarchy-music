        tidal = a.dl.tidal
        if tidal and tidal.connected:
            line("Tidal", "Connected · songs play in FLAC (lossy only where Tidal has no FLAC)", True, sync_switch("tidal"))
            keep = Gtk.Switch(active=a.keep_played, valign=Gtk.Align.CENTER)
