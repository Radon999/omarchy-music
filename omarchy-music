        title = Gtk.Label(label=track["title"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
        title.add_css_class("title")
        sub = Gtk.Box()
        sub.append(artist_link(win, track["artist"]))
        rest = "".join(f" · {x}" for x in (fmt_time(track["duration"]) if track.get("duration") else "", extra) if x)
        if rest:
            more = Gtk.Label(label=rest, xalign=0)
            more.add_css_class("sub")
            sub.append(more)
        text.append(title)
        text.append(sub)
        box.append(text)
        self.box, self.removable, self.mark, self.mark_state = box, removable, None, None
        self.update_mark()
        self.set_child(box)

    def update_mark(self):
        """The mark at the end of the row: saved, saving, not on Tidal, or a download button."""
        win, track, vid = self.win, self.track, self.track["id"]
        state = ("file" if source_of(track) == "file" else "remove" if self.removable else "saved" if win.lib.has(vid)
                 else "busy" if win.dl.busy(vid) else "missing" if win.lib.recently_missing(vid) else "download")
        if state == self.mark_state:
            return
        self.mark_state = state
        if self.mark is not None:
            self.box.remove(self.mark)
        if state == "remove":
            mark = icon_button("user-trash-symbolic", "row-action", "Remove download", lambda: win.remove_download(vid))
        elif state == "saved":
            mark = Gtk.Label(label="✓", tooltip_text="Downloaded: plays without data")
            mark.add_css_class("saved")
        elif state == "busy":
            mark = Adw.Spinner()
        elif state == "missing":
            mark = Gtk.Label(label="–", tooltip_text="No lossless copy on Tidal: skipped")
            mark.add_css_class("pending")
        elif state == "download":
            mark = icon_button("folder-download-symbolic", "row-action", "Download in FLAC", lambda: win.download_only(track))
        else:
            mark = None
        self.mark = mark
        if mark is not None:
            self.box.append(mark)

    def on_press(self, gesture, _n, _x, _y):
        state = gesture.get_current_event_state()
        if state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK) and self.group is not None:
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            self.win.start_selecting(self, extend=bool(state & Gdk.ModifierType.SHIFT_MASK))

    def show_check(self, on, picked=False):
        self.check.set_visible(on)
        if self.check.get_active() != picked:
            self.check.set_active(picked)


