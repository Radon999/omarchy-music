    def add_folder(self):
        dlg = Gtk.FileDialog(title="Add a music folder", initial_folder=Gio.File.new_for_path(str(HOME)))

        def chosen(d, res):
            try:
                folder = d.select_folder_finish(res)
            except GLib.Error:
                return   # cancelled
            if folder and folder.get_path():
                self.app.add_folder(folder.get_path())
        dlg.select_folder(self, None, chosen)

    def pick_m3u(self):
        """Pick an .m3u8 (or .m3u) file and make a playlist of its songs."""
        filt = Gtk.FileFilter(name="Playlists (.m3u8, .m3u)")
        for pat in ("*.m3u8", "*.m3u", "*.M3U8", "*.M3U"):
            filt.add_pattern(pat)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filt)
        dlg = Gtk.FileDialog(title="Import a playlist", filters=filters, default_filter=filt,
                             initial_folder=Gio.File.new_for_path(str(HOME / "Music") if (HOME / "Music").is_dir() else str(HOME)))

        def chosen(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return   # cancelled
            if f and f.get_path():
                self.app.import_playlist(f.get_path())
        dlg.open(self, None, chosen)

