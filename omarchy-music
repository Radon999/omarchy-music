    @staticmethod
    def rows(lst):
        child = lst.get_first_child() if lst else None
        while child:
            if isinstance(child, TrackRow):
                yield child
            child = child.get_next_sibling()

    # Long lists (a big music folder has thousands of songs) get their rows as you scroll: each
    # row costs a few tenths of a millisecond to make and lay out, so all of them at once froze
    # the window for seconds, worst on Windows.
    # The rows you see come at once; the next ones a few at a time between frames, so the
    # window keeps drawing while they're made.
    LAZY_FIRST, LAZY_AHEAD, LAZY_CHUNK = 30, 120, 15

    def lazy(self, lst, n, add, first=0):
        """Rows 0..n-1 at the end of lst, each made by add(i): the first LAZY_FIRST (or first) now,
        more as you scroll near the bottom. A rebuild of lst drops what was still to come."""
        if not hasattr(self, "_lazy"):
            self._lazy = {}
        st = {"made": 0, "want": 0, "pump": False}
        mark = []

        def alive():
            return self._lazy.get(id(lst)) is more and not (mark and mark[0].get_parent() is not lst)

        def make(count):
            end = min(n, st["made"] + count)
            for i in range(st["made"], end):
                add(i)
            st["made"] = end
            if end >= n:
                self._lazy.pop(id(lst), None)

        def pump():
            if not alive() or st["made"] >= st["want"]:
                st["pump"] = False
                return False
            make(self.LAZY_CHUNK)
            return True

        def more(count, now=False):
            """count rows more: now, or between frames."""
            if not alive():
                return False
            if now:
                make(count)
                return True
            st["want"] = max(st["want"], st["made"] + count)
            if not st["pump"]:
                st["pump"] = True
                GLib.idle_add(pump)   # below drawing (and input) in priority: frames come between
            return True
        self._lazy[id(lst)] = more
        make(max(self.LAZY_FIRST, first))
        last = lst.get_last_child()
        if last is not None:
            mark.append(last)
        if alive():
            more(self.LAZY_AHEAD)
        self.watch_scroll(lst)

    def lazy_all(self, lst):
        """Every row of lst made now (to select all of them)."""
        more = getattr(self, "_lazy", {}).get(id(lst))
        while more and more(10 ** 6, now=True) and self._lazy.get(id(lst)) is more:
            pass

    def watch_scroll(self, lst):
        sw = lst.get_ancestor(Gtk.ScrolledWindow)
        if not sw or getattr(lst, "lazy_watched", False):
            return
        lst.lazy_watched = True
        adj = sw.get_vadjustment()

        def check(a, *_):
            more = getattr(self, "_lazy", {}).get(id(lst))
            if more and a.get_value() + 3 * a.get_page_size() >= a.get_upper():
                more(self.LAZY_AHEAD)
        adj.connect("value-changed", check)
        adj.connect("changed", check)

    @staticmethod
    def scroll_top(lst):
        sw = lst.get_ancestor(Gtk.ScrolledWindow)
        if sw:
            sw.get_vadjustment().set_value(0)

    # ---- the Music tab: all your songs, your playlists, recent, most played ----
    MUSIC_VIEWS = (("all", "All", "All your songs: downloaded here and in your folders"),
                   ("playlists", "Playlists", "The playlists you make here"),
                   ("recent", "Recent", "Recently played"),
                   ("top", "Most played", "The songs you play most"),
                   ("dj", "DJ", "Your DJ: songs you love, ones you haven't heard in a while and new ones, in sets"))
    # How All is sorted: by title, by artist or album (in groups), or newest first.
    MUSIC_SORTS = (("title", "Title"), ("artist", "Artist"), ("album", "Album"), ("added", "Added"))

    def music_chips(self):
        self.chips = Adw.ToggleGroup(halign=Gtk.Align.START)
        self.chips.add_css_class("sources")
        for name, label, tip in self.MUSIC_VIEWS:
            self.chips.add(Adw.Toggle(label=label, name=name, tooltip=tip))
        self.chips.set_active_name(self.music_view)
        self.chips.connect("notify::active-name", lambda g, _p: g.get_active_name() != self.music_view
                           and self.set_music_view(g.get_active_name()))
        box = Gtk.Box()
        box.add_css_class("chips")
        box.append(self.chips)
        return box

    def set_music_view(self, view):
        if self.selecting:
            self.stop_selecting()
        if view == "added":   # it was a list of its own; now it's All, newest first
            view, self.app.music_sort = "all", "added"
        self.music_view, self.open_mine = view, None
        if self.chips.get_active_name() != view:
            self.chips.set_active_name(view)
        self.refresh_music()
        self.scroll_top(self.music_list)

    def show_mine(self, pid):
        """One of your playlists, open in the Music tab."""
        self.music_view = "playlists"
        self.chips.set_active_name("playlists")
        self.show_tab("music")
        self.open_mine = pid
        self.refresh_music()
        self.scroll_top(self.music_list)

    count_label = None

    def refresh_count(self):
        if not self.count_label:
            return
        saved = len({t["file"] for t in self.lib.items.values()})   # a song saved from two services is one file
        local = len(self.app.local.files)
        parts = [f"{saved + local} songs"]
        if saved:
            parts.append(f"{saved} downloaded · {self.lib.size_text()}")
        if local:
            parts.append(f"{local} in your folders")
        self.count_label.set_label(" · ".join(parts).upper())

    def refresh_music(self):
        """The Music tab, as the chips above it say (once you can see it)."""
        self.when_shown("music", self._refresh_music)

    def _refresh_music(self):
        lst, view, a = self.music_list, self.music_view, self.app
        self.count_label = None
        if view == "playlists":
            self.refresh_playlists()
            return
        if view == "dj":
            self.refresh_dj()
            return
        sort = a.music_sort
        if view == "all":
            tracks = a.my_songs()
            lead = lambda t: norm(t["artist"].split(",")[0]) or "~"   # noqa: E731 -- songs without an artist go last
            tracks.sort(key={
                "title": lambda t: (norm(t["title"]), norm(t["artist"])),
                "artist": lambda t: (lead(t), norm(t.get("album")), norm(t["title"])),
                "album": lambda t: (norm(t.get("album")) or "~", lead(t), norm(t["title"])),
                "added": lambda t: -(t.get("added") or 0),
            }.get(sort, lambda t: norm(t["title"])))
        elif view == "recent":
            tracks = a.plays.recent()
        else:
            tracks = a.most_played()
        # The same songs in the same order as shown: only the marks may have changed.
        sig = (view, sort, tuple(t["id"] for t in tracks), a.lastfm.connected and bool(a.fm_top[1]))
        if sig == getattr(self, "_music_sig", None) and lst.get_first_child() is not None:
            self.refresh_count()
            self.mark_rows()
            return
        same_view = (getattr(self, "_music_sig", None) or (None, None))[:2] == sig[:2]
        self._music_sig = sig
        sw = lst.get_ancestor(Gtk.ScrolledWindow)
        keep = sw.get_vadjustment().get_value() if sw and same_view else 0
        made = sum(1 for _ in self.rows(lst)) if keep else 0
        if not tracks:
            folders = ", ".join(short_path(f) for f in a.folders) or "no folders yet"
            title, body = {
                "all": ("No music yet", f"Songs you download, and the music in your folders\n({folders}), show up here."),
                "recent": ("Nothing played yet", "The songs you listen to show up here, the last one first."),
                "top": ("Nothing played yet", "The songs you play most show up here."),
            }[view]
            self.set_empty(lst, title, body)
            return
        lst.remove_all()
        if view == "all":
            self.count_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.count_label.add_css_class("section")
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.count_label))
            self.refresh_count()
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips()))
        else:
            self.section(lst, {"recent": "RECENTLY PLAYED", "top": "MOST PLAYED · LAST.FM" if a.lastfm.connected and a.fm_top[1]
                               else "MOST PLAYED"}[view])
        group = [None]

        def add(i):
            t = tracks[i]
            if view == "all" and sort in ("artist", "album"):
                artist = t["artist"].split(",")[0].strip() or "Unknown artist"
                g = norm(artist) if sort == "artist" else norm(t.get("album"))
                if g != group[0]:
                    group[0] = g
                    self.group_head(lst, artist if sort == "artist" else t.get("album") or "No album",
                                    None if sort == "artist" else artist)
            extra = f"{t['plays']} play{'s' if t['plays'] != 1 else ''}" if view == "top" else ""
            self.add_track(lst, t, i, tracks, removable=view == "all" and self.lib.has(t["id"]), extra=extra)
        self.lazy(lst, len(tracks), add, first=made)
        if keep:   # the same list with a song more or less: stay where you were in it
            GLib.idle_add(lambda: (sw.get_vadjustment().set_value(keep), False)[1])

    def refresh_dj(self):
        """The DJ: what it said last, Start or Switch it up, a box to ask it for something, and its songs to come."""
        lst, a = self.music_list, self.app
        self._music_sig = None
        lst.remove_all()
        dj = a.dj
        shown = dj["sets"].get(str(dj.get("shown") or "")) if dj["on"] else None
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.add_css_class("dj")
        head = Gtk.Label(label="DJ" + (f" · {DJ_KINDS.get(shown['kind'], '').upper()}" if shown else ""), xalign=0)
        head.add_css_class("section")
        box.append(head)
        line = Gtk.Label(xalign=0, wrap=True, label=shown["line"] if shown else
                         "Your own DJ: a mix of the songs you love, ones you haven't heard in a while and new ones from "
                         "Tidal and YouTube Music, a few at a time. Switch it up for something else, or ask for a mood, "
                         "a decade, a genre or an artist.")
        line.add_css_class("dj-line")
        box.append(line)
        if a.dj_busy:
            busy = Gtk.Label(label=a.dj_busy, xalign=0)
            busy.add_css_class("sub")
            box.append(busy)
        src = dj.get("from")
        name = (a.dj_source(src) or ("songs that are gone",))[0] if src else "everything"
        pick = Gtk.Button(label=f"From: {name}  ▾", halign=Gtk.Align.START, sensitive=not a.dj_busy,
                          tooltip_text="Play from everything, or only from your music, a folder or a playlist")
        pick.add_css_class("pill")
        pick.add_css_class("quiet")
        pick.connect("clicked", self.dj_from_menu)
        box.append(pick)
        btns = Gtk.Box(spacing=6)
        for label, cb, quiet in ([("↻  Switch it up", lambda _b: a.dj_switch(), False), ("Stop the DJ", lambda _b: a.dj_stop(), True)]
                                 if dj["on"] else [("▶  Start the DJ", lambda _b: a.dj_start(), False)]):
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER, sensitive=not a.dj_busy)
            b.add_css_class("pill")
            if quiet:
                b.add_css_class("quiet")
            b.connect("clicked", cb)
            btns.append(b)
        box.append(btns)
        ask = Gtk.Entry(placeholder_text="Ask the DJ: something chill, 2010s, house, Daft Punk…", hexpand=True)
        ask.connect("activate", lambda e: e.get_text().strip() and a.dj_switch(ask=e.get_text()))
        box.append(ask)
        lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=box))
        if dj["on"]:
            coming = [(i, t) for i, t in enumerate(a.queue) if i >= a.index and t.get("dj")]
            if coming:
                self.section(lst, "FROM THE DJ")
                group = [t for _i, t in coming]
                for j, (i, t) in enumerate(coming):
                    row = self.add_track(lst, t, j, group, extra=DJ_KINDS.get((dj["sets"].get(str(t["dj"])) or {}).get("kind"), ""))
                    row.queue_index = i
        elif not a.dj_busy and not (a.lastfm.connected or a.plays.items):
            hint = Gtk.Label(label="Play some songs first, or connect Last.fm in the accounts menu (☰): the DJ picks from what you listen to.",
                             xalign=0, wrap=True)
            hint.add_css_class("sub")
            hint.set_margin_start(8)
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=hint))

    def dj_from(self, src):
        """Start the DJ on src (see MusicApp.dj_source) and show it."""
        self.app.dj_start(src)
        self.show_tab("music")
        self.set_music_view("dj")

    def dj_from_menu(self, parent):
        """What the DJ plays from: everything, your music, one of your folders (or a folder in
        one), a playlist, or any folder you choose."""
        a = self.app
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        head = Gtk.Label(label="PLAY FROM", xalign=0)
        head.add_css_class("section")
        box.append(head)
        pop = Gtk.Popover(child=Gtk.ScrolledWindow(child=box, propagate_natural_height=True, max_content_height=420,
                                                   hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_width=True))
        pop.set_parent(parent)

        def item(label, cb):
            b = Gtk.Button(label=label)
            b.add_css_class("menu-item")
            b.get_child().set_xalign(0)
            b.get_child().set_ellipsize(Pango.EllipsizeMode.END)
            # After the menu has let go of its button: picking rebuilds the DJ screen, button and all.
            b.connect("clicked", lambda *_: (pop.popdown(), GLib.idle_add(lambda: (cb(), False)[1])))
            box.append(b)
        item("Everything: your history and new songs", lambda: self.dj_from({"kind": "all"}))
        mine = a.my_songs()
        item(f"All your music · {len(mine)}", lambda: self.dj_from({"kind": "mine"}))
        for folder in a.folders:
            root = str(Path(folder).expanduser()).rstrip("/\\")
            inside = [str(t.get("file") or "")[len(root) + 1:] for t in mine if str(t.get("file") or "").startswith(root + os.sep)]
            if not inside:
                continue
            item(f"{short_path(root)} · {len(inside)}", lambda r=root: self.dj_from({"kind": "folder", "path": r}))
            subs = Counter(rel.split(os.sep)[0] for rel in inside if os.sep in rel)
            for sub in sorted(subs, key=str.lower):
                item(f"      {sub} · {subs[sub]}", lambda r=os.path.join(root, sub): self.dj_from({"kind": "folder", "path": r}))
        for pl in a.lists.all():
            if pl["tracks"]:
                item(f"{pl['name']} · {len(pl['tracks'])}", lambda pid=pl["id"]: self.dj_from({"kind": "playlist", "id": pid}))
        item("Choose a folder…", self.dj_pick_folder)
        pop.connect("closed", lambda p: GLib.idle_add(lambda: (p.unparent(), False)[1]))
        pop.popup()

    def dj_pick_folder(self):
        dlg = Gtk.FileDialog(title="Play a folder with the DJ",
                             initial_folder=Gio.File.new_for_path(str(HOME / "Music") if (HOME / "Music").is_dir() else str(HOME)))

        def chosen(d, res):
            try:
                f = d.select_folder_finish(res)
            except GLib.Error:
                return   # cancelled
            if f and f.get_path():
                self.dj_from({"kind": "folder", "path": f.get_path()})
        dlg.select_folder(self, None, chosen)

    def sort_chips(self):
        group = Adw.ToggleGroup(halign=Gtk.Align.START)
        group.add_css_class("sources")
        for name, label in self.MUSIC_SORTS:
            group.add(Adw.Toggle(label=label, name=name, tooltip=f"Sort by {label.lower()}"))
        group.set_active_name(self.app.music_sort)

        def picked(g, _p):
            if g.get_active_name() and g.get_active_name() != self.app.music_sort:
                self.app.music_sort = g.get_active_name()
                self.app.save_soon()
                GLib.idle_add(lambda: (self.refresh_music(), self.scroll_top(self.music_list), False)[2])
        group.connect("notify::active-name", picked)
        box = Gtk.Box()
        box.add_css_class("chips")
        box.append(group)
        return box

    def group_head(self, lst, title, sub=None):
        """A heading in All sorted by artist (click it for the artist's page) or by album."""
        label = Gtk.Label(label=title, xalign=0, ellipsize=Pango.EllipsizeMode.END)
        label.add_css_class("group-head")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(label)
        if sub:
            s = Gtk.Label(label=sub, xalign=0, ellipsize=Pango.EllipsizeMode.END)
            s.add_css_class("sub")
            box.append(s)
        if sub is None:
            btn = Gtk.Button(child=box, tooltip_text=f"{title}: their page")
            btn.add_css_class("flat")
            btn.connect("clicked", lambda _b: self.open_artist(title))
            box = btn
        lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=box))

    def refresh_playlists(self):
        lst = self.music_list
        self._music_sig = None
        if self.open_mine:
            self.refresh_mine()
            return
        lst.remove_all()
        lst.append(self.action_row("＋  New playlist", "new-playlist"))
        lst.append(self.action_row("⤓  Import a playlist (.m3u8)", "import-m3u"))
        lists = self.app.lists.all()
        if not lists:
            self.section(lst, "NO PLAYLISTS YET")
            hint = Gtk.Label(label="Make one here, or right-click any song (or select a few)\nand pick Add to playlist.",
                             xalign=0, wrap=True)
            hint.add_css_class("sub")
            hint.set_margin_start(8)
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=hint))
        for pl in lists:
            cover = next((t for t in pl["tracks"] if t.get("thumb") or source_of(t) == "file"), None)
            lst.append(PlaylistRow(self, {"id": pl["id"], "title": pl["name"], "thumb": "", "count": len(pl["tracks"])},
                                   cover=cover, icon="view-list-symbolic"))

    def refresh_mine(self):
        """One of your playlists, open."""
        lst = self.music_list
        self._music_sig = None
        pl = self.app.lists.get(self.open_mine)
        if not pl:
            self.open_mine = None
            self.refresh_playlists()
            return
        lst.remove_all()
        lst.append(self.action_row(f"‹  {pl['name']}", "mine-back"))
        tracks = [dict(t) for t in pl["tracks"]]
        buttons = [("Play", lambda _b: self.app.play_list(tracks), False),
                   ("Shuffle", lambda _b: self.app.play_list(tracks, shuffled=True), False),
                   ("DJ", lambda _b, pid=pl["id"]: self.dj_from({"kind": "playlist", "id": pid}), True),
                   ("Rename", lambda _b: self.rename_mine(), True)]
        if any(source_of(t) != "file" and not self.lib.has(t["id"]) for t in tracks):
            buttons.append(("Download", lambda _b: self.app.download(tracks), True))
        buttons.append(("Delete", lambda _b: self.delete_mine(), True))
        self.actions_row(lst, buttons if tracks else buttons[3:])
        if not tracks:
            self.section(lst, "EMPTY: RIGHT-CLICK A SONG › ADD TO PLAYLIST")
            return
        self.section(lst, f"{len(tracks)} SONG{'S' if len(tracks) != 1 else ''} · {fmt_total(tracks)}")
        self.lazy(lst, len(tracks), lambda i: self.add_track(lst, tracks[i], i, tracks))

    def rename_mine(self):
        pl = self.app.lists.get(self.open_mine)
        if pl:
            self.ask_name("Rename playlist", pl["name"], lambda name: self.app.rename_playlist(pl["id"], name))

    def delete_mine(self):
        pl = self.app.lists.get(self.open_mine)
        if not pl:
            return
        dlg = Adw.AlertDialog(heading=f"Delete “{pl['name']}”?",
                              body="Only the playlist goes: its songs stay in your music.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("delete", "Delete")
        dlg.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "delete" and self.app.delete_playlist(pl["id"]))
        dlg.present(self)

    def ask_name(self, heading, text, done, ok="Save"):
        """Ask for a name (of a playlist) in a dialog over the window; done(name) unless cancelled."""
        dlg = Adw.AlertDialog(heading=heading)
        entry = Gtk.Entry(text=text, activates_default=True, placeholder_text="Name")
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("ok", ok)
        dlg.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("ok")
        dlg.set_close_response("cancel")

        def answered(_d, response):
            name = entry.get_text().strip()
            if response == "ok" and name:
                done(name)
        dlg.connect("response", answered)
        dlg.present(self)
        entry.grab_focus()

