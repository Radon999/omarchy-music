    def save_picture(self, slide, button, title):
        button.set_visible(False)   # not in the picture
        # That throws away the slide's last drawing, which is what gets saved: wait for the next frame to draw it again.
        clock = self.get_frame_clock()

        def painted(*_):
            clock.disconnect(handler)
            GLib.idle_add(lambda: (self._render(slide, button, title), False)[1])
        handler = clock.connect("after-paint", painted)
        slide.queue_draw()

    def _render(self, slide, button, title):
        try:
            paintable = Gtk.WidgetPaintable.new(slide)   # padding and all, unlike get_width()
            w, h, scale = paintable.get_intrinsic_width(), paintable.get_intrinsic_height(), 2
            snap = Gtk.Snapshot()
            snap.scale(scale, scale)
            paintable.snapshot(snap, w, h)
            node = snap.to_node()
            if node is None:
                raise RuntimeError("the slide wasn't drawn yet")
            tex = self.get_renderer().render_texture(node, Graphene.Rect().init(0, 0, w * scale, h * scale))
            pictures = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or HOME / "Pictures")
            name = re.sub(r'[<>:"/\\|?*]', "", f"Wrapped {title.title()} · {self.data['user']}.png")
            path = pictures / name
            path.parent.mkdir(parents=True, exist_ok=True)
            tex.save_to_png(str(path))
            self.toasts.add_toast(Adw.Toast(title=f"Saved to {path.parent.name}/{path.name}", timeout=4))
        except Exception as e:  # noqa: BLE001 -- say why
            self.toasts.add_toast(Adw.Toast(title=f"Couldn't save it: {str(e)[:80]}", timeout=4))
        button.set_visible(True)

    # ---- moving around ----
    def go(self, step):
        n = self.carousel.get_n_pages()
        i = max(0, min(n - 1, round(self.carousel.get_position()) + step))
        if n:
            self.carousel.scroll_to(self.carousel.get_nth_page(i), True)

    def on_click(self, gesture, _n, x, _y):
        if gesture.get_current_button() == Gdk.BUTTON_PRIMARY:
            self.go(-1 if x < self.carousel.get_width() * 0.3 else 1)

    def on_key(self, _ctl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            if self.is_fullscreen():
                self.unfullscreen()
            else:
                self.close()
        elif keyval in (Gdk.KEY_F11, Gdk.KEY_f):
            self.toggle_fullscreen()
        elif keyval in (Gdk.KEY_Right, Gdk.KEY_space, Gdk.KEY_l, Gdk.KEY_Page_Down):
            self.go(1)
        elif keyval in (Gdk.KEY_Left, Gdk.KEY_h, Gdk.KEY_Page_Up):
            self.go(-1)
        elif keyval == Gdk.KEY_Home:
            self.go(-999)
        elif keyval == Gdk.KEY_End:
            self.go(999)
        else:
            return False
        return True


AUDIO_EXT = {".flac", ".mp3", ".m4a", ".mp4", ".aac", ".ogg", ".oga", ".opus", ".wav", ".wv", ".ape", ".aif", ".aiff"}


def track_from_file(path):
    """A song on disk (anything mpv plays), named from its tags, else its file name."""
    path = Path(path).expanduser().resolve()
    title, artist, album, dur = path.stem, "", "", 0
    try:
        import mutagen
        f = mutagen.File(path, easy=True)
        if f is not None:
            tags = f.tags or {}
            title = (tags.get("title") or [title])[0]
            artist = ", ".join(tags.get("artist") or [])
            album = (tags.get("album") or [""])[0]
            dur = round(getattr(f.info, "length", 0) or 0)
    except Exception:  # noqa: BLE001 -- untagged, or not audio mutagen knows: the file name, then
        pass
    return {"id": "f" + hashlib.sha1(str(path).encode()).hexdigest()[:16], "source": "file", "file": str(path),
            "title": title, "artist": artist or "Unknown artist", "album": album, "duration": dur, "thumb": ""}


