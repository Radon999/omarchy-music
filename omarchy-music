        s = self.slide(6)
        s.append(w_label("YOUR TOP SONGS", "w-kicker"))
        lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12)
        self.ranked(lst, [(t, a, p, img) for t, a, p, img, _f in d["songs"][:5]], with_art=True, meter=True)
        s.append(lst)

        if d["albums"]:
            album, artist, plays, art = d["albums"][0]
            s = self.slide(7)
            s.append(w_label("YOUR TOP ALBUM", "w-kicker"))
            s.append(w_picture(art, self.px(220)))
            s.append(w_label(album, "w-big"))
            s.append(w_label(f"{artist} · {plays:,} plays", "w-sub"))
            if len(d["albums"]) > 1:
                lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=10)
                for i, (al, ar, p, img) in enumerate(d["albums"][1:4], 2):
