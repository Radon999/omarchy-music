def art_color(path):
    """The colour a cover mostly is: its most common hue, vivid pixels counting
    more than grey ones. (r, g, b) 0..255, or None for an unreadable picture."""
    try:
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 32, 32, False)
    except GLib.Error:
        return None
    px, n, stride = pb.get_pixels(), pb.get_n_channels(), pb.get_rowstride()
    buckets = {}
    for y in range(pb.get_height()):
        for x in range(pb.get_width()):
            i = y * stride + x * n
            r, g, b = px[i], px[i + 1], px[i + 2]
            h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
            if v < 0.1:
                continue   # black borders and shadows say nothing about the cover
            w = 0.2 + s * v
            acc = buckets.setdefault((int(h * 12) % 12, int(s * 3), int(v * 3)), [0.0, 0.0, 0.0, 0.0])
            acc[0] += r * w
            acc[1] += g * w
            acc[2] += b * w
            acc[3] += w
    if not buckets:
        return (24, 24, 24)
    best = max(buckets.values(), key=lambda a: a[3])
    return tuple(round(c / best[3]) for c in best[:3])


def tint_css(rgb, light):
    """The window and the player bar in the cover's colour, dark (or light) enough
    that the theme's text stays readable on it."""
    h, _l, s = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
    s = min(s, 0.6)

    def shade(lightness):
        r, g, b = (round(c * 255) for c in colorsys.hls_to_rgb(h, lightness, s))
        return f"#{r:02x}{g:02x}{b:02x}"
    window, bar = (shade(0.9), shade(0.84)) if light else (shade(0.15), shade(0.09))
    return (f"window.main {{ background-color: {rgba(window, OPACITY)}; }}\n"
            f"window.main .player, window.main .selectbar {{ background-color: {rgba(bar, OPACITY)}; }}\n")


