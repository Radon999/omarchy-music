class LyricsView(Gtk.Box):
    """The Lyrics tab: Genius's text, or the lines timed to the music with the
    one being sung lit up and kept in view (click a line to jump there)."""

    def __init__(self, win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win, self.app = win, win.app
        self.track_id, self.got, self.seq = None, None, 0
        self.times, self.labels, self.cur = [], [], -1
        self.syncing, self.anim, self.user_scrolled = False, None, 0.0
        head = Gtk.Box(spacing=8)
        head.add_css_class("lyrics-head")
        self.from_label = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        self.from_label.add_css_class("lyrics-from")
        self.mode = Adw.ToggleGroup(valign=Gtk.Align.CENTER, visible=False)
        self.mode.add_css_class("sources")
        self.mode.add(Adw.Toggle(label="Genius", name="genius"))
        self.mode.add(Adw.Toggle(label="Synced", name="synced"))
        self.mode.connect("notify::active-name", self.on_mode)
        head.append(self.from_label)
        head.append(self.mode)
        self.append(head)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.body.add_css_class("lyrics")
        self.scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True, child=self.body)
        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", lambda *_: setattr(self, "user_scrolled", time.monotonic()) or False)
        self.scroller.add_controller(scroll)
        self.append(self.scroller)

    def clear(self):
        while (child := self.body.get_first_child()):
            self.body.remove(child)
        self.times, self.labels, self.cur = [], [], -1

    def message(self, title, body=""):
        self.clear()
        self.from_label.set_label("")
        self.mode.set_visible(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.add_css_class("empty")
        t = Gtk.Label(label=title, wrap=True, justify=Gtk.Justification.CENTER)
        t.add_css_class("empty-title")
        box.append(t)
        if body:
            box.append(Gtk.Label(label=body, wrap=True, justify=Gtk.Justification.CENTER))
        self.body.append(box)

    def show_for(self, track, refresh=False):
        if not track:
            self.track_id = None
            self.message("Nothing playing", "The lyrics of the song that's playing show up here.")
            return
        if track["id"] == self.track_id and not refresh:
            return
        self.track_id, self.got = track["id"], None
        self.seq += 1
        seq = self.seq
        self.message("Finding the lyrics…", f"{track['title']} · {track['artist']}")
        in_thread(self.app.lyrics.get, track, refresh, done=lambda got, err: seq == self.seq and self.render(got, err))

    def render(self, got, err):
        if err:
            self.message("Couldn't get the lyrics", str(err)[:140])
            return
        if not got:
            self.message("No lyrics found", "Genius, Tidal and LRCLIB don't have this song.")
            return
        if got.get("instrumental") and not (got.get("plain") or got.get("synced")):
            self.message("Instrumental", "No words in this one.")
            return
        self.got = got
        synced, plain = bool(parse_lrc(got.get("synced"))), bool(got.get("plain"))
        mode = self.app.lyrics_mode
        if mode == "synced" and not synced:
            mode = "genius"
        if mode == "genius" and not plain:
            mode = "synced"
        self.mode.set_visible(synced and plain)
        self.syncing = True
        self.mode.set_active_name(mode)
        self.syncing = False
        self.draw(mode)

    def on_mode(self, group, _p):
        if not self.syncing and self.got:
            self.app.set_lyrics_mode(group.get_active_name())
            self.draw(group.get_active_name())

    def draw(self, mode):
        self.clear()
        got = self.got
        if mode == "synced":
            self.from_label.set_label(f"TIMED · {(got.get('synced_from') or '').upper()}")
            for t, words in parse_lrc(got["synced"]):
                lab = Gtk.Label(label=words or "♪", xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
                lab.add_css_class("lyric-line")
                lab.set_cursor_from_name("pointer")
                click = Gtk.GestureClick()
                click.connect("released", lambda *_, t=t: self.app.player.seek(t))
                lab.add_controller(click)
                self.body.append(lab)
                self.times.append(t)
                self.labels.append(lab)
            GLib.timeout_add(60, lambda: (self.tick(self.app.position, jump=True), False)[1])   # once laid out
        else:
            self.from_label.set_label(f"LYRICS · {(got.get('plain_from') or '').upper()}")
            lab = Gtk.Label(xalign=0, wrap=True, selectable=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
            lab.add_css_class("lyrics-text")
            lab.set_markup(self.markup(got["plain"]))
            self.body.append(lab)
            self.scroller.get_vadjustment().set_value(0)

    def markup(self, text):
        muted = self.app.theme["c"]["muted"]
        out = []
        for line in text.splitlines():
            esc = GLib.markup_escape_text(line)
            if re.fullmatch(r"\s*\[[^\]]+\]\s*", line):   # [Verse 1], [Chorus]: Genius's section names
                esc = f'<span foreground="{muted}" size="small" weight="bold">{esc.upper()}</span>'
            out.append(esc)
        return "\n".join(out)

    def tick(self, pos, jump=False):
        """Light up the line being sung at pos seconds."""
        if not self.times:
            return
        i = bisect.bisect_right(self.times, pos + 0.25) - 1   # a quarter second early, as you read ahead
        if i == self.cur and not jump:
            return
        if jump or i < self.cur:
            for j, lab in enumerate(self.labels):
                (lab.add_css_class if j < i else lab.remove_css_class)("past")
                (lab.add_css_class if j == i else lab.remove_css_class)("now")
        else:
            for j in range(max(self.cur, 0), i):
                self.labels[j].remove_css_class("now")
                self.labels[j].add_css_class("past")
            if i >= 0:
                self.labels[i].add_css_class("now")
        self.cur = i
        self.scroll_to(i, jump)

    def scroll_to(self, i, jump):
        if not jump and time.monotonic() - self.user_scrolled < 4:   # you're reading ahead: leave it
            return
        adj = self.scroller.get_vadjustment()
        target = 0.0
        if i >= 0:
            lab = self.labels[i]
            ok, pt = lab.compute_point(self.body, Graphene.Point().init(0, 0))
            if not ok:
                return
            target = max(0.0, pt.y + lab.get_height() / 2 - self.scroller.get_height() * 0.38)
        if self.anim:
            self.anim.pause()
        if jump:
            adj.set_value(target)
            return
        self.anim = Adw.TimedAnimation.new(self.scroller, adj.get_value(), target, 450,
                                           Adw.CallbackAnimationTarget.new(adj.set_value))
        self.anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
        self.anim.play()


