    def playlists_changed(self):
        if self.win and self.win.music_view == "playlists":
            self.win.refresh_music()

    def play_list(self, tracks, shuffled=False):
        tracks = list(tracks)
        if shuffled:
            random.shuffle(tracks)
        if tracks:
            self.play_from(tracks, 0, radio=False)

    def download(self, tracks):
        """Download the songs you picked, in FLAC, one after another."""
        waiting = {t["id"] for t in self.downloads}
        new = [t for t in tracks if source_of(t) != "file" and not self.lib.has(t["id"]) and t["id"] not in waiting]
        if not new:
            self.toast("Those are downloaded already")
            return
        if not (self.dl.tidal and self.dl.tidal.connected):
            self.toast("Connect Tidal in the accounts menu first: downloads come from there, in FLAC")
            return
        self.downloads += new
        self.toast(f"Downloading {len(new)} song{'s' if len(new) != 1 else ''} in FLAC")
        if self.win:
            self.win.update_saved()
        if not self.downloading:
            self.download_next()

    def download_next(self):
        if not self.downloads:
            self.downloading = False
            if self.win:
                self.win.refresh_all()
            return
        self.downloading = True
        batch, self.downloads = self.downloads, []
        in_thread(self.dl.sync, batch, lambda: self.win and self.win.refresh_all(), done=lambda *_: self.download_next())

    # ---- Tidal and the FLAC sync of your whole library ----
    def connect_tidal(self):
        """Open Tidal's sign-in page; the accounts menu then asks for the address it ends on."""
        tidal = self.dl.tidal
        if not tidal or tidal.connected:
            return
        self.tidal_link = self.tidal_link or tidal.login_url()
        self.open_uri(self.tidal_link)
        self.accounts_changed("tidal")

    def finish_tidal_login(self, oops_url):
        def done(_res, err):
            if err:
                self.toast(f"Tidal didn't accept that: {str(err)[:80]}")
                return
            self.tidal_link = None
            self.source_ready("tidal", self.dl.tidal, None)
            self.toast("Tidal connected: everything plays in FLAC")
            self.sync_library()
        in_thread(self.dl.tidal.finish_login, oops_url, done=done)

    def sync_library(self):
        """Download every song in your playlists and favourites, on each service you
        sync, in FLAC; and replace songs saved lossy before."""
        tidal = self.dl.tidal
        if not (tidal and tidal.connected):
            return
        if self.syncing:
            self.sync_again = True   # a service signed in meanwhile: go again after
            return
        self.syncing, self.sync_again = True, False
        self.update_sync()
        lossy = self.lib.lossy()
        sources = [s for k, s in self.sources.items() if s.signed_in and self.sync_sources.get(k, False)]

        def work():
            tracks, seen = [], set()
            for src in sources:
                try:
                    found = src.library_tracks()
                except Exception:  # noqa: BLE001 -- that service's songs wait for the next sync
                    continue
                for t in found:
                    if t["id"] not in seen:
                        seen.add(t["id"])
                        tracks.append(t)
                GLib.idle_add(lambda now=list(tracks): (setattr(self, "sync_tracks", now), self.update_sync(), False)[2])
            self.dl.sync(tracks + [t for t in lossy if t["id"] not in seen], self.update_sync)

        def done(_res, err):
            self.syncing = False
            self.update_sync()
            if err:
                self.toast(f"FLAC sync stopped: {str(err)[:80]}")
            if self.win:
                self.win.refresh_all()
            self.tagger.start()
            if self.sync_again:
                self.sync_library()
        in_thread(work, done=done)

    def sync_status(self):
        tidal = self.dl.tidal
        if not tidal:
            return f"Tidal isn't available: {str(self.tidal_error)[:80]}" if self.tidal_error else "Connecting to Tidal…"
        if not tidal.connected:
            return ("Sign in on the Tidal page that opened. It ends on an “Oops” page:\n"
                    "copy that page's address and paste it below." if self.tidal_link
                    else "Connect Tidal to download your music in FLAC  ›")
        tracks = self.sync_tracks
        if not tracks:
            return "FLAC · reading your playlists…" if self.syncing else "FLAC · Tidal connected"
        flac = sum(self.lib.is_flac(t["id"]) for t in tracks)
        missing = sum(self.lib.recently_missing(t["id"]) and not self.lib.is_flac(t["id"]) for t in tracks)
        text = f"FLAC · {flac} of {len(tracks)} songs saved"
        if missing:
            text += f" · {missing} not on Tidal"
        return text + (" · downloading…" if self.syncing else "")

    def update_sync(self):
        if self.win:
            self.win.update_sync()
            self.win.update_tagger_label()

    # ---- the tagger ----
    def tagging_finished(self):
        self.update_sync()
        if self.win:
            self.win.refresh_accounts()

    def retag_all(self):
        self.tagger.start([vid for vid, t in list(self.lib.items.items()) if t.get("format") == "flac"])
        if self.win:
            self.win.refresh_accounts()

    # ---- Last.fm ----
    def lastfm_connect(self, key, secret):
        key, secret = key.strip(), secret.strip()
        if not (re.fullmatch(r"[0-9a-f]{32}", key) and re.fullmatch(r"[0-9a-f]{32}", secret)):
            self.toast("That isn't a Last.fm API key and secret: 32 letters and digits each")
            return
        fm = self.lastfm
        fm.set_account(key, secret)
        self.lastfm_connecting = True
        self.accounts_changed()

        def got_url(url, err):
            if not self.lastfm_connecting:
                return
            if err:
                self.lastfm_connecting = False
                self.toast(f"Last.fm didn't take that key: {str(err)[:80]}")
                self.accounts_changed()
                return
            self.open_uri(url)
            self.lastfm_wait(time.monotonic() + 180)
        in_thread(fm.auth_url, done=got_url)

    def lastfm_wait(self, until):
        """Ask Last.fm every few seconds whether you've approved the app yet."""
        def check():
            if self.lastfm_connecting:
                in_thread(self.lastfm.finish_auth, done=answered)
            return False

        def answered(_res, err):
            if not self.lastfm_connecting:
                return
            if isinstance(err, LastFMError) and err.code == 14 and time.monotonic() < until:   # not yet
                GLib.timeout_add_seconds(3, check)
                return
            self.lastfm_connecting = False
            if err:
                self.toast("Last.fm wasn't approved in time: connect again" if isinstance(err, LastFMError)
                           and err.code == 14 else f"Couldn't connect Last.fm: {str(err)[:80]}")
            else:
                self.toast(f"Last.fm connected: scrobbling as {self.lastfm.user}")
                in_thread(self.lastfm.flush, done=self.lastfm_result)
            self.accounts_changed()
        GLib.timeout_add_seconds(3, check)

    def lastfm_cancel(self):
        self.lastfm_connecting = False
        self.accounts_changed()

    def lastfm_disconnect(self):
        self.lastfm.disconnect()
        self.listen = None
        self.accounts_changed()

    def lastfm_result(self, _res, err):
        if isinstance(err, LastFMError) and err.code == 9:   # the app's access was revoked on Last.fm
            self.lastfm.disconnect()
            self.toast("Last.fm signed you out: connect it again in the accounts menu")
            self.accounts_changed()

    def begin_listen(self, t):
        """A song started. It counts as played (Recent, Most played) after PLAY_AFTER
        seconds of listening; Last.fm shows it as playing, and gets it once you've
        listened to half of it (or four minutes)."""
        m = {k: v for k, v in song_meta(self.lib, t).items() if k != "tags"}
        scrobble = self.lastfm.connected and bool(m["artist"] and m["title"])
        self.listen = {"id": t["id"], "track": t, "meta": m, "start": time.time(), "played": 0.0,
                       "counted": False, "sent": not scrobble}
        if scrobble:
            in_thread(self.lastfm.now_playing, m, done=self.lastfm_result)

    def listened(self, seconds):
        ls = self.listen
        if not ls or (ls["sent"] and ls["counted"]):
            return
        ls["played"] += seconds
        dur = self.duration or ls["meta"].get("duration") or 0
        if not ls["counted"] and ls["played"] >= min(PLAY_AFTER, dur / 2 if dur else PLAY_AFTER):
            ls["counted"] = True
            self.plays.add(ls["track"])
            self.lib.played(ls["id"])
            if self.win and self.win.music_view in ("recent", "top") and not self.win.selecting:
                self.win.refresh_music()
        if not ls["sent"] and dur > 30 and ls["played"] >= min(dur / 2, 240):
            ls["sent"] = True
            in_thread(self.lastfm.scrobble, ls["meta"], ls["start"], done=self.lastfm_result)

    # ---- Wrapped ----
    def open_wrapped(self, period=None):
        """Your Wrapped, in a window of its own, from your Last.fm history."""
        if not self.lastfm.connected:
            self.show_window()
            self.toast("Connect Last.fm first: Wrapped is made from your scrobbles")
            self.win.accounts_pop.popup()
            return
        period = period or wrapped_year()
        if self.win:
            self.win.set_visible(False)   # it would sit right on top of Wrapped
        if self.wrapped:
            if period != self.wrapped.period:
                self.wrapped.load(period)
            present(self.wrapped)
            return
        self.wrapped = WrappedWindow(self, period)
        self.wrapped.set_application(self)
        self.wrapped.connect("close-request", lambda *_: (setattr(self, "wrapped", None), False)[1])
        present(self.wrapped)

    # ---- queue ----
    def current_track(self):
        return self.queue[self.index] if 0 <= self.index < len(self.queue) else None

    def play_from(self, tracks, i, radio):
        """Play tracks[i], then the rest of tracks; the songs you queued come first."""
        queued = [t for t in self.queue[self.index + 1:] if t.get("queued")]
        tracks = [dict(t) for t in tracks]
        self.queue = tracks[:i + 1] + queued + tracks[i + 1:]
        self.index = i
        self.radio_from = None
        if self.dj["on"]:   # you picked other songs: the DJ stops
            self.dj["on"] = False
            self.dj_changed()
        self.context += 1
        self.load_current()
        if radio:
            self.extend_radio(self.queue[i], keep_until=i)

    def enqueue(self, tracks, how="queue"):
        """Your queue: "next" plays the songs right after this one, "queue" after
        the songs you queued before. Returns where they went (None: playing now)."""
        tracks = [dict(t, queued=True) for t in tracks if t]
        if not tracks:
            return None
        if not self.current_track():
            self.play_from(tracks, 0, radio=False)
            return None
        pos = self.index + 1
        if how != "next":
            while pos < len(self.queue) and self.queue[pos].get("queued"):
                pos += 1
        self.queue[pos:pos] = tracks
        self.after_queue_change()
        many = f"{len(tracks)} songs" if len(tracks) > 1 else f"“{tracks[0]['title']}”"
        self.toast(f"{many} {'play next' if how == 'next' else 'added to the queue'}" if len(tracks) > 1
                   else f"{'Playing next' if how == 'next' else 'Added to the queue'}: {many}")
        if self.ended:   # the queue had run out: carry on with these
            self.next()
        return pos

    def unqueue_many(self, indices):
        for i in sorted(set(indices), reverse=True):
            if 0 <= i < len(self.queue) and i != self.index:
                del self.queue[i]
                if i < self.index:
                    self.index -= 1
        self.after_queue_change()

    def unqueue(self, i):
        if not 0 <= i < len(self.queue) or i == self.index:
            return
        del self.queue[i]
        if i < self.index:
            self.index -= 1
        self.after_queue_change()

    def radio_tracks(self, track):
        """Songs like track, from its own service if it makes radios, else another one."""
        last = None
        for key in dict.fromkeys((source_of(track), self.source, "ytm", "tidal")):
            src = self.sources.get(key)
            if not src or key in ("apple", "spotify") or (key == "tidal" and not src.signed_in):
                continue   # Apple's stations play only in its own apps; Spotify gives apps like this none
            try:
                found = src.radio(track)
            except Exception as e:  # noqa: BLE001 -- try the next service
                last = e
                continue
            if found:
                return found
        if last:
            raise last
        return []

    def extend_radio(self, track, keep_until=None):
        self.radio_from = track["id"]
        context = self.context

        def done(res, err):
            if context != self.context or err or not res:
                return
            if keep_until is not None:
                # A song picked from results: its radio replaces the rest of the results (not your queue).
                cut = max(keep_until, self.index)
                self.queue = self.queue[:cut + 1] + [t for t in self.queue[cut + 1:] if t.get("queued")]
            ids = {t["id"] for t in self.queue}
            songs = {song_key(t) for t in self.queue}
            for t in res:
                if t["id"] not in ids and song_key(t) not in songs:   # another service's copy of a song here
                    ids.add(t["id"])
                    songs.add(song_key(t))
                    self.queue.append(t)
            self.after_queue_change()
        in_thread(self.radio_tracks, track, done=done)

    def play_index(self, i):
        if 0 <= i < len(self.queue):
            self.index = i
            self.load_current()

    def next(self):
        if self.index + 1 < len(self.queue):
            self.index += 1
            self.load_current()
        elif self.repeat == "all" and self.queue:
            self.index = 0
            self.load_current()
        else:
            self.ended = True
            self.set_paused(True)

    def track_ended(self):
        if self.repeat == "one":
            self.load_current()
        else:
            self.next()

    def cycle_repeat(self):
        self.repeat = {"off": "all", "all": "one", "one": "off"}[self.repeat]
        self.save_state()
        self.mpris.changed()
        if self.win:
            self.win.update_repeat()

    def toggle_like(self):
        """Like the song on the service it's from (and love it on Last.fm)."""
        t = self.current_track()
        key = source_of(t) if t else None
        src = self.sources.get(key)
        if not (t and src and src.signed_in):
            return
        vid, like = t["id"], t["id"] not in self.liked
        mine = self.likes.setdefault(key, set())
        for s in (mine, self.liked):   # show it now; undone if the service refuses
            (s.add if like else s.discard)(vid)

        def work():
            src.rate(t, like)
            if self.lastfm.connected:
                try:
                    self.lastfm.love(song_meta(self.lib, t), like)
                except Exception:  # noqa: BLE001 -- the like itself went through
                    pass

        def done(_res, err):
            if err:
                for s in (mine, self.liked):
                    (s.discard if like else s.add)(vid)
                self.toast(f"Couldn't {'like' if like else 'unlike'} it: {str(err)[:80]}")
            if self.win:
                self.win.update_like()
        if self.win:
            self.win.update_like()
        in_thread(work, done=done)

    def previous(self):
        if self.position > 4 or self.index <= 0:
            self.player.seek(0)
            t = self.current_track()
            if t and self.listen and (self.listen["sent"] or self.listen["counted"]):
                self.begin_listen(t)   # listening again counts again
        else:
            self.index -= 1
            self.load_current()

    def shuffle(self):
        """Shuffle what's coming up; the songs you queued stay first, in your order."""
        rest = self.queue[self.index + 1:]
        others = [t for t in rest if not t.get("queued")]
        random.shuffle(others)
        self.queue = self.queue[:self.index + 1] + [t for t in rest if t.get("queued")] + others
        self.after_queue_change()

    def after_queue_change(self):
        self.save_state()
        self.prefetch()
        if self.win:
            self.win.refresh_queue()

    def load_current(self, autoplay=True):
        t = self.current_track()
        if not t:
            return
        t.pop("queued", None)   # playing now, not waiting in your queue
        self.ended = False
        self.restore_pending = False   # something is loading now
        self.listen = None
        self.load_seq += 1
        seq = self.load_seq
        self.position, self.duration = 0.0, t.get("duration") or 0
        on_disk = self.lib.has(t["id"]) or source_of(t) == "file"
        self.streaming = not (on_disk or self.keep_played)
        if self.win:
            self.win.update_now_playing()
            self.win.update_position(0, self.duration)
            self.win.set_status("" if on_disk else "Downloading FLAC…" if self.keep_played else "Loading the stream…")
            self.win.refresh_queue()

        def ready(path, err):
            if seq != self.load_seq:
                return  # user moved on while it downloaded
            if err and not self.streaming:
                self.streaming = True   # no FLAC to keep (or saving it failed): stream what there is instead
                self.dl.stream(t, ready)
                return
            if err:
                if self.win:
                    self.win.set_status("")
                    self.win.toast(f"Skipped “{t['title']}”: {err}" if isinstance(err, NoLosslessMatch)
                                   else f"Couldn't get “{t['title']}”: {err}")
                if autoplay:   # a song restored at startup stays put instead of skipping on its own
                    GLib.timeout_add(1500, lambda: (seq == self.load_seq and self.next(), False)[1])
                else:
                    self.paused = True   # nothing is loaded, whatever idle mpv says
                    if self.win:
                        self.win.update_now_playing()
                    self.mpris.changed()
                return
            if self.win:
                self.win.set_status("")
            self.player.load(path, paused=not autoplay)
            self.paused = not autoplay
            if autoplay:
                self.begin_listen(t)
            if self.win:
                self.win.song_changed()
                self.win.update_now_playing()
            self.mpris.changed()
            self.prefetch()
        (self.dl.stream if self.streaming else self.dl.fetch)(t, ready)
        self.save_state()
        # Keep a radio going: near the end of the queue, ask for more like the last song.
        if self.radio_from and self.index >= len(self.queue) - 2:
            self.extend_radio(self.queue[-1])
        if self.dj["on"]:
            self.dj_announce(t)
            self.dj_changed()
            if self.index >= len(self.queue) - 2:
                self.dj_more()

    def prefetch(self):
        """Get the next song ready, so it starts without a wait: its stream looked up,
        or (keeping what you play) the song downloaded."""
        nxt = self.queue[self.index + 1] if self.index + 1 < len(self.queue) else None
        if not nxt or self.lib.has(nxt["id"]) or source_of(nxt) == "file":
            return
        if self.keep_played:
            self.dl.fetch(nxt, lambda *_: self.win and self.win.refresh_all())
        else:
            self.dl.stream(nxt, lambda *_: None)

    def stream_broke(self):
        """Tidal's stream stopped short (its address ran out during a long pause, say):
        look it up again and carry on from the same place, once per song."""
        t = self.current_track()
        if not t or not self.streaming:
            return
        seq, pos, paused = self.load_seq, self.position, self.paused
        if self.stream_retry == seq:
            self.toast(f"Lost the stream of “{t['title']}”")
            if not paused:
                self.next()
            return
        self.stream_retry = seq
        self.dl.forget_stream(t["id"])

        def ready(path, err):
            if seq != self.load_seq:
                return
            if err:
                self.toast(f"Couldn't get “{t['title']}” back: {err}")
                return
            self.player.load(path, paused=paused, start=pos)
        self.dl.stream(t, ready)

    def save_current(self):
        t = self.current_track()
        if t:
            self.download([t])

    def set_keep_played(self, on):
        self.keep_played = on
        self.save_soon()

    def set_remote(self, on):
        self.remote_on = on
        (self.remote.start if on else self.remote.stop)()
        self.remote_on = self.remote.running
        self.save_state()
        self.accounts_changed()

    def forget_phones(self):
        self.remote_tokens = {}
        self.save_state()
        self.toast("Every paired phone has to pair again")
        self.accounts_changed()

    # ---- playback ----
    def toggle_pause(self):
        if not self.current_track():
            return
        self.set_paused(not self.paused)

    def set_paused(self, paused):
        self.player.set_pause(paused)

    def set_volume(self, volume):
        volume = round(max(0.0, min(100.0, volume)))
        if volume == self.volume and not self.muted:
            return
        self.volume, self.muted = volume, False
        self.volume_changed()

    def toggle_mute(self):
        self.muted = not self.muted
        self.volume_changed()

    def volume_changed(self):
        self.player.set_volume(self.volume, self.muted)
        self.mpris.changed()
        if self.win:
            self.win.update_volume()
        self.save_soon()

    # ---- equalizer ----
    def load_eq(self, saved):
        eq = self.eq
        if saved.get("headphones") in HEADPHONES:
            eq["headphones"] = saved["headphones"]
        if saved.get("preset") in EQ_PRESETS:
            eq["preset"] = saved["preset"]
        for key in ("bands", "custom"):
            vals = saved.get(key)
            if isinstance(vals, list) and len(vals) == len(EQ_BANDS):
                eq[key] = [max(-EQ_RANGE, min(EQ_RANGE, float(g))) for g in vals]
        for key in TONE:
            if isinstance(saved.get(key), (int, float)):
                eq[key] = max(-EQ_RANGE, min(EQ_RANGE, float(saved[key])))
        eq["on"] = bool(saved.get("on"))
        if eq["on"]:
            self.apply_eq()

    def eq_correction(self):
        return HEADPHONES[self.eq["headphones"]][1]

    def eq_preamp(self):
        return eq_preamp([*self.eq_correction(), *(("pk", hz, g, EQ_Q) for hz, g in zip(EQ_BANDS, self.eq["bands"])),
                          *((k, hz, self.eq[name], q) for name, (k, hz, q) in TONE.items())])

    def apply_eq(self):
        """(Re)build mpv's filters from the settings; the music skips a beat."""
        self.player.set_filters(eq_graph(self.eq_correction(), self.eq["bands"], self.eq_preamp(),
                                         {name: self.eq[name] for name in TONE}) if self.eq["on"] else "")
        self.eq_synced = True

    def retune_eq(self):
        """Set the bands and pre-gain in the running filters, without a gap. mpv
        rebuilds its filters from the graph on a seek or a new song, so eq_settled
        rebuilds that too once you're done adjusting."""
        for i, g in enumerate(self.eq["bands"]):
            self.player.filter_cmd("g", g, f"equalizer@g{i}")
        for name, (k, _hz, _q) in TONE.items():
            self.player.filter_cmd("g", self.eq[name], f"{'lowshelf' if k == 'ls' else 'highshelf'}@{name}")
        self.player.filter_cmd("volume", f"{self.eq_preamp()}dB", "volume@pre")
        self.eq_synced = False

    def eq_settled(self):
        if not self.eq_synced:
            self.apply_eq()

    def eq_changed(self, rebuild=False):
        if rebuild or not self.eq["on"]:
            self.eq["on"] = True
            self.apply_eq()
        else:
            self.retune_eq()
        if self.win:
            self.win.update_eq()
        self.save_soon()

    def set_eq_on(self, on):
        if on != self.eq["on"]:
            self.eq["on"] = on
            self.apply_eq()
            if self.win:
                self.win.update_eq()
            self.save_soon()

    def set_eq_headphones(self, key):
        if key != self.eq["headphones"]:
            self.eq["headphones"] = key
            self.eq_changed(rebuild=True)  # a different set of filters

    def set_eq_preset(self, key):
        bands = EQ_PRESETS[key][1] or self.eq["custom"]
        self.eq["preset"], self.eq["bands"] = key, [float(g) for g in bands]
        self.eq_changed()

    def set_eq_tone(self, name, gain):
        """Bass or treble, dB either way."""
        gain = round(max(-EQ_RANGE, min(EQ_RANGE, gain)) * 2) / 2
        if gain == self.eq[name] and self.eq["on"]:
            return
        self.eq[name] = gain
        self.eq_changed()

    def set_eq_band(self, i, gain):
        gain = round(max(-EQ_RANGE, min(EQ_RANGE, gain)) * 2) / 2
        if gain == self.eq["bands"][i] and self.eq["on"]:
            return
        self.eq["bands"][i] = gain
        self.eq["custom"] = list(self.eq["bands"])
        self.eq["preset"] = "custom"
        self.eq_changed()

    def on_mpv(self, msg):
        ev = msg.get("event")
        if ev == "property-change":
            name, data = msg.get("name"), msg.get("data")
            if name == "time-pos" and data is not None:
                if abs(data - self.position) >= 0.2 or data < self.position:
                    step = data - self.position
                    self.position = data
                    if 0 < step < 1.5 and not self.paused:   # playing on, not a seek
                        self.listened(step)
                    if self.win:
                        self.win.update_position(self.position, self.duration)
                        if self.win.get_visible() and self.win.stack.get_visible_child_name() == "lyrics":
                            self.win.lyrics.tick(self.position)
            elif name == "duration" and data:
                self.duration = data
            elif name == "pause" and data is not None:
                self.paused = bool(data)
                t = self.current_track()
                if not self.paused and t and not (self.listen and self.listen["id"] == t["id"]):
                    self.begin_listen(t)   # the song you left paused last time
                if self.win:
                    self.win.update_now_playing()
                self.mpris.changed()
        elif ev == "playback-restart" and not self.eq_synced:
            self.retune_eq()  # a seek or new song rebuilt the filters from the graph, before the latest tweaks
        elif ev == "end-file" and msg.get("reason") == "eof":
            if self.streaming and self.duration and self.position < self.duration - 5:
                self.stream_broke()   # the network went away mid-song: that's not the end
            else:
                self.track_ended()
        elif ev == "end-file" and msg.get("reason") == "error":
            self.stream_broke()


def song_key(t):
    """The same song on any service: its name and lead artist, tidied."""
    return norm(clean_title(t.get("title") or "")), norm((t.get("artist") or "").split(",")[0])


# =============================================================================
# Starting up: commands run before the app was (omarchy-music play ...) start it
# in the background and then hand it the command, so the terminal gets its
# answer and is free again. Logins from a terminal.
# =============================================================================

def primary_running():
    """Whether Omarchy Music is running already (it owns its name on the session bus)."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        res = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
                            GLib.Variant("(s)", (APP_ID,)), GLib.VariantType.new("(b)"), Gio.DBusCallFlags.NONE,
                            2000, None)
        return res.unpack()[0]
    except GLib.Error:
        return False


def start_in_background():
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--background"], start_new_session=not WINDOWS,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **NO_WINDOW)
    for _ in range(150):
        if primary_running():
            return True
        time.sleep(0.1)
    return False


def tell_running(verb):
    if primary_running():
        subprocess.run([sys.executable, os.path.abspath(__file__), verb], timeout=20, check=False)


def open_url(url):
    """A page in your browser, from the terminal commands."""
    if WINDOWS:
        os.startfile(url)  # noqa: S606 -- the default browser
    else:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def lastfm_login():
    """--lastfm-login: connect Last.fm from a terminal."""
    import getpass
    fm = LastFM()
    if not (fm.key and fm.secret):
        print("Last.fm lets an app in through an API account of your own. Make one (free) at\n"
              "  https://www.last.fm/api/account/create\n"
              "(any application name; the callback URL can stay empty), then paste:")
        fm.set_account(input("API key: "), getpass.getpass("Shared secret (hidden): "))
    try:
        url = fm.auth_url()
    except (LastFMError, OSError) as e:
        print(f"Last.fm didn't take that key and secret: {e}", file=sys.stderr)
        if isinstance(e, LastFMError):
            fm.set_account("", "")   # ask for them again next time
        return 1
    print("Approve Omarchy Music on this Last.fm page (opening it in your browser):", url, sep="\n", flush=True)
    open_url(url)
    for _ in range(60):
        time.sleep(3)
        try:
            fm.finish_auth()
            break
        except LastFMError as e:
            if e.code != 14:   # 14: not approved yet
                print(e, file=sys.stderr)
                return 1
    else:
        print("Timed out waiting for the approval; run it again when you're ready.", file=sys.stderr)
        return 1
    print(f"Last.fm is connected: scrobbling as {fm.user}.")
    tell_running("reload")
    return 0


def spotify_login():
    """--spotify-login: connect Spotify from a terminal."""
    sp = Spotify()
    if sp.signed_in:
        print("Spotify is connected" + (f" as {sp.user}." if sp.user else "."))
        return 0
    print("Spotify lets an app in through a developer app of your own (its owner needs Premium).\n"
          "Make one at https://developer.spotify.com/dashboard/create with the Web API ticked\n"
          f"and this redirect URI: {SPOTIFY_REDIRECT}\nthen paste its Client ID.")
    client_id = sp.client_id or input("Client ID: ")

    def opened(url):
        print("Approve Omarchy Music on this Spotify page (opening it in your browser):", url, sep="\n", flush=True)
        open_url(url)
    try:
        sp.login(client_id, opened)
    except (ValueError, RuntimeError, OSError) as e:
        print(f"Couldn't connect Spotify: {e}", file=sys.stderr)
        return 1
    print("Spotify is connected" + (f" as {sp.user}." if sp.user else "."))
    tell_running("reload")
    return 0


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    args = sys.argv[1:]
    if args[:1] and args[0] in ("help", "--help", "-h"):
        print(__doc__.strip())
        return 0
    if "--tidal-login" in args:
        tidal = Tidal()
        if not tidal.connected:
            print("Sign in to Tidal on this page; it ends on an \"Oops\" page:", tidal.login_url(), sep="\n", flush=True)
            tidal.finish_login(input("Paste the address of that \"Oops\" page: "))
        print("Tidal is connected.")
        tell_running("reload")
        return 0
    if "--lastfm-login" in args:
        return lastfm_login()
    if "--spotify-login" in args:
        return spotify_login()
    if args and args[0] != "--background" and not primary_running():
        if args[0].lower() in ("status", "hide", "pause", "quit", "reload"):
            print("Omarchy Music isn't running.")
            return 1 if args[0].lower() == "status" else 0
        if not start_in_background():
            print("Omarchy Music didn't start.", file=sys.stderr)
            return 1
    return MusicApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
